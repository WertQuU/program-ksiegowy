						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_46" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Suma należnych zaliczek za m-c II</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_47" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Suma należnych zaliczek za m-c III</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_48" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
