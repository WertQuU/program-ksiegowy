<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/" xmlns:czwzg="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/03/23/eD/CITWZG/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/03/23/eD/CITWZG/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/StrukturyDanych_v6-0E.xsd"/>
	<!--Załącznik do zeznania CIT-8AB.-->
	<!-- -->
	<!--Wypełniają podatnicy, którzy na podstawie art. 18f ustawy rozliczają wierzytelności lub zobowiązania wynikające z art. 4 pkt 1a ustawy z dnia 13 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych.-->
	<!-- -->
	<!--Informacja jest składana wyłącznie za pomocą środków komunikacji elektronicznej-->
	<!-- -->
	<!--Dla każdej spółki wchodzącej w skład PGK składa się odrębny załącznik CIT/WZG.-->
	<!-- -->
	<!--Termin zapłaty nie może przekroczyć terminów przewidzianych w ustawie z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych.-->
	<!-- -->
	<!--Podatnik będący wspólnikiem spółki osobowej wpisuje wartość wierzytelności/zobowiązania stosownie do swojego udziału.-->
	<xsd:complexType name="TNaglowek_CIT_WZG">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czwzg:TKodFormularza_CIT_WZG">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CITWZG (2)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="2"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czwzg:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czwzg:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_6"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2020-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_WZG">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/WZG"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_WZG">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WIERZYTELNOŚCIACH I ZOBOWIĄZANIACH ZMNIEJSZAJĄCYCH LUB ZWIĘKSZAJĄCYCH PODSTAWĘ OPODATKOWANIA (STRATĘ), WYNIKAJĄCYCH Z TRANSAKCJI HANDLOWYCH, SKŁADANA PRZEZ SPÓŁKĘ TWORZĄCĄ PODATKOWĄ GRUPĘ KAPITAŁOWĄ</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czwzg:TNaglowek_CIT_WZG"/>
				<xsd:element name="Podmiot1">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne podatkowej grupy kapitałowej (PGK)</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TIdentyfikatorOsobyNiefizycznej1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="PGK"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Podmiot2">
					<xsd:annotation>
						<xsd:documentation>Dane spółki tworzącej PGK</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TIdentyfikatorOsobyNiefizycznej1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Spółka tworząca PGK"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dotyczące dłużnika i wierzytelności, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane, dane dotyczące dłużnika i wierzytelności, jeżeli wierzytelność została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania, jeżeli zobowiązanie zostało uregulowane</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące dłużnika i wierzytelności, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta (dotyczy wierzytelności zmniejszających podstawę opodatkowania lub zwiększających stratę - wypełnia podatnik będący wierzycielem). Dane dotyczące dłużnika i wierzytelności</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_C" minOccurs="0" maxOccurs="unbounded">
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_C9" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C10" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C11" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury/rachunku/umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C12" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C13" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C14" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_15" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 14</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące wierzyciela i zobowiązania, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane (dotyczy zobowiązań zwiększających podstawę opodatkowania lub zmniejszających stratę - wypełnia podatnik będący dłużnikiem). Dane dotyczące wierzyciela i zobowiązania</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_D" minOccurs="0" maxOccurs="unbounded">
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D16" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D17" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D18" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury/rachunku/umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D19" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D20" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D21" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_22" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 21</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące dłużnika i wierzytelności, jeżeli wierzytelność została uregulowana lub zbyta (dotyczy wierzytelności, które pomniejszyły podstawę opodatkowania lub zwiększyły stratę). Dane dotyczące dłużnika i wierzytelności</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_E" minOccurs="0" maxOccurs="unbounded">
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_E23" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E24" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E25" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury/rachunku/umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E26" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E27" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E28" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data uregulowania lub zbycia wierzytelności</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E29" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności uregulowanej lub zbytej w trakcie roku podatkowego</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E30" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności uregulowanej lub zbytej po roku podatkowym, za który dokonano zwiększenia podstawy opodatkowania lub zmniejszenia straty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_31" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 30</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące wierzyciela i zobowiązania, jeżeli zobowiązanie zostało uregulowane (dotyczy zobowiązań, które zwiększyły podstawę opodatkowania lub zmniejszyły stratę). Dane dotyczące wierzyciela i zobowiązania</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_F" minOccurs="0" maxOccurs="unbounded">
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_F32" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F33" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F34" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury/rachunku/umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F35" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F36" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F37" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data uregulowania zobowiązania</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F38" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania uregulowanego w trakcie roku podatkowego</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F39" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania uregulowanego po roku podatkowym, za który dokonano zwiększenia podstawy opodatkowania lub zmniejszenia straty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_40" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 39</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
		<xsd:unique name="klucz_NIP">
			<xsd:selector xpath="czwzg:Podmiot1|czwzg:Podmiot2"/>
			<xsd:field xpath="etd:NIP"/>
		</xsd:unique>
	</xsd:element>
</xsd:schema>
