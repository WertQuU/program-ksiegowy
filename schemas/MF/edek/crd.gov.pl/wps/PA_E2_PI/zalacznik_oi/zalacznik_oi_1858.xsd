<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czgk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITPGK/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITPGK/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/StrukturyDanych_v5-0E.xsd"/>
	<!--Załącznik do zeznania CIT-8AB.-->
	<xsd:complexType name="TNaglowek_CIT_PGK">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czgk:TKodFormularza_CIT_PGK">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CITPGK (3)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czgk:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czgk:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_6"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2019-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_PGK">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/PGK"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TOsobaNiefizyczna">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych o osobie niefizycznej</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OsobaNiefizyczna" type="etd:TIdentyfikatorOsobyNiefizycznej1"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="Zalacznik_CIT_PGK">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) PRZEZ SPÓŁKĘ TWORZĄCĄ PODATKOWĄ GRUPĘ KAPITAŁOWĄ</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czgk:TNaglowek_CIT_PGK"/>
				<xsd:element name="Podmiot1">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne podatkowej grupy kapitałowej (PGK)</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="czgk:TOsobaNiefizyczna">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="PGK"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Podmiot2">
					<xsd:annotation>
						<xsd:documentation>Dane spółki tworzącej PGK</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="czgk:TOsobaNiefizyczna">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Spółka tworząca PGK"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dodatkowe, ustalenie dochodu / straty</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_7">
								<xsd:annotation>
									<xsd:documentation>Łączna liczba składanych załączników</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="1"/>
										<xsd:maxInclusive value="99"/>
									</xsd:restriction>
								</xsd:simpleType>
								<!--Należy podać kolejny numer załącznika CIT/PGK w ogólnej liczbie składanych załączników.-->
							</xsd:element>
							<xsd:element name="P_10" type="etd:TWybor1_2">
								<xsd:annotation>
									<xsd:documentation>Spółka jest spółką dominującą PGK: 1 - tak, 2 - nie</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Dane dodatkowe</xsd:documentation>
								</xsd:annotation>
								<!--Dane dodatkowe zawarte w części  B.1. i D dotyczą wyłącznie spółek tworzących PGK oraz spółki reprezentującej PGK w zakresie obowiązków PGK.-->
								<xsd:element name="P_11" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Spółka jest przedsiębiorstwem finansowym, o którym mowa w art. 15c ust. 16 ustawy: 1 - tak, 2 - nie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:sequence>
									<xsd:element name="P_12" type="etd:TWybor1_2">
										<xsd:annotation>
											<xsd:documentation>Spółka korzysta ze zwolnień podatkowych w specjalnej strefie ekonomicznej na podstawie zezwolenia: 1 - tak, 2 - nie</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<!--Zgodnie z art. 1a ust. 2 pkt 3 lit. a ustawy po utworzeniu podatkowej grupy kapitałowej spółki tworzące tę grupę nie korzystają ze zwolnień podatkowych określonych w art. 17 ust 1 pkt 34 ustawy (działalność prowadzona na podstawie zezwolenia na terenie specjalnej strefy ekonomicznej) lub art. 17 ust. 1 pkt 34a ustawy (działalność prowadzona na podstawie decyzji o wsparciu na terenie określonym w tej decyzji) oraz ze zwolnień podatkowych na podstawie odrębnych ustaw. Przepis art. 1a ust. 2 pkt 3 lit. a ustawy stosuje się do podatkowych grup kapitałowych utworzonych od dnia wejścia w życie ustawy z dnia 10 maja 2018 r. o wspieraniu nowych inwestycji (Dz. U. poz. 1162 z późn. zm.) tj. od dnia 30 czerwca 2018 r. Jeżeli okres funkcjonowania podatkowej grupy kapitałowej utworzonej przed dniem 30 czerwca 2018 r. został przedłużony w okresie od dnia wejścia w życie ustawy z dnia 10 maja 2018 r. o wspieraniu nowych inwestycji, art. 1a ust. 2 pkt 3 lit a ustawy stosuje się od dnia przedłużenia funkcjonowania tej podatkowej grupy kapitałowej.-->
									<xsd:element name="P_13" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Kwota zwolnionych od podatku dochodów uzyskanych z działalności gospodarczej prowadzonej na podstawie zezwolenia na terenie specjalnej strefy ekonomicznej</xsd:documentation>
										</xsd:annotation>
										<!--w przypadku wyboru w poz. 12 wartości 1-->
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:element name="P_14" type="etd:TWybor1_2">
										<xsd:annotation>
											<xsd:documentation>Spółka korzysta ze zwolnień podatkowych na podstawie decyzji o wsparciu na terenie określonym w tej decyzji: 1 - tak, 2 - nie</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_15" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Kwota zwolnionych od podatku dochodów uzyskanych z działalności gospodarczej określonej w decyzji o wsparciu</xsd:documentation>
										</xsd:annotation>
										<!--w przypadku wyboru w poz. 14 wartości 1-->
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:element name="P_16" type="etd:TWybor1_2">
										<xsd:annotation>
											<xsd:documentation>Spółka poniosła koszty uzyskania przychodów na działalność badawczo-rozwojową: 1 - tak, 2 - nie</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_17" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Suma kwot kosztów kwalifikowanych, o których mowa w art. 18d ust. 2 ustawy</xsd:documentation>
										</xsd:annotation>
										<!--w przypadku wyboru w poz. 16 wartości 1-->
									</xsd:element>
								</xsd:sequence>
								<xsd:element name="P_18" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Spółka dokonała korekty cen transferowych, o której mowa w art. 11e ustawy: 1 - tak, 2 - nie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_19" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Sprawozdanie o realizacji uznanej metody ustalania ceny transakcyjnej: 1 - tak, 2 - nie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Przychody</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych na terytorium RP</xsd:documentation>
									</xsd:annotation>
									<!--Nie dotyczy przychodów, o których mowa w art. 2 ust. 1, art. 21 i 22 ustawy, z zastrzeżeniem art. 7 ust. 3 ustawy-->
									<xsd:element name="P_20" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_21" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP</xsd:documentation>
									</xsd:annotation>
									<!--Przychody równorzędne do kategorii przychodów wymienionych w art. 21 ust. 1 ustawy oraz przychody z dywidend i inne przychody z udziałów w zyskach osób prawnych niemających siedziby na terytorium RP.-->
									<xsd:element name="P_22" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_23" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP - inne niż wymienione odpowiednio w poz. 22 lub 23</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_24" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_25" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Przychody uzyskane w następstwie wniesienia do spółki wkładu niepieniężnego w postaci komercjalizowanej własności intelektualnej, które na podstawie art. 12 ust. 1b pkt 5 ustawy, w zw. z art. 12 ustawy z dnia 4 listopada 2016 r. o zmianie niektórych ustaw określających warunki prowadzenia działalności innowacyjnej (Dz. U. poz. 1933 z późn. zm.), podlegają wykazaniu w roku podatkowym wskazanym w poz.  5 i 6</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_26" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_27" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Razem przychody</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_28" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_29" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 20 lub 21</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_31" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 22 lub 23</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_32" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_33" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 24 lub 25</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_34" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_35" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 26 lub 27</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_36" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_37" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty, o których mowa w art. 15e ustawy, wyłączone w poprzednich pięciu latach podatkowych z kosztów uzyskania przychodów, podlegające na podstawie art. 15e ust. 9 ustawy zaliczeniu do kosztów uzyskania przychodów w roku podatkowym wskazanym w poz. 5 i 6</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_38" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_39" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Razem koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_40" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_41" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Dochód / strata</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Dochód (art. 7 ust. 2 ustawy)</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_42" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_43" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Strata (art. 7 ust. 2 ustawy)</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_44" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_45" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Strata w związku z postanowieniami art. 7 ust. 3-4a ustawy oraz strata ze źródeł przychodów wykazanych odpowiednio w poz. 24 i 25 podlegająca za granicą odliczeniu od dochodu do opodatkowania</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_46" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_47" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_48" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_49" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_50" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_51" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Dochody (przychody) wolne od podatku</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Dochody (przychody) wolne od podatku uzyskane w roku podatkowym wskazanym w poz. 5 i 6</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_52" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochody (przychody) z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_53" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochody (przychody) z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Dochód po odliczeniu dochodów (przychodów) wolnych</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_54" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochody (przychody) z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_55" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochody (przychody) z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Informacje dodatkowe</xsd:documentation>
								</xsd:annotation>
								<!--Dane dodatkowe zawarte w części  B.1. i D dotyczą wyłącznie spółek tworzących PGK oraz spółki reprezentującej PGK w zakresie obowiązków PGK.-->
								<xsd:choice minOccurs="0">
									<xsd:element name="P_56" type="etd:TWybor1" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Podatnik wybrał metodę ustalania różnic kursowych na podstawie przepisów o rachunkowości, o której mowa w art. 9b ust. 1 pkt 2 ustawy: 1 - tak</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_57" type="etd:TWybor1" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Podatnik rezygnuje ze stosowania metody ustalania różnic kursowych na podstawie przepisów o rachunkowości, o której mowa w art. 9b ust. 1 pkt 2 ustawy: 1 - tak</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:choice>
								<xsd:element name="P_58" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podmiot powstały w wyniku podziału/połączenia oraz przejmujący całość / część innego podmiotu rezygnuje ze stosowania metody ustalania różnic kursowych na podstawie przepisów o rachunkowości, o której mowa w art. 9b ust. 1 pkt 2 ustawy: 1 - tak</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Dochody (przychody) wolne od podatku uzyskane w roku podatkowym wskazanym w poz. 5 i 6</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_59" type="etd:TWybor1_2">
										<xsd:annotation>
											<xsd:documentation>Podatnik przeniósł tymczasowo składniki majątku poza terytorium Rzeczypospolitej Polskiej: 1 - tak,  2 - nie</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:sequence minOccurs="0">
										<xsd:element name="P_60" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Wartość rynkowa składników majątku tymczasowo przeniesionych w roku podatkowym, za który jest składane zeznanie, poza terytorium Rzeczypospolitej Polskiej</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_61">
											<xsd:annotation>
												<xsd:documentation>Przewidywany termin przeniesienia składników majątku z powrotem na terytorium Rzeczypospolitej Polskiej</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="etd:TData">
													<xsd:minInclusive value="2019-01-01"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
									</xsd:sequence>
								</xsd:sequence>
								<xsd:element name="P_62" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik wybrał metodę ustalania daty powstania przychodów na podstawie art. 12 ust. 3g ustawy: 1 - tak</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_63" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Kwota kosztów wyłączonych z kosztów uzyskania przychodów na podstawie art. 15e ustawy, w roku podatkowym wskazanym w poz. 5 i 6: 1 - tak</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o okresach zawieszenia</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_64" type="etd:TZnakowy" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacja o okresie zawieszenia w roku podatkowym wykonywania działalności gospodarczej przez podatnika, o której mowa w art. 25 ust. 5a ustawy. Okresy zawieszenia</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_65" type="etd:TTekstowy" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacja o okresie zawieszenia w roku podatkowym wykonywania działalności gospodarczej spółki jawnej lub spółki komandytowej. Nazwy spółek i okresy zawieszenia</xsd:documentation>
									</xsd:annotation>
									<!--Wypełnia podatnik, o którym mowa w art. 25 ust. 5b ustawy będący wspólnikiem spółki jawnej lub spółki komandytowej, która w roku podatkowym zawiesiła prowadzenie działalności gospodarczej.-->
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
		<xsd:unique name="klucz_NIP">
			<xsd:selector xpath="czgk:Podmiot1|czgk:Podmiot2"/>
			<xsd:field xpath="czgk:OsobaNiefizyczna/etd:NIP"/>
		</xsd:unique>
	</xsd:element>
</xsd:schema>
