<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PelnaKsiegowosc.Presentation.ViewModels"
        x:Class="PelnaKsiegowosc.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}" Width="1360" Height="860" MinWidth="900" MinHeight="600"
        Icon="avares://PelnaKsiegowosc/Assets/ikona.ico"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PkHeaderBg}" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CompanyLine}" Foreground="{DynamicResource PkHeaderSub}" />
        </StackPanel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" MinWidth="230" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="Odśwież" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Classes="accent" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PkWarnBg}" Padding="12,6" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource PkWarnFg}" />
    </Border>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PkWarnBg}" Padding="12,6" IsVisible="{Binding IntegrityNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding IntegrityNotice}" TextWrapping="Wrap" Foreground="{DynamicResource PkWarnFg}" />
    </Border>
    <Border DockPanel.Dock="Top" Background="{DynamicResource PkWarnBg}" Padding="12,6" IsVisible="{Binding SharedChangesNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding SharedChangesNotice}" TextWrapping="Wrap" Foreground="{DynamicResource PkWarnFg}" />
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PkFooterBg}" BorderBrush="{DynamicResource PkBorder}" BorderThickness="0,1,0,0" Padding="12,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Footer}" Foreground="{DynamicResource PkMuted}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding SelectedSection.StatusMessage}" Foreground="{DynamicResource PkStatus}" FontWeight="SemiBold" Margin="12,0,0,0" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Left" Width="236" Background="{DynamicResource PkSidebarBg}" Classes="sidebar">
      <ListBox ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMenuItem}" Background="Transparent">
        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:MenuHeader">
            <TextBlock Text="{Binding Text}" Classes="menuheader" />
          </DataTemplate>
          <DataTemplate DataType="vm:SectionViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,1">
              <TextBlock Text="{Binding Icon}" Width="22" TextAlignment="Center" />
              <TextBlock Text="{Binding Title}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </Border>
    <Grid RowDefinitions="Auto,*">
      <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding SelectedSection.IsBusy}" />
      <DockPanel Grid.Row="1" Margin="20,14,20,8">
        <Border DockPanel.Dock="Top" Background="{DynamicResource PkGuideBg}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
          <TextBlock Text="{Binding SelectedSection.Guide}" TextWrapping="Wrap" Foreground="{DynamicResource PkGuideFg}" />
        </Border>
        <ContentControl Content="{Binding SelectedSection}" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
