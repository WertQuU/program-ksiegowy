														<xsd:documentation>Przedmiot transakcji kontrolowanej</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="KrajPL" type="etd:TKodKraju" fixed="PL">
													<xsd:annotation>
