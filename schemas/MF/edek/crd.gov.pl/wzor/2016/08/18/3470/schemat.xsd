					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_338" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/O</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_339" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/ZG</xsd:documentation>
