<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czwz="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/03/23/eD/CITWZ/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/03/23/eD/CITWZ/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/StrukturyDanych_v6-0E.xsd"/>
	<!--Załącznik do zeznania CIT-8.-->
	<!-- -->
	<!--Wypełniają podatnicy, którzy na podstawie art. 18f ustawy rozliczają wierzytelności lub zobowiązania wynikające z art. 4 pkt 1a ustawy z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych.-->
	<!-- -->
	<!--Termin zapłaty nie może przekroczyć terminów przewidzianych w ustawie z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych.-->
	<!-- -->
	<!--Podatnik będący wspólnikiem spółki osobowej wpisuje wartość wierzytelności/zobowiązania stosownie do swojego udziału.-->
	<xsd:complexType name="TNaglowek_CIT_WZ">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czwz:TKodFormularza_CIT_WZ">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT/WZ (2)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="2"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czwz:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czwz:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2020-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_WZ">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/WZ"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_WZ">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WIERZYTELNOŚCIACH I ZOBOWIĄZANIACH ZMNIEJSZAJĄCYCH LUB ZWIĘKSZAJĄCYCH PODSTAWĘ OPODATKOWANIA (STRATĘ), WYNIKAJĄCYCH Z TRANSAKCJI HANDLOWYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czwz:TNaglowek_CIT_WZ"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dotyczące dłużnika i wierzytelności, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane, dane dotyczące dłużnika i wierzytelności, jeżeli wierzytelność została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania, jeżeli zobowiązanie zostało uregulowane</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące dłużnika i wierzytelności, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta (dotyczy wierzytelności zmniejszających podstawę opodatkowania lub zwiększających stratę - wypełnia podatnik będący wierzycielem). Dane dotyczące dłużnika i wierzytelności</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_B" minOccurs="0" maxOccurs="unbounded">
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_B8" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B9" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B10" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury/rachunku/umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B11" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B12" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B13" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_14" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 13</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące wierzyciela i zobowiązania, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane (dotyczy zobowiązań zwiększających podstawę opodatkowania lub zmniejszających stratę - wypełnia podatnik będący dłużnikiem). Dane dotyczące wierzyciela i zobowiązania</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_C" minOccurs="0" maxOccurs="unbounded">
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_C15" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C16" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C17" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury/rachunku/umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C18" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C19" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C20" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_21" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 20</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące dłużnika i wierzytelności, jeżeli wierzytelność została uregulowana lub zbyta (dotyczy wierzytelności, które pomniejszyły podstawę opodatkowania lub zwiększyły stratę). Dane dotyczące dłużnika i wierzytelności</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_D" minOccurs="0" maxOccurs="unbounded">
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D22" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D23" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D24" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury/rachunku/umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D25" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D26" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D27" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data uregulowania lub zbycia wierzytelności</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D28" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności uregulowanej lub zbytej w trakcie roku podatkowego</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D29" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności uregulowanej lub zbytej po roku podatkowym, za który dokonano zwiększenia podstawy opodatkowania lub zmniejszenia straty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 29</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące wierzyciela i zobowiązania, jeżeli zobowiązanie zostało uregulowane (dotyczy zobowiązań, które zwiększyły podstawę opodatkowania lub zmniejszyły stratę). Dane dotyczące wierzyciela i zobowiązania</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_E" minOccurs="0" maxOccurs="unbounded">
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_E31" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E32" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E33" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury/rachunku/umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E34" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E35" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E36" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data uregulowania zobowiązania</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E37" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania uregulowanego w trakcie roku podatkowego</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E38" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania uregulowanego po roku podatkowym, za który dokonano zwiększenia podstawy opodatkowania lub zmniejszenia straty</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_39" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 38</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
