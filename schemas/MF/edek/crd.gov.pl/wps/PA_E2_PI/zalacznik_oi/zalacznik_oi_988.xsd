<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:zm="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2014/12/05/eD/PITM/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2014/12/05/eD/PITM/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/StrukturyDanych_v3-0E.xsd"/>
	<xsd:complexType name="TNaglowek_PIT_M">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zm:TKodFormularza_M">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT/M (6)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="6"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_M">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/M"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_M">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O DOCHODACH MAŁOLETNICH DZIECI, PODLEGAJĄCYCH ŁĄCZNEMU OPODATKOWANIU Z DOCHODAMI RODZICÓW W ROKU PODATKOWYM</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zm:TNaglowek_PIT_M"/>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TIdentyfikatorOsobyFizycznej1"/>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dochody małoletnich dzieci, podlegające łącznemu opodatkowaniu z dochodami rodziców, lub straty ze źródeł przychodów</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>1. Renty krajowe i zagraniczne</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_6" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_7" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_8" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>2. Najem lub dzierżawa</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_9" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_10" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_11" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_12" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_13" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>3. Prawa majątkowe</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_14" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_15" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_16" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_17" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_18" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>4. Inne źródła, niewymienione w wierszach od 1 do 3</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_19" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_20" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_21" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_22" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_23" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>5. Razem</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_24" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_25" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_26" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_27" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_28" type="etd:TWybor1_2">
								<xsd:annotation>
									<xsd:documentation>Prawo pobierania pożytków z dochodu dzieci przysługuje: 1 - obojgu rodzicom, 2 - tylko jednemu z rodziców</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_29" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Kwota dochodu</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Kwota zaliczki</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
