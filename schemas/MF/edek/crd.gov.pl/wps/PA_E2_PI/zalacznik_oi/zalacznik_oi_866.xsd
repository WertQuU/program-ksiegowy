													<xsd:documentation>Podatnik - Kwota przekazanej darowizny</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D11" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Małżonek - Kwota przekazanej darowizny</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_19" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 3. Wydatki na cele rehabilitacyjne oraz wydatki związane z ułatwieniem wykonywania czynności życiowych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_20" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek - 3. Wydatki na cele rehabilitacyjne oraz wydatki związane z ułatwieniem wykonywania czynności życiowych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_21" type="etd:TKwota2Nieujemna" minOccurs="0">
