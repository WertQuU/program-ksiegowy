			<xsd:selector xpath=".//tns:SchematDotyczyPanstw"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="klucz_kodKrajuP">
			<xsd:selector xpath=".//tns:SchematDotyczyPanstwP"/>
			<xsd:field xpath="."/>
		</xsd:unique>
	</xsd:element>
</xsd:schema>
