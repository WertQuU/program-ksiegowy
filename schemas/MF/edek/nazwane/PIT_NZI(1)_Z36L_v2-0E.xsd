<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" xmlns:kue="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/04/eD/KodyUE/" xmlns:zzi36l="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/02/08/eD/PITNZI36L/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/02/08/eD/PITNZI36L/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/04/eD/KodyUE/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/04/eD/KodyUE/KodyKrajowUE_v3-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/StrukturyDanych_v7-0E.xsd"/>
	<!--Załącznik do zeznań: PIT-36L.-->
	<!-- -->
	<!--Wypełniają podatnicy, którzy uwzględnili w kosztach uzyskania przychodów wartość rynkową składnika majątku, w tym przedsiębiorstwa lub jego zorganizowanej części, określoną w państwie członkowskim Unii Europejskiej do celów opodatkowania podatkiem równoważnym do podatku od dochodów z niezrealizowanych zysków.-->
	<xsd:complexType name="TNaglowek_PIT_NZI">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zzi36l:TKodFormularza_PIT_NZI">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PITNZI (1)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="2-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_PIT_NZI">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/NZI"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_NZI">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI WARTOŚCI RYNKOWEJ SKŁADNIKA MAJĄTKU OKREŚLONEJ W PAŃSTWIE CZŁONKOWSKIM UNII EUROPEJSKIEJ DO CELÓW OPODATKOWANIA PODATKIEM RÓWNOWAŻNYM DO PODATKU OD DOCHODÓW Z NIEZREALIZOWANYCH ZYSKÓW</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zzi36l:TNaglowek_PIT_NZI"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacje dodatkowe, informacja o wysokości wartości rynkowej składnika majątku, w tym przedsiębiorstwa lub zorganizowanej części przedsiębiorstwa</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_9" type="kue:TKodKrajuUE">
								<xsd:annotation>
									<xsd:documentation>Kod kraju, w którym określona została wartość rynkowa składnika majątku</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_C" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące składnika majątku</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="P_C11" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Rodzaj składnika majątku, przeniesionego na terytorium Rzeczypospolitej Polskiej</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_C12">
											<xsd:annotation>
												<xsd:documentation>Wartość rynkowa składnika majątku, o którym mowa w art. 30dg ustawy</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="etd:TKwota2Nieujemna">
													<xsd:minExclusive value="0"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="P_C13" type="etd:TWybor1_2">
											<xsd:annotation>
												<xsd:documentation>Wartość rynkowa została określona przez organ podatkowy: 1 - tak, 2 - nie</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_C14" type="etd:TZnakowy" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Jeśli wartość rynkową określił podatnik, należy wskazać metodę przyjętą dla określenia wartości rynkowej składnika majątku</xsd:documentation>
											</xsd:annotation>
											<!--Wypełniają podatnicy, którzy w P_C13 wybrali wartość 2.-->
										</xsd:element>
										<xsd:element name="P_C15" type="etd:TWybor1_2">
											<xsd:annotation>
												<xsd:documentation>Wartość rynkowa została potwierdzona przez właściwy organ państwa: 1 - tak, 2 - nie</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
