							</xsd:annotation>
						</xsd:element>
					</xsd:sequence>
					<xsd:sequence>
						<xsd:element name="P_346" type="etd:TWybor1_2">
							<xsd:annotation>
								<xsd:documentation>Załącznik PIT/D dołącza do swojego zeznania: 1 - podatnik, 2 - małżonek</xsd:documentation>
							</xsd:annotation>
						</xsd:element>
						<xsd:element name="P_347" type="etd:TWybor1_3">
							<xsd:annotation>
								<xsd:documentation>Kod formularza, do którego został dołączony załącznik PIT/D: 1 - PIT-28, 2 - PIT-36, 3 - PIT-37</xsd:documentation>
							</xsd:annotation>
						</xsd:element>
						<xsd:element name="P_348" type="etd:TZnakowy" minOccurs="0">
