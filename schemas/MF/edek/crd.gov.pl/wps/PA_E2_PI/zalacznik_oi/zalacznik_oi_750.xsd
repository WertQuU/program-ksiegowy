<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:czmt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/SPRMT/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/SPRMT/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/StrukturyDanych_v3-0E.xsd"/>
	<xsd:complexType name="TNaglowek_SPR_MT">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czmt:TKodFormularza_MT">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="SPR/MT (1)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czmt:TLDataOd2">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czmt:TLDataDo2">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLDataOd2">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty od</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:minInclusive value="2009-11-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLDataDo2">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty do</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:minInclusive value="2011-09-30"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_MT">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="SPR/MT"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_SPR_MT">
		<xsd:annotation>
			<xsd:documentation>SPRAWOZDANIE O REALIZACJI UZNANEJ METODY USTALANIA CENY TRANSAKCYJNEJ DLA CELÓW PODATKU DOCHODOWEGO</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czmt:TNaglowek_SPR_MT"/>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TPodmiotDowolnyBezAdresu2">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence>
								<xsd:element name="P_7">
									<xsd:annotation>
										<xsd:documentation>Decyzja, której dotyczy składane sprawozdanie - Data</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="xsd:date">
											<xsd:minInclusive value="1990-01-01"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_8" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Decyzja, której dotyczy składane sprawozdanie - Nr decyzji</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_9">
									<xsd:annotation>
										<xsd:documentation>Okres obowiązywania decyzji - Od</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="xsd:date">
											<xsd:minInclusive value="1990-01-01"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_10">
									<xsd:annotation>
										<xsd:documentation>Okres obowiązywania decyzji - Do</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="xsd:date">
											<xsd:minInclusive value="1990-01-01"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_11" type="etd:TWybor1_3">
								<xsd:annotation>
									<xsd:documentation>Rodzaj porozumienia objętego postanowieniami decyzji: 1 - jednostronne, 2 - dwustronne, 3 - wielostronne</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_12">
								<xsd:annotation>
									<xsd:documentation>Nazwisko / Pełna nazwa podmiotu powiązanego, którego dotyczy decyzja </xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:token">
										<xsd:minLength value="1"/>
										<xsd:maxLength value="240"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_13" type="etd:TImie" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Pierwsze imię podmiotu powiązanego, którego dotyczy decyzja </xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:choice>
								<xsd:annotation>
									<xsd:documentation>Identyfikator/y podatkowy/e  podmiotu powiązanego, którego dotyczy decyzja </xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:element name="P_14" type="etd:TNrNIP">
										<xsd:annotation>
											<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:sequence minOccurs="0">
										<xsd:element name="P_15" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Numer identyfikacji podatkowej podmiotu zagranicznego</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_16" type="etd:TKodKrajuWydania">
											<xsd:annotation>
												<xsd:documentation>Kod kraju, o którym mowa w poz. 15</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:element name="P_15" type="etd:TZnakowy">
										<xsd:annotation>
											<xsd:documentation>Numer identyfikacji podatkowej podmiotu zagranicznego</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_16" type="etd:TKodKrajuWydania">
										<xsd:annotation>
											<xsd:documentation>Kod kraju, o którym mowa w poz. 15</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:choice>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Adres zamieszkania/siedziby  podmiotu powiązanego, którego dotyczy decyzja </xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_17A" type="etd:TKodKraju">
									<xsd:annotation>
										<xsd:documentation>Kod kraju</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_18" type="etd:TJednAdmin" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Województwo</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_19" type="etd:TJednAdmin" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Powiat</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_20" type="etd:TJednAdmin" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Gmina</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_21" type="etd:TUlica" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Ulica</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_22" type="etd:TNrBudynku" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Nr domu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_23" type="etd:TNrLokalu" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Nr lokalu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_24" type="etd:TMiejscowosc">
									<xsd:annotation>
										<xsd:documentation>Miejscowość</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_25" type="etd:TKodPocztowy" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Kod pocztowy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_26" type="etd:TMiejscowosc" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Poczta</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Przyjęta w decyzji metoda ustalania ceny transakcyjnej zrealizowana w okresie, za który składane jest sprawozdanie</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_27" type="etd:TTekstowy">
									<xsd:annotation>
										<xsd:documentation>Przyjęta w decyzji metoda ustalania ceny</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_28" type="etd:TTekstowy">
									<xsd:annotation>
										<xsd:documentation>Wielkość sprzedaży towarów i usług objętych decyzją</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_29" type="etd:TTekstowy">
									<xsd:annotation>
										<xsd:documentation>Ceny transakcyjne objęte decyzją stosowane z podmiotami powiązanymi</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_30" type="etd:TTekstowy">
									<xsd:annotation>
										<xsd:documentation>Okres stosowania metody ustalania ceny transakcyjnej</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Niezależna od podatnika zmiana stosunków gospodarczych mająca wpływ na realizację uznanej w decyzji metody ustalania ceny transakcyjnej, powodująca rażącą nieadekwatność wyboru i stosowania uznanej w decyzji metody ustalania ceny transakcyjnej</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_31" type="etd:TTekstowy">
									<xsd:annotation>
										<xsd:documentation>Rodzaj zmiany</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_32" type="etd:TTekstowy">
									<xsd:annotation>
										<xsd:documentation>Przyczyna zmiany</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_33" type="etd:TTekstowy">
									<xsd:annotation>
										<xsd:documentation>Skutki finansowe</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_34">
								<xsd:annotation>
									<xsd:documentation>Data sprawozdania</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:date">
										<xsd:minInclusive value="2011-09-30"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
