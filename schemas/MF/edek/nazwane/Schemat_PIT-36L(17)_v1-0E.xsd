							<xsd:element name="P_169" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/IP</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_170" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/ZG</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="0"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_172" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/DS</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_174" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/PM</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_175" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/O</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_176" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach - Liczba załączników PIT/NZI</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="0"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_177" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/MIT</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Rachunek osobisty właściwy do zwrotu nadpłaty</xsd:documentation>
								</xsd:annotation>
								<!--Jeżeli z zeznania wynika nadpłata w tej części można wskazać rachunek bankowy lub w spółdzielczej kasie oszczędnościowo-kredytowej (SKOK), inny niż związany z prowadzoną działalnością gospodarczą, na który ma nastąpić jej zwrot. Podaje się wyłącznie rachunek, którego posiadaczem (współposiadaczem) jest podatnik. Wskazany rachunek aktualizuje poprzednio zgłoszony rachunek służący do zwrotu podatku lub nadpłaty podatnika.-->
								<xsd:element name="P_180">
									<xsd:annotation>
										<xsd:documentation>Posiadacz rachunku (należy wskazać imię i nazwisko posiadacza, a w przypadku, gdy jest to rachunek wspólny - imiona i nazwiska wszystkich współposiadaczy)</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TZnakowy">
											<xsd:maxLength value="70"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:sequence minOccurs="0">
									<xsd:element name="P_181A" type="etd:TKodKrajuWydania">
										<xsd:annotation>
											<xsd:documentation>Kraj siedziby banku (oddziału)</xsd:documentation>
										</xsd:annotation>
										<!--uzupełnić wyłącznie, gdy wskazano rachunek zagraniczny-->
									</xsd:element>
									<xsd:element name="P_182_2" type="tns:SWIFT_Type">
										<xsd:annotation>
											<xsd:documentation>Kod SWIFT</xsd:documentation>
										</xsd:annotation>
										<!--w przypadku rachunku zagranicznego należy podać kod SWIFT-->
									</xsd:element>
								</xsd:sequence>
								<xsd:element name="P_182_1" type="tns:TNrIBAN">
									<xsd:annotation>
										<xsd:documentation>Pełny numer rachunku - numer IBAN</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_183" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Karta dużej rodziny (KDR). Podatnik posiada ważną KDR: 1 - tak</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence minOccurs="0">
							<xsd:sequence minOccurs="0">
								<xsd:element ref="zb36x:Zalacznik_PIT_B"/>
								<xsd:element ref="zbr36l:Zalacznik_PIT_BR" minOccurs="0"/>
								<xsd:element ref="z36lx:Zalacznik_PIT_Z" minOccurs="0"/>
								<xsd:element ref="zwz36x:Zalacznik_PIT_WZ" minOccurs="0"/>
								<xsd:element ref="zse36x:Zalacznik_PIT_SE" minOccurs="0"/>
							</xsd:sequence>
							<xsd:element ref="zip36x:Zalacznik_PIT_IP" minOccurs="0"/>
							<xsd:element ref="zg36l:Zalacznik_PIT_ZG" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="zds36l:Zalacznik_PIT_DS" minOccurs="0"/>
							<xsd:element ref="zpm36l:Zalacznik_PIT_PM" minOccurs="0"/>
							<xsd:element ref="zo36lx:Zalacznik_PIT_O" minOccurs="0"/>
							<xsd:element ref="zzi36l:Zalacznik_PIT_NZI" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="zmt36l:Zalacznik_PIT_MIT" minOccurs="0"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Pouczenia">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższych pouczeń:
W przypadku niewpłacenia w obowiązujących terminach kwot z poz. 136 i 138-161 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego, w tym również na odsetki od kwot wykazanych w poz. 77-106, 108-113, 115-120 i 122-127, zgodnie z art. 3a § 1 pkt 1 ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz. U. z 2020 r. poz. 1427, z późn. zm.).
Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie podatku na uszczuplenie grozi odpowiedzialność przewidziana w Kodeksie karnym skarbowym.
								</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>