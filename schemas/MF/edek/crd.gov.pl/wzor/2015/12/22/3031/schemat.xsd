						<xsd:annotation>
							<xsd:documentation>Liczba podatników za m-c V</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="0"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_14" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Liczba podatników za m-c VI</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="0"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_15" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Należne zaliczki za m-c I</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_16" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Należne zaliczki za m-c II</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_17" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Należne zaliczki za m-c III</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_18" type="etd:TKwotaCNieujemna" minOccurs="0">
