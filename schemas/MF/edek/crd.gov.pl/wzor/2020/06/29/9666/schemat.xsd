<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czbr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITBR/" xmlns:czd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITD/" xmlns:czgk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITPGK/" xmlns:czip="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITIP/" xmlns:czmit="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITMIT/" xmlns:cznz="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITNZI/" xmlns:czpm="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITPM/" xmlns:czst="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITSTZ/" xmlns:czww="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITWW/" xmlns:czwzg="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITWZG/" xmlns:cz8s="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CIT8S/" xmlns:cz8sp="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CIT8SP/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/" xmlns:tns="http://crd.gov.pl/wzor/2020/06/29/9666/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/25/eD/ORDZU/" targetNamespace="http://crd.gov.pl/wzor/2020/06/29/9666/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITSTZ/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITSTZ/CIT-ST(7)_Z_v8-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITBR/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITBR/CIT_BR(7)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITD/CIT-D(7)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITMIT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITMIT/CIT_MIT(3)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITNZI/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITNZI/CIT_NZI(2)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CIT8SP/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CIT8SP/CIT_8SP(4)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CIT8S/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CIT8S/CIT_8S(4)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITPGK/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITPGK/CIT_PGK(4)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITPM/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITPM/CIT_PM(1)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITIP/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITIP/CIT_IP(2)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITWW/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITWW/CIT_WW(2)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITWZG/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITWZG/CIT_WZG(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/25/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/25/eD/ORDZU/ORD-ZU(3)_v3-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/StrukturyDanych_v6-0E.xsd"/>
	<!--Ilekroć jest mowa o urzędzie skarbowym, w tym urzędzie skarbowym, do którego jest adresowane zeznanie - oznacza to urząd skarbowy, przy pomocy którego właściwy dla podatnika naczelnik urzędu skarbowego wykonuje swoje zadania.-->
	<!-- -->
	<!--Zeznanie jest składane wyłącznie za pomocą środków komunikacji elektronicznej-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT8AB (4)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-1E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="4"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_7"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-8AB"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla dat dotyczących roku podatkowego</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2020-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TDataPGK">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla dat dotyczących danych rejestracyjnych PGK</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="1996-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>ZEZNANIE O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) PRZEZ PODATKOWĄ GRUPĘ KAPITAŁOWĄ I NALEŻNEGO PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne PGK i adres siedziby spółki dominującej w PGK</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TOsobaNiefizyczna2">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="PGK"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane rejestracyjne PGK, informacja o załącznikach, informacje dodatkowe o PGK, ustalenie podstawy opodatkowania i należnego podatku, zaliczki miesięczne lub zaliczki kwartalne oraz podatek, o którym mowa w art. 24b ustawy, różnica pomiędzy podatkiem należnym a należnymi zaliczkami, kwota do zapłaty / nadpłata, inne zobowiązania podatkowe, dane identyfikacyjne spółki dominującej w PGK, informacje dodatkowe</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_8" type="etd:TWybor1_2" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Rodzaj korekty. Wartość: 1 - korekta zeznania, o której mowa w art. 81 Ordynacji podatkowej, 2 - korekta zeznania, o której mowa w art. 81b § 1a Ordynacji podatkowej</xsd:documentation>
								</xsd:annotation>
								<!--Ilekroć jest mowa o Ordynacji podatkowej oznacza to ustawę z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2019 r. poz. 900, z późn. zm.).-->
								<!-- -->
								<!--Ad. wartość 2 - Korekta składana w toku postępowania podatkowego w sprawie unikania opodatkowania; korektę składa się wraz z uzasadnieniem przyczyn korekty.-->
							</xsd:element>
							<xsd:sequence>
								<xsd:element name="P_19" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Organ wydający decyzję o rejestracji PGK</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_20" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Nr decyzji</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_21" type="tns:TDataPGK">
									<xsd:annotation>
										<xsd:documentation>Data wydania decyzji</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_22" type="tns:TDataPGK">
									<xsd:annotation>
										<xsd:documentation>Data rozpoczęcia pierwszego roku podatkowego PGK</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_23" type="tns:TDataPGK">
									<xsd:annotation>
										<xsd:documentation>Okres, od którego została zawarta umowa o utworzeniu PGK</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_24" type="tns:TDataPGK" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Okres, do którego została zawarta umowa o utworzeniu PGK</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_25">
									<xsd:annotation>
										<xsd:documentation>Liczba spółek tworzących PGK</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TNaturalny">
											<xsd:minInclusive value="2"/>
											<xsd:maxInclusive value="99"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_26" type="etd:TNrNIP">
									<xsd:annotation>
										<xsd:documentation>Identyfikator podatkowy NIP spółki dominującej w PGK</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_27" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Rejestracja umowy o utworzeniu PGK przez organ podatkowy: 1 - po dniu 1 stycznia 1997 r., 2 - przed dniem 1 stycznia 1997 r.</xsd:documentation>
									</xsd:annotation>
									<!--Dotyczy podatkowej grupy kapitałowej, jeżeli umowa o jej utworzeniu została zarejestrowana przez urząd skarbowy przed dniem 1 stycznia 1997 r. (art. 3 ustawy z dnia 21 listopada 1996 r. o zmianie ustawy o podatku dochodowym od osób prawnych (Dz. U. poz. 639)).-->
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:element name="P_28" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Podatnik jest obowiązany do złożenia CIT-ST. Wybór: 1 - tak, 2 -nie</xsd:documentation>
									</xsd:annotation>
									<!--Podatnicy posiadający zakłady (oddziały), położone na obszarze jednostki samorządu terytorialnego innej niż jednostka samorządu terytorialnego, na obszarze której podatnicy mają swoją siedzibę, w tym podatnicy prowadzący działalność poprzez położony na terytorium RP zakład zagraniczny, zatrudniający osoby na podstawie umowy o pracę - art. 28 ust. 1 i 2 ustawy oraz art. 10 ust. 1, 2 i 2a ustawy z dnia 13 listopada 2003 r. o dochodach jednostek samorządu terytorialnego (Dz. U. z 2020 r. poz. 23). W przypadku zaznaczenia w poz. 28 kwadratu nr 1 należy podać liczbę załączników w poz. 29.-->
								</xsd:element>
								<xsd:element name="P_29" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Liczba CIT-ST</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_30" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Informacja o załącznikach CIT/BR</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_41" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik występuje o zwrot niewykorzystanego odliczenia na podstawie art. 18da ustawy. Wybór: 1 - tak</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_31">
									<xsd:annotation>
										<xsd:documentation>Informacja o załącznikach CIT-D</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TNaturalny">
											<xsd:minInclusive value="0"/>
											<xsd:maxInclusive value="99"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_139" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odliczenia darowizn na cele kształcenia zawodowego - art. 18 ust. 1 pkt 8 ustawy. Dochody (przychody) z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_140" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odliczenia darowizn na cele kształcenia zawodowego - art. 18 ust. 1 pkt 8 ustawy. Dochody (przychody) z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_32" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach CIT/MIT</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_33" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach CIT/NZI</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="0"/>
										<xsd:maxInclusive value="99"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_34" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach CIT/8SP</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_35" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach CIT/8S</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_36">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach CIT/PGK</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="1"/>
										<xsd:maxInclusive value="99"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_37" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach CIT/PM</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="0"/>
										<xsd:maxInclusive value="99"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_38" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach CIT/IP</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_39" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach CIT/WW</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_40" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o załącznikach CIT/WZG</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="0"/>
										<xsd:maxInclusive value="99"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_42" type="etd:TKwotaCNieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Wydatki inwestycyjne dokonane w roku podatkowym - art. 1a ust. 2 pkt 3 lit. a ustawy w brzmieniu nadanym przez art. 1 pkt 1 ustawy z dnia 13 października 1995 r. o zmianie ustawy o podatku dochodowym od osób prawnych oraz o zmianie niektórych innych ustaw (Dz. U. poz. 704)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_43" type="etd:TKwotaCNieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Łączny kapitał zakładowy spółek wchodzących w skład PGK na ostatni dzień roku podatkowego</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_44" type="etd:TKwotaCNieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Przeciętny kapitał zakładowy spółek wchodzących w skład PGK na ostatni dzień roku podatkowego</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_45" type="etd:TKwotaCNieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Suma przychodów wszystkich spółek tworzących PGK (art. 1a ust. 2 pkt 4 ustawy)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_46" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>W trakcie roku podatkowego nastąpiło zdarzenie skutkujące naruszeniem warunków uznania PGK za podatnika. Wybór: 1 - tak</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
