<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://crd.gov.pl/wzor/2015/02/10/2049/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/10/07/eD/ORDZU/" targetNamespace="http://crd.gov.pl/wzor/2015/02/10/2049/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/StrukturyDanych_v3-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/10/07/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/10/07/eD/ORDZU/ORD-ZU(2)_v2-0E.xsd"/>
	<!--Ilekroć jest mowa o urzędzie skarbowym - oznacza to urząd skarbowy, o którym mowa w ustawie.-->
	<!-- -->
	<!--Zgodnie z art. 81 ustawy z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2012 r. poz. 749, z późn. zm.) podatnik może skorygować złożoną deklarację poprzez złożenie deklaracji korygującej wraz z dołączonym pisemnym uzasadnieniem przyczyn korekty.-->
	<!-- -->
	<!--W przypadku gdy występują więcej niż 3 osoby prawne będące darczyńcami, informacje należy złożyć na dodatkowym formularzu CIT-D.-->
	<!-- -->
	<!--Jeżeli podatnik składa więcej niż jeden formularz CIT-D, poz. 23 i część C.4 wypełnia na pierwszym formularzu.-->
	<!-- -->
	<!--W przypadku przekazania więcej niż 3 darowizn informacje należy złożyć na dodatkowym formularzu CIT-D.-->
	<xsd:complexType name="TNaglowek_CIT-D">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT-D1 (4)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="4"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_9"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="TLDataP">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="TLDataK">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLDataP">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty od</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:minInclusive value="2013-03-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLDataK">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty do</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:minInclusive value="2015-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-D"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA PODATNIKA PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH O OTRZYMANYCH/PRZEKAZANYCH DAROWIZNACH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="TNaglowek_CIT-D"/>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TOsobaNiefizyczna">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacja o otrzymanych darowiznach</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Pouczenie">
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:enumeration value="Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie na uszczuplenie podatku grozi odpowiedzialnośc przewidziana w Kodeksie karnym skarbowym."/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PozycjeSzczegolowe">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="P_6">
					<xsd:annotation>
						<xsd:documentation>Nr formularza</xsd:documentation>
					</xsd:annotation>
					<!--Należy podać kolejny numer formularza (załącznika) w ogólnej liczbie wszystkich składanych przez podatnika formularzy (załączników) CIT-D.-->
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="1"/>
							<xsd:maxInclusive value="99"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_8">
					<xsd:annotation>
						<xsd:documentation>Informacja dotyczy podatnika nieskładającego zeznania</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="xsd:byte">
							<xsd:enumeration value="1"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_10">
					<xsd:annotation>
						<xsd:documentation>Rodzaj podatnika wyłącznie otrzymującego darowiznę</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="xsd:byte">
							<xsd:enumeration value="1"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_23" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwota ogółem otrzymanych darowizn</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_24" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>W tym kwota darowizn od osoby prawnej (1)</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_25" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>W tym kwota darowizn od osoby prawnej (2)</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_26" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>W tym kwota darowizn od osoby prawnej (3)</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dane darczyńcy (1)</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_27" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Nazwa pełna</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_28A" type="etd:TKodKraju">
						<xsd:annotation>
							<xsd:documentation>Kod kraju</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_29" type="etd:TJednAdmin" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Województwo</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_30" type="etd:TJednAdmin" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Powiat</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_31" type="etd:TJednAdmin" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Gmina</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_32" type="etd:TUlica" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Ulica</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_33" type="etd:TNrBudynku" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Nr domu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_34" type="etd:TNrLokalu" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Nr lokalu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_35" type="etd:TMiejscowosc">
						<xsd:annotation>
							<xsd:documentation>Miejscowość</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_36" type="etd:TKodPocztowy" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kod pocztowy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_37" type="etd:TMiejscowosc" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Poczta</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dane darczyńcy (2)</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_38" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Nazwa pełna</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_39A" type="etd:TKodKraju">
						<xsd:annotation>
							<xsd:documentation>Kod kraju</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_40" type="etd:TJednAdmin" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Województwo</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_41" type="etd:TJednAdmin" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Powiat</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_42" type="etd:TJednAdmin" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Gmina</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_43" type="etd:TUlica" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Ulica</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_44" type="etd:TNrBudynku" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Nr domu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_45" type="etd:TNrLokalu" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Nr lokalu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_46" type="etd:TMiejscowosc">
						<xsd:annotation>
							<xsd:documentation>Miejscowość</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_47" type="etd:TKodPocztowy" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kod pocztowy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_48" type="etd:TMiejscowosc" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Poczta</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dane darczyńcy (3)</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_49" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Nazwa pełna</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_50A" type="etd:TKodKraju">
						<xsd:annotation>
							<xsd:documentation>Kod kraju</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_51" type="etd:TJednAdmin" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Województwo</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_52" type="etd:TJednAdmin" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Powiat</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_53" type="etd:TJednAdmin" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Gmina</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_54" type="etd:TUlica" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Ulica</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_55" type="etd:TNrBudynku" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Nr domu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_56" type="etd:TNrLokalu" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Nr lokalu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_57" type="etd:TMiejscowosc">
						<xsd:annotation>
							<xsd:documentation>Miejscowość</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_58" type="etd:TKodPocztowy" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kod pocztowy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_59" type="etd:TMiejscowosc" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Poczta</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_60" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Działalność charytatywna</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_61" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Pomoc ofiarom katastrof, klęsk żywiołowych, konfliktów zbrojnych i wojen w kraju i za granicą</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_62" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Pomoc społeczna, w tym pomoc rodzinom i osobom w trudnej sytuacji życiowej oraz wyrównywanie szans tych rodzin i osób</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_63" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Krajoznawstwo oraz wypoczynek dzieci i młodzieży</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_64" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Nauka, edukacja, oświata i wychowanie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_65" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Działania na rzecz osób niepełnosprawnych</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_66" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kultura, sztuka, ochrona dóbr kultury i tradycji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_67" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Ekologia i ochrona zwierząt oraz ochrona dziedzictwa przyrodniczego</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_68" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Ochrona i promocja zdrowia</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_69" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Działalność wspomagająca rozwój gospodarczy, w tym rozwój przedsiębiorczości</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_70" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Upowszechnienie kultury fizycznej i sportu</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_71" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Ratownictwo i ochrona ludności</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_72" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Cele kultu religijnego</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_73" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Działalność charytatywno - opiekuńcza</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_74" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Pozostałe cele</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>