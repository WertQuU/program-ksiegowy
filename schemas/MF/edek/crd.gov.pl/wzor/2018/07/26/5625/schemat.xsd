<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czbr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITBR/" xmlns:czd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITD/" xmlns:czgk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITPGK/" xmlns:czmit="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITMIT/" xmlns:czmt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SPRMT/" xmlns:czst="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/06/05/eD/CITSTZ/" xmlns:cz8s="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CIT8S/" xmlns:cz8sp="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CIT8SP/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" xmlns:tns="http://crd.gov.pl/wzor/2018/07/26/5625/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/" targetNamespace="http://crd.gov.pl/wzor/2018/07/26/5625/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/06/05/eD/CITSTZ/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/06/05/eD/CITSTZ/CIT-ST(7)_Z_v5-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITD/CIT-D(6)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SPRMT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SPRMT/SPR_MT(1)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITBR/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITBR/CIT_BR(4)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITMIT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITMIT/CIT_MIT(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITPGK/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITPGK/CIT_PGK(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CIT8S/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CIT8S/CIT_8S(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CIT8SP/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CIT8SP/CIT_8SP(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/ORD-ZU(3)_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/StrukturyDanych_v4-0E.xsd"/>
	<!--Ilekroć w zeznaniu jest mowa o urzędzie skarbowym, w tym urzędzie skarbowym do którego adresowane jest zeznanie - oznacza to urząd skarbowy, przy pomocy którego właściwy dla podatnika naczelnik urzędu skarbowego wykonuje swoje zadania.-->
	<!-- -->
	<!--Jeżeli podatnik składa zeznanie:
a) w terminie do 20 dnia pierwszego miesiąca następnego roku podatkowego - w poz. 254 powinien uwzględnić wyłącznie zaliczki wpłacone do końca tego roku podatkowego, za który jest składane zeznanie,
b) w terminie do końca trzeciego miesiąca roku następnego - w poz. 254 powinien uwzględnić zaliczki wpłacone do końca roku podatkowego oraz za ostatni miesiąc (kwartał) zaliczkę wpłaconą do 20 dnia pierwszego miesiąca roku następnego.-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT8AB (1)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_7"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
				<!--Zgodnie z art. 81 ustawy z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2018 r. poz. 800, z późn. zm.).-->
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-8AB"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TIdentyfikatorOsobyNiefizycznejPGK">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych identyfikacyjnych o osobie niefizycznej</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NIP" type="etd:TNrNIP">
				<xsd:annotation>
					<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PelnaNazwa">
				<xsd:annotation>
					<xsd:documentation>Pełna nazwa</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:token">
						<xsd:minLength value="1"/>
						<xsd:maxLength value="240"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TOsobaNiefizycznaPGK">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych o osobie niefizycznej</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OsobaNiefizyczna" type="tns:TIdentyfikatorOsobyNiefizycznejPGK"/>
			<xsd:element name="AdresSiedziby">
				<xsd:complexType>
					<xsd:complexContent>
						<xsd:extension base="etd:TAdres">
							<xsd:attribute name="rodzajAdresu" type="xsd:string" use="required" fixed="RAD"/>
						</xsd:extension>
					</xsd:complexContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla dat dotyczących roku podatkowego</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2018-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TDataPGK">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla dat dotyczących danych rejestracyjnych PGK</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="1996-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>ZEZNANIE O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) PRZEZ PODATKOWĄ GRUPĘ KAPITAŁOWĄ- PODATNIKA PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne i adres siedziby PGK</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="tns:TOsobaNiefizycznaPGK">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="PGK"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="tns:PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach, informacje dodatkowe o PGK, ustalenie podstawy opodatkowania i należnego podatku, kwoty należnych zaliczek miesięcznych lub zaliczek kwartalnych oraz kwoty podatku, różnica pomiędzy podatkiem należnym a należnymi zaliczkami, kwota do zapłaty / nadpłata, inne zobowiązania podatkowe, dane spółki reprezentującej PGK</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Pouczenia">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższych pouczeń:
								Niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz. U. z 2017 r. poz. 1201, z późn. zm.) na odsetki od wykazanych i nieuiszczonych w obowiązujących terminach lub uiszczonych w niepełnej wysokości kwot z poz. 156 - 251.
W przypadku niewpłacenia w obowiązujących terminach kwot z poz. 257 i 259 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego, zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji.
Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie podatku na uszczuplenie grozi odpowiedzialnośc przewidziana w Kodeksie karnym skarbowym.
								</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="czst:Zalacznik_CIT-ST" minOccurs="0"/>
							<xsd:element ref="czd:Zalacznik_CIT-D" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="czmt:Zalacznik_SPR_MT" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="czbr:Zalacznik_CIT_BR" minOccurs="0"/>
							<xsd:element ref="czmit:Zalacznik_CIT_MIT" minOccurs="0"/>
							<xsd:element ref="czgk:Zalacznik_CIT_PGK" maxOccurs="unbounded"/>
							<xsd:element ref="cz8s:Zalacznik_CIT_8S" minOccurs="0"/>
							<xsd:element ref="cz8sp:Zalacznik_CIT_8SP" minOccurs="0"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
		<xsd:unique name="klucz_NIP">
			<xsd:selector xpath="tns:Zalaczniki/czgk:Zalacznik_CIT_PGK"/>
			<xsd:field xpath="czgk:Podmiot2/czgk:OsobaNiefizyczna/czgk:NIP"/>
		</xsd:unique>
	</xsd:element>
	<xsd:element name="PozycjeSzczegolowe">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:sequence>
					<xsd:element name="P_19" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Organ wydający decyzję o rejestracji PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_20" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Nr decyzji</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_21" type="tns:TDataPGK">
						<xsd:annotation>
							<xsd:documentation>Data wydania decyzji</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_22" type="tns:TDataPGK">
						<xsd:annotation>
							<xsd:documentation>Data rozpoczęcia pierwszego roku podatkowego PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_23" type="tns:TDataPGK">
						<xsd:annotation>
							<xsd:documentation>Okres, od którego została zawarta umowa o utworzeniu PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_24" type="tns:TDataPGK" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Okres, do którego została zawarta umowa o utworzeniu PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_25">
						<xsd:annotation>
							<xsd:documentation>Liczba spółek tworzących PGK</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="2"/>
								<xsd:maxInclusive value="99"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_26" type="etd:TWybor1_2">
						<xsd:annotation>
							<xsd:documentation>Spółka reprezentująca PGK jest spółką dominującą: 1 - tak, 2 - nie</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_27" type="etd:TNrNIP">
						<xsd:annotation>
							<xsd:documentation>Identyfikator podatkowy NIP spółki reprezentującej PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_28" type="etd:TWybor1_2">
						<xsd:annotation>
							<xsd:documentation>Rejestracja umowy o utworzeniu PGK przez organ podatkowy: 1 - po dniu 1 stycznia 1997 r., 2 - przed dniem 1 stycznia 1997 r.<!--Dotyczy podatkowej grupy kapitałowej, jeżeli umowa o jej utworzeniu została zarejestrowana przez urząd skarbowy przed dniem 1 stycznia 1997 r. (art. 3 ustawy z dnia 21 listopada 1996 r. o zmianie ustawy o podatku dochodowym od osób prawnych (Dz. U. poz. 639)). -->
							</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_29" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT-ST</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_30" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT-D</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_31" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Sprawozdanie o realizacji uznanej metody ustalania ceny transakcyjnej</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:sequence>
					<xsd:element name="P_32" type="etd:TWybor1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Informacja o załącznikach CIT/BR</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_37" type="etd:TWybor1_2">
						<xsd:annotation>
							<xsd:documentation>Podatnik występuje o zwrot niewykorzystanego odliczenia na podstawie art. 18da ustawy. Wybór: 1 - tak, 2 - nie</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_33" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/MIT</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_34">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/PGK</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="1"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_35" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/8S</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_36" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/8SP</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_38" type="etd:TKwotaCNieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwota wydatków inwestycyjnych dokonana w roku podatkowym - art. 1a ust. 2 pkt 3 lit. a ustawy w brzmieniu nadanym przez art. 1 pkt 1 ustawy z 13 października 1995 r. o zmianie ustawy o podatku dochodowym od osób prawnych oraz o zmianie niektórych innych ustaw (Dz. U. poz. 704)</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_39" type="etd:TKwotaCNieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Łączny kapitał zakładowy spółek wchodzących w skład PGK na ostatni dzień roku podatkowego</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_40" type="etd:TKwotaCNieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Przeciętny kapitał zakładowy spółek wchodzących w skład PGK na ostatni dzień roku podatkowego</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_41" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Suma przychodów wszystkich spółek tworzących PGK (art. 1a ust 2 pkt 4 ustawy)</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwotaCNieujemna">
							<xsd:minExclusive value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_42" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>W trakcie roku podatkowego nastąpiło zdarzenie skutkujące naruszeniem warunków uznania PGK za podatnika. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_43" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>W trakcie roku podatkowego nastąpiła zmiana umowy lub zmiana w kapitale zakładowym spółki. Wybór: 1 - tak, 2 - nie</xsd:documentation>
