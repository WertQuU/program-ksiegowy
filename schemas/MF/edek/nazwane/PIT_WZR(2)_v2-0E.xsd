<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:zwzr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/11/02/eD/PITWZR/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/11/02/eD/PITWZR/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<!--Załącznik do zeznań PIT-28 i PIT-28S.-->
	<!-- -->
	<!--Wypełniają podatnicy, którzy na podstawie art. 11 ust. 4-19 ustawy z dnia 20 listopada 1998 r. o zryczałtowanym podatku dochodowym od niektórych przychodów osiąganych przez osoby fizyczne (Dz. U. z 2021 r. poz. 1993, z późn. zm.) rozliczają wierzytelności lub zobowiązania wynikające z art. 4 pkt 1a ustawy z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych (Dz. U. z 2021 r. poz. 424).-->
	<!-- -->
	<!--Podatnik będący wspólnikiem spółki osobowej wpisuje wartość wierzytelności/zobowiązania stosownie do swojego udziału.-->
	<!-- -->
	<!--Jeżeli podatnik składa więcej niż jeden załącznik PIT/WZR, w poz. 12 ostatniego załącznika sumuje kwoty z poz. 11 wszystkich załączników. Odpowiednio należy uczynić w przypadku sumowania kwot z poz. 17, 23, 29, 35, 41, 47 i 53 załączników PIT/WZR, z których sumy należy wykazać w ostatnim załączniku PIT/WZR odpowiednio w poz. 18, 24, 30, 36, 42, 48 i 54.-->
	<xsd:complexType name="TNaglowek_PIT_WZR">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zwzr:TKodFormularza_PIT_WZR">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PITWZR (2)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="2-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="2"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_PIT_WZR">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/WZR"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TNrId">
		<xsd:annotation>
			<xsd:documentation>Typ identyfikatora podatkowego: NIP lub numer PESEL</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[1-9]((\d[1-9])|([1-9]\d))\d{7}"/>
			<xsd:pattern value="\d{11}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_WZR">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WIERZYTELNOŚCIACH I ZOBOWIĄZANIACH ZMNIEJSZAJĄCYCH LUB ZWIĘKSZAJĄCYCH PRZYCHODY, WYNIKAJĄCYCH Z TRANSAKCJI HANDLOWYCH za rok podatkowy</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zwzr:TNaglowek_PIT_WZR"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dotyczące dłużnika i wierzytelności wynikającej z transakcji handlowej zawartej w ramach działalności gospodarczej, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania wynikającego z transakcji handlowej zawartej w ramach działalności gospodarczej, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane, dane dotyczące dłużnika i wierzytelności wynikającej z transakcji handlowej zawartej w ramach działalności gospodarczej, jeżeli wierzytelność została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania wynikającego z transakcji handlowej zawartej w ramach działalności gospodarczej, jeżeli zobowiązanie zostało uregulowane, dane dotyczące dłużnika i wierzytelności wynikającej z transakcji handlowej zawartej w ramach działalności polegającej na sprzedaży przetworzonych produktów roślinnych i zwierzęcych, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania wynikającego z transakcji handlowej zawartej w ramach działalności polegającej na sprzedaży przetworzonych produktów roślinnych i zwierzęcych, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane, dane dotyczące dłużnika i wierzytelności wynikającej z transakcji handlowej zawartej w ramach działalności polegającej na sprzedaży przetworzonych produktów roślinnych i zwierzęcych, jeżeli wierzytelność została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania wynikającego z transakcji handlowej zawartej w ramach działalności polegającej na sprzedaży przetworzonych produktów roślinnych i zwierzęcych, jeżeli zobowiązanie zostało uregulowane</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_B" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące dłużnika i wierzytelności wynikającej z transakcji handlowej zawartej w ramach działalności gospodarczej, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta (dotyczy wierzytelności zmniejszających przychody - wypełnia podatnik będący wierzycielem)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_B7" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B8" type="zwzr:TNrId" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP / numer PESEL dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B9" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B10" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury / rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B11" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności w części, w jakiej nie została uregulowana lub zbyta</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_12" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 11</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_C" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące wierzyciela i zobowiązania wynikającego z transakcji handlowej zawartej w ramach działalności gospodarczej, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane (dotyczy zobowiązań zwiększających przychody - wypełnia podatnik będący dłużnikiem)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_C13" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C14" type="zwzr:TNrId" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP / numer PESEL wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C15" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C16" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury / rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C17" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania w części, w jakiej nie zostało uregulowane</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_18" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 17</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_D" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące dłużnika i wierzytelności wynikającej z transakcji handlowej zawartej w ramach działalności gospodarczej, jeżeli wierzytelność została uregulowana lub zbyta (dotyczy wierzytelności, które w poprzednich latach zmniejszyły przychody)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D19" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D20" type="zwzr:TNrId" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP / numer PESEL dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D21" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D22" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury / rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D23" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności w części, w jakiej została uregulowana lub zbyta w roku podatkowym</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_24" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 23</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_E" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące wierzyciela i zobowiązania wynikającego z transakcji handlowej zawartej w ramach działalności gospodarczej, jeżeli zobowiązanie zostało uregulowane (dotyczy zobowiązań, które w poprzednich latach zwiększyły przychody)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_E25" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E26" type="zwzr:TNrId" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP / numer PESEL wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E27" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E28" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury / rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E29" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania w części, w jakiej zostało uregulowane w roku podatkowym</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 29</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_F" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące dłużnika i wierzytelności wynikającej z transakcji handlowej zawartej w ramach działalności polegającej na sprzedaży przetworzonych produktów roślinnych i zwierzęcych, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta (dotyczy wierzytelności zmniejszających przychody - wypełnia podatnik będący wierzycielem)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_F31" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F32" type="zwzr:TNrId" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP / numer PESEL dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F33" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F34" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury / rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_F35" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności w części, w jakiej nie została uregulowana lub zbyta</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_36" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 35</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_G" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące wierzyciela i zobowiązania wynikającego z transakcji handlowej zawartej w ramach działalności polegającej na sprzedaży przetworzonych produktów roślinnych i zwierzęcych, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane (dotyczy zobowiązań zwiększających przychody - wypełnia podatnik będący dłużnikiem)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_G37" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_G38" type="zwzr:TNrId" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP / numer PESEL wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_G39" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_G40" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury / rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_G41" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania w części, w jakiej nie zostało uregulowane</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_42" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 41</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_H" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące dłużnika i wierzytelności wynikającej z transakcji handlowej zawartej w ramach działalności polegającej na sprzedaży przetworzonych produktów roślinnych i zwierzęcych, jeżeli wierzytelność została uregulowana lub zbyta (dotyczy wierzytelności, które w poprzednich latach zmniejszyły przychody)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_H43" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_H44" type="zwzr:TNrId" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP / numer PESEL dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_H45" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_H46" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury / rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_H47" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności w części, w jakiej została uregulowana lub zbyta w roku podatkowym</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_48" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
