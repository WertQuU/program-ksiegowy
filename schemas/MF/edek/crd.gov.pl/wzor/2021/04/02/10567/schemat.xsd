																<xsd:sequence>
																	<xsd:element name="Udzial" type="tns:TUdzial">
																		<xsd:annotation>
																			<xsd:documentation>Udział</xsd:documentation>
																		</xsd:annotation>
																	</xsd:element>
																	<xsd:element name="ProcentUdzial" type="tns:TProcentowy2">
																		<xsd:annotation>
																			<xsd:documentation>Procentowy udział</xsd:documentation>
																		</xsd:annotation>
																	</xsd:element>
																</xsd:sequence>
															</xsd:complexType>
														</xsd:element>
														<xsd:element name="Wklad">
															<xsd:annotation>
																<xsd:documentation>Wartosć wkładu</xsd:documentation>
															</xsd:annotation>
															<xsd:complexType>
																<xsd:simpleContent>
																	<xsd:extension base="etd:TKwotaCNieujemna">
																		<xsd:attribute name="kodWaluty" type="kck:currCode_Type" use="required" fixed="PLN"/>
																	</xsd:extension>
																</xsd:simpleContent>
															</xsd:complexType>
														</xsd:element>
														<xsd:element name="WkladOgolny">
															<xsd:annotation>
																<xsd:documentation>Wartość wkładów ogółem</xsd:documentation>
															</xsd:annotation>
															<xsd:complexType>
																<xsd:simpleContent>
																	<xsd:extension base="etd:TKwotaCNieujemna">
																		<xsd:attribute name="kodWaluty" type="kck:currCode_Type" use="required" fixed="PLN"/>
																	</xsd:extension>
																</xsd:simpleContent>
															</xsd:complexType>
														</xsd:element>
													</xsd:sequence>
												</xsd:choice>
												<xsd:element name="WartoscA">
													<xsd:annotation>
														<xsd:documentation>Wartość transakcji</xsd:documentation>
													</xsd:annotation>
													<xsd:complexType>
														<xsd:simpleContent>
															<xsd:extension base="etd:TKwotaCNieujemna">
																<xsd:attribute name="kodWaluty" type="kck:currCode_Type" use="required" fixed="PLN"/>
															</xsd:extension>
														</xsd:simpleContent>
													</xsd:complexType>
												</xsd:element>
												<xsd:element name="PrzedmiotA" type="tns:TZnakowy" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Przedmiot transakcji kontrolowanej</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:choice>
													<xsd:sequence>
														<xsd:element name="KorektaCT1">
															<xsd:annotation>
																<xsd:documentation>Korekta cen transferowych</xsd:documentation>
															</xsd:annotation>
															<xsd:simpleType>
																<xsd:restriction base="tns:TKorektaCen">
																	<xsd:enumeration value="KC01"/>
																</xsd:restriction>
															</xsd:simpleType>
														</xsd:element>
														<xsd:element name="WartKorektyCT1">
															<xsd:annotation>
																<xsd:documentation>Wartość korekty cen transferowych</xsd:documentation>
															</xsd:annotation>
															<xsd:complexType>
																<xsd:simpleContent>
																	<xsd:extension base="etd:TKwotaC">
																		<xsd:attribute name="kodWaluty" type="kck:currCode_Type" use="required" fixed="PLN"/>
																	</xsd:extension>
																</xsd:simpleContent>
															</xsd:complexType>
														</xsd:element>
													</xsd:sequence>
													<xsd:element name="BrakKorektyCT1">
														<xsd:annotation>
															<xsd:documentation>Brak korekty cen transferowych</xsd:documentation>
														</xsd:annotation>
														<xsd:simpleType>
															<xsd:restriction base="tns:TKorektaCen">
																<xsd:enumeration value="KC02"/>
															</xsd:restriction>
														</xsd:simpleType>
													</xsd:element>
												</xsd:choice>
												<xsd:choice>
													<xsd:sequence>
														<xsd:element name="TZwolniona" type="tns:TKodZwolnienia" fixed="ZW01">
															<xsd:annotation>
																<xsd:documentation>Transakcja zwolniona na podst. art. 11 n pkt 1 ustawy? ZW01 - tak</xsd:documentation>
															</xsd:annotation>
														</xsd:element>
														<xsd:element name="KrajPL" type="etd:TKodKraju" fixed="PL">
															<xsd:annotation>
																<xsd:documentation>Kraj - POLSKA</xsd:documentation>
															</xsd:annotation>
														</xsd:element>
													</xsd:sequence>
													<xsd:sequence>
														<xsd:sequence>
															<xsd:element name="TNieZwolniona" type="tns:TKodZwolnienia" fixed="ZW02">
																<xsd:annotation>
																	<xsd:documentation>Transakcja jest zwolniona na podst. art. 11 n pkt 1 ustawy? ZW02 - nie</xsd:documentation>
																</xsd:annotation>
															</xsd:element>
															<xsd:element name="Kraj" type="etd:TKodKrajuWydania" maxOccurs="unbounded">
																<xsd:annotation>
																	<xsd:documentation>Kraj</xsd:documentation>
																</xsd:annotation>
															</xsd:element>
															<xsd:element name="Kompensata" type="tns:TKompensaty">
																<xsd:annotation>
																	<xsd:documentation>Kompensata</xsd:documentation>
																</xsd:annotation>
															</xsd:element>
														</xsd:sequence>
														<xsd:choice>
															<xsd:sequence>
																<xsd:annotation>
																	<xsd:documentation>MW01</xsd:documentation>
																</xsd:annotation>
																<xsd:element name="Metoda01">
																	<xsd:annotation>
																		<xsd:documentation>Metoda weryfikacji ceny (MW01)</xsd:documentation>
																	</xsd:annotation>
																	<xsd:simpleType>
																		<xsd:restriction base="tns:TMetodyWeryfikacjiCeny">
																			<xsd:enumeration value="MW01"/>
																		</xsd:restriction>
																	</xsd:simpleType>
																</xsd:element>
																<xsd:element name="Weryfikacja" type="tns:TSposobWeryfikacji">
																	<xsd:annotation>
																		<xsd:documentation>Sposób weryfikacji rynkowego poziomu ceny</xsd:documentation>
																	</xsd:annotation>
																</xsd:element>
																<xsd:element name="KorektyPorWyn" type="tns:TKorektaPorownywalnosci">
																	<xsd:annotation>
																		<xsd:documentation>Korekty porównywalności wyników</xsd:documentation>
																	</xsd:annotation>
																</xsd:element>
																<xsd:choice>
																	<xsd:sequence>
																		<xsd:element name="SposobUjCeny1" type="tns:TSposobUjCeny" fixed="CK01">
																			<xsd:annotation>
																				<xsd:documentation>Sposób ujęcia ceny - CK01 cena wyrażona kwotowo</xsd:documentation>
																			</xsd:annotation>
																		</xsd:element>
																		<xsd:element name="CenaMin">
																			<xsd:annotation>
																				<xsd:documentation>Cena min</xsd:documentation>
																			</xsd:annotation>
																			<xsd:complexType>
																				<xsd:simpleContent>
																					<xsd:extension base="etd:TKwota2Nieujemna">
																						<xsd:attribute name="kodWaluty" type="kck:currCode_Type" use="required"/>
																					</xsd:extension>
																				</xsd:simpleContent>
																			</xsd:complexType>
																		</xsd:element>
																		<xsd:element name="CenaMax">
																			<xsd:annotation>
																				<xsd:documentation>Cena max</xsd:documentation>
																			</xsd:annotation>
																			<xsd:complexType>
																				<xsd:simpleContent>
																					<xsd:extension base="etd:TKwota2Nieujemna">
																						<xsd:attribute name="kodWaluty" type="kck:currCode_Type" use="required"/>
																					</xsd:extension>
																				</xsd:simpleContent>
																			</xsd:complexType>
																		</xsd:element>
																		<xsd:element name="Miara" type="etd:TTekstowy">
																			<xsd:annotation>
																				<xsd:documentation>Rodzaj jednostki miary</xsd:documentation>
																			</xsd:annotation>
																		</xsd:element>
																		<xsd:choice>
																			<xsd:sequence>
																				<xsd:element name="RodzajPrzedz1">
																					<xsd:annotation>
																						<xsd:documentation>Rodzaj przedziału</xsd:documentation>
																					</xsd:annotation>
																					<xsd:simpleType>
																						<xsd:restriction base="tns:TRodzajPrzedzialu">
																							<xsd:enumeration value="RP01"/>
																							<xsd:enumeration value="RP02"/>
																							<xsd:enumeration value="RP03"/>
																						</xsd:restriction>
																					</xsd:simpleType>
																				</xsd:element>
																				<xsd:element name="CenaPorMin1">
																					<xsd:annotation>
																						<xsd:documentation>Cena porównywalna min</xsd:documentation>
																					</xsd:annotation>
																					<!--„Cena porównywalna min” powinna być wyrażona w tej samej walucie co „Cena porównywalna max”.-->
																					<xsd:complexType>
