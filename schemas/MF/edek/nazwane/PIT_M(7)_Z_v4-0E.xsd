<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:zm="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITM/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITM/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/StrukturyDanych_v7-0E.xsd"/>
	<xsd:complexType name="TNaglowek_PIT_M">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zm:TKodFormularza_PIT_M">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT/M (7)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="4-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="7"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_PIT_M">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/M"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_M">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O DOCHODACH MAŁOLETNICH DZIECI, PODLEGAJĄCYCH ŁĄCZNEMU OPODATKOWANIU Z DOCHODAMI RODZICÓW W ROKU PODATKOWYM</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zm:TNaglowek_PIT_M"/>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TIdentyfikatorOsobyFizycznej1"/>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dochody małoletnich dzieci, podlegające łącznemu opodatkowaniu z dochodami rodziców, lub straty ze źródeł przychodów</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence>
								<xsd:sequence minOccurs="0">
									<!--Wypełnia się, jeżeli prawo pobierania pożytków z dochodu dziecka (dzieci) przysługuje tylko jednemu z rodziców-->
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>1. Renty krajowe i zagraniczne</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_6" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_7" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_8" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>2. Najem lub dzierżawa</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_9" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_10" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_11" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_12" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Strata</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_13" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>3. Prawa majątkowe</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_14" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_15" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_16" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_17" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Strata</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_18" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>4. Inne źródła, niewymienione w wierszach od 1 do 3</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_19" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_20" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_21" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_22" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Strata</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_23" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence>
										<xsd:annotation>
											<xsd:documentation>5. Razem</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_24" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_25" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_26" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_27" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
								</xsd:sequence>
								<xsd:sequence minOccurs="0">
									<!--Wypełnia się, jeżeli prawo pobierania pożytków z dochodu dziecka (dzieci) przysługuje obojgu rodzicom-->
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>1. Renty krajowe i zagraniczne</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_28" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_29" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_30" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>2. Najem lub dzierżawa</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_31" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_32" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_33" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_34" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Strata</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_35" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>3. Prawa majątkowe</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_36" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_37" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_38" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_39" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Strata</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_40" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>4. Inne źródła, niewymienione w wierszach od 1 do 3</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_41" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_42" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_43" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_44" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Strata</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_45" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:sequence>
										<xsd:annotation>
											<xsd:documentation>5. Razem</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_46" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Przychód</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_47" type="etd:TKwota2Nieujemna" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:sequence>
											<!--W poz. 50 należy wpisać połowę kwoty z poz. 48.-->
											<xsd:element name="P_48" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Dochód</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_50" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Dochód - połowa kwoty z poz. 48</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<!--W poz. 51 należy wpisać połowę kwoty z poz. 49.-->
											<xsd:element name="P_49" type="etd:TKwotaCNieujemna">
												<xsd:annotation>
													<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_51" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Należna zaliczka, w tym zaliczka pobrana przez płatnika - połowa kwoty z poz. 49</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
									</xsd:sequence>
								</xsd:sequence>
							</xsd:sequence>
							<xsd:element name="P_52" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Kwota dochodu (małoletnich dzieci podlegającego łącznemu opodatkowaniu)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_53" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Kwota zaliczki (należna zaliczka od dochodu małoletnich dzieci podlegającego łącznemu opodatkowaniu)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
