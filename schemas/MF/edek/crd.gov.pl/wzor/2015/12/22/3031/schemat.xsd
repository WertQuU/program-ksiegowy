				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>2. Zaliczki na podatek obliczone przez płatników, o których mowa w art. 33-35 ustawy, od dochodów wymienionych w tych przepisach</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_33" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Należne zaliczki za m-c I</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_34" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Należne zaliczki za m-c II</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_35" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Należne zaliczki za m-c III</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_36" type="etd:TKwotaCNieujemna" minOccurs="0">
