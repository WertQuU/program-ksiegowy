<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:PelnaKsiegowosc.Presentation.ViewModels.Sections"
             xmlns:vm="using:PelnaKsiegowosc.Presentation.ViewModels"
             xmlns:c="using:PelnaKsiegowosc.App.Controls"
             x:Class="PelnaKsiegowosc.App.Views.CitView"
             x:DataType="s:CitViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="h1" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding Applicability}" Classes="info" />
    <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
      <TextBlock Text="Narastająco do okresu nr:" /><TextBox Text="{Binding UptoPeriod}" MinWidth="60" />
      <Button Content="Przelicz" Command="{Binding RecalculateCommand}" />
      <Button Content="Zapisz wyliczenie zaliczki" Command="{Binding ComputeAdvanceCommand}" IsEnabled="{Binding IsApplicable}" />
      <Button Content="Zatwierdź zaznaczoną zaliczkę" Command="{Binding ApproveAdvanceCommand}" IsEnabled="{Binding IsApplicable}" />
      <Button Content="JPK CIT (księgi ze znacznikami)…" Command="{Binding JpkCitCommand}" IsEnabled="{Binding IsApplicable}" />
      <Button Content="Podatek odroczony…" Command="{Binding DeferredTaxCommand}" IsEnabled="{Binding IsApplicable}" />
    </WrapPanel>
    <Expander DockPanel.Dock="Top" Header="Warunki stawki 9% (limit 2 mln euro, wyłączenia)" Margin="0,0,0,4">
      <WrapPanel Classes="toolbar">
        <TextBlock Text="{Binding RateLabels}" TextWrapping="Wrap" MaxWidth="900" />
        <TextBlock Text="Kurs EUR — limit 9%:" />
        <TextBox Text="{Binding EurRate}" Watermark="np. 4,2156" MinWidth="90" />
        <TextBlock Text="Kurs EUR — mały podatnik:" />
        <TextBox Text="{Binding StatusEurRate}" Watermark="np. 4,2586" MinWidth="90" />
        <Button Content="Potwierdź sprzedaż poprzedniego roku…" Command="{Binding ConfirmPreviousSalesCommand}" />
        <Button Content="Pobierz kursy z NBP" Command="{Binding FetchNbpRatesCommand}" IsEnabled="{Binding IsApplicable}" />
        <CheckBox Content="Spółka powstała z przekształcenia / połączenia / podziału / wniesienia przedsiębiorstwa (art. 19 ust. 1b–1c) — 9% wyłączone" IsChecked="{Binding ReducedRateExcluded}" />
        <TextBlock Text="Prognoza stawki na rok odwrócenia różnic (podatek odroczony, art. 37 ust. 6 UoR):" />
        <TextBox Text="{Binding ExpectedRateYearStart}" Watermark="rok od (dd.mm.rrrr; puste — następny)" MinWidth="120" />
        <TextBox Text="{Binding ExpectedRate}" Watermark="9 albo 19" MinWidth="60" />
        <TextBox Text="{Binding ExpectedRateJustification}" Watermark="uzasadnienie prognozy" MinWidth="220" />
        <Button Content="Zapisz prognozę" Command="{Binding SaveExpectedRateCommand}" IsEnabled="{Binding IsApplicable}" />
        <TextBlock Text="Lata podatkowe 12-miesięczne potwierdzone do:" />
        <TextBox Text="{Binding CalendarConfirmedThrough}" Watermark="dd.mm.rrrr" MinWidth="100" />
        <TextBox Text="{Binding CalendarJustification}" Watermark="podstawa (brak planowanej zmiany roku podatkowego)" MinWidth="220" />
        <Button Content="Potwierdź kalendarz" Command="{Binding ConfirmTaxCalendarCommand}" IsEnabled="{Binding IsApplicable}" />
        <TextBlock Text="Próg istotności niezatwierdzonych prognoz (zł):" />
        <TextBox Text="{Binding DeferredMateriality}" Watermark="0" MinWidth="80" />
        <TextBox Text="{Binding DeferredMaterialityJustification}" Watermark="podstawa (polityka rachunkowości)" MinWidth="200" />
        <Button Content="Zapisz próg" Command="{Binding SaveDeferredMaterialityCommand}" IsEnabled="{Binding IsApplicable}" />
        <TextBlock Text="Rok odwrócenia różnicy ŚT spoza planu amortyzacji:" />
        <TextBox Text="{Binding ReversalAssetNumber}" Watermark="nr inwentarzowy" MinWidth="100" />
        <TextBox Text="{Binding ReversalYearStart}" Watermark="rok podatkowy od (dd.mm.rrrr)" MinWidth="120" />
        <TextBox Text="{Binding ReversalJustification}" Watermark="podstawa (np. planowana sprzedaż)" MinWidth="200" />
        <Button Content="Zapisz rok odwrócenia" Command="{Binding SaveReversalYearCommand}" IsEnabled="{Binding IsApplicable}" />
        <CheckBox Content="Podatkowa grupa kapitałowa lub przychody ponad 50 mln euro (JPK_CIT od 2025 r.)" IsChecked="{Binding JpkCit2025}" />
        <Button Content="Zapisz" Command="{Binding SaveRateConditionsCommand}" IsEnabled="{Binding IsApplicable}" />
      </WrapPanel>
    </Expander>
    <Expander DockPanel.Dock="Top" Header="Korekta wyniku podatkowego" Margin="0,0,0,8">
      <WrapPanel Classes="toolbar">
        <ComboBox ItemsSource="{Binding AdjustmentTypes}" SelectedItem="{Binding AdjustmentType}" MinWidth="220" />
        <TextBox Text="{Binding AdjustmentPeriod}" Watermark="od okresu nr" MinWidth="80" />
        <TextBox Text="{Binding AdjustmentAmount}" Watermark="kwota" />
        <TextBox Text="{Binding AdjustmentDescription}" Watermark="opis" MinWidth="240" />
        <TextBox Text="{Binding AdjustmentBasis}" Watermark="podstawa prawna" MinWidth="180" />
        <ComboBox ItemsSource="{Binding DifferenceKinds}" SelectedItem="{Binding AdjustmentDifference}" MinWidth="170" ToolTip.Tip="Wymagane dla kosztu NKUP i zmniejszenia przychodów — decyduje o polach RPD (K_1/K_2, K_4/K_5)" />
        <CheckBox Content="ujęte w księgach lat ubiegłych" IsChecked="{Binding AdjustmentPriorYears}" ToolTip.Tip="Przychód / KUP bieżącego roku ujęty w księgach lat ubiegłych — RPD K_3 / K_6" />
        <CheckBox Content="Art. 18f — powiąż z zaznaczonym zobowiązaniem" IsChecked="{Binding LinkAdjustmentToLiability}" />
        <CheckBox Content="Koszt zysków kapitałowych" IsChecked="{Binding AdjustmentCapitalGains}" />
        <Button Content="Dodaj korektę" Command="{Binding AddAdjustmentCommand}" />
      </WrapPanel>
    </Expander>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Warnings}" Classes="info" Foreground="#8a5300" />
    <TabControl>
      <TabItem Header="Uzgodnienie wyniku"><c:TableView Table="{Binding Reconciliation}" /></TabItem>
      <TabItem Header="Kwalifikacja art. 18f"><DockPanel>
        <Button DockPanel.Dock="Top" Content="Kwalifikuj zaznaczone zobowiązanie…" Command="{Binding QualifyLiabilityCommand}" />
        <c:TableView Table="{Binding Liabilities}" SelectedRow="{Binding SelectedLiability}" />
      </DockPanel></TabItem>
      <TabItem Header="Korekty ręczne"><DockPanel>
        <WrapPanel DockPanel.Dock="Top">
          <Button Content="Powiąż ze zobowiązaniem wybranym w art. 18f" Command="{Binding LinkManualLiabilityCommand}" />
          <Button Content="Usuń korektę…" Command="{Binding RemoveManualAdjustmentCommand}" />
        </WrapPanel>
        <c:TableView Table="{Binding ManualAdjustments}" SelectedRow="{Binding SelectedManualAdjustment}" />
      </DockPanel></TabItem>
      <TabItem Header="Zaliczki"><c:TableView Table="{Binding Advances}" SelectedRow="{Binding SelectedAdvance}" /></TabItem>
      <TabItem Header="Straty z lat ubiegłych">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="info" TextWrapping="Wrap"
                     Text="Art. 7 ust. 5 ustawy o CIT: stratę odlicza się w 5 kolejnych latach — w roku do 50% straty albo jednorazowo do 5 mln zł; straty ze źródła „zyski kapitałowe” tylko od dochodu z tego źródła." />
          <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
            <TextBox Text="{Binding LossYear}" Watermark="rok straty (np. 2025)" MinWidth="120" />
            <TextBox Text="{Binding LossYearEnd}" Watermark="koniec roku dd.mm.rrrr" MinWidth="140" />
            <CheckBox Content="zyski kapitałowe" IsChecked="{Binding LossCapital}" />
            <TextBox Text="{Binding LossAmount}" Watermark="kwota straty" />
            <TextBox Text="{Binding LossUntil}" Watermark="odliczenie do (koniec 5. roku podatk.)" MinWidth="210" ToolTip.Tip="Wymagane, gdy lat podatkowych po stracie nie ma w programie — ostatni dzień 5. roku podatkowego po roku straty" />
            <Button Content="Zarejestruj stratę" Command="{Binding AddLossCommand}" IsEnabled="{Binding IsApplicable}" />
            <Button Content="Przenieś stratę z poprzedniego roku (z programu)" Command="{Binding RegisterPreviousYearLossCommand}" IsEnabled="{Binding IsApplicable}" />
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
            <TextBox Text="{Binding LossDeduction}" Watermark="kwota odliczenia w bieżącym roku" MinWidth="200" />
            <TextBox Text="{Binding LossFromPeriod}" Watermark="od okresu nr" MinWidth="90" />
            <CheckBox Content="jednorazowo (do 5 mln zł)" IsChecked="{Binding LossOneTime}" />
            <Button Content="Odlicz zaznaczoną stratę" Command="{Binding DeductLossCommand}" IsEnabled="{Binding IsApplicable}" />
            <Button Content="Potwierdź okres odliczenia zaznaczonej" Command="{Binding ConfirmLossWindowCommand}" IsEnabled="{Binding IsApplicable}" />
            <Button Content="Oceń wykorzystanie (podatek odroczony)…" Command="{Binding AssessLossCommand}" IsEnabled="{Binding IsApplicable}" />
          </WrapPanel>
          <c:TableView Table="{Binding Losses}" SelectedRow="{Binding SelectedLoss}" />
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
