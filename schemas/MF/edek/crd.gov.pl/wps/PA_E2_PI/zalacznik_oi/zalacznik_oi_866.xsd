									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_41" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 3. Ulga na dzieci</xsd:documentation>
									</xsd:annotation>
