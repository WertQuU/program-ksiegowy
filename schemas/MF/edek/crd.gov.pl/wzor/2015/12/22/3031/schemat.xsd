						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_50" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Suma należnych zaliczek za m-c VI</xsd:documentation>
						</xsd:annotation>
