<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:PelnaKsiegowosc.Presentation.ViewModels.Sections"
             xmlns:v="using:PelnaKsiegowosc.App.Views"
             x:Class="PelnaKsiegowosc.App.App"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <DataTemplate DataType="s:DashboardViewModel"><v:DashboardView /></DataTemplate>
    <DataTemplate DataType="s:CompanyViewModel"><v:CompanyView /></DataTemplate>
    <DataTemplate DataType="s:DocumentsViewModel"><v:DocumentsView /></DataTemplate>
    <DataTemplate DataType="s:SalesViewModel"><v:SalesView /></DataTemplate>
    <DataTemplate DataType="s:PurchasesViewModel"><v:PurchasesView /></DataTemplate>
    <DataTemplate DataType="s:LedgerViewModel"><v:LedgerView /></DataTemplate>
    <DataTemplate DataType="s:ChartViewModel"><v:ChartView /></DataTemplate>
    <DataTemplate DataType="s:CounterpartiesViewModel"><v:CounterpartiesView /></DataTemplate>
    <DataTemplate DataType="s:BankViewModel"><v:BankView /></DataTemplate>
    <DataTemplate DataType="s:VatViewModel"><v:VatView /></DataTemplate>
    <DataTemplate DataType="s:CitViewModel"><v:CitView /></DataTemplate>
    <DataTemplate DataType="s:FixedAssetsViewModel"><v:FixedAssetsView /></DataTemplate>
    <DataTemplate DataType="s:CapitalViewModel"><v:CapitalView /></DataTemplate>
    <DataTemplate DataType="s:ReportsViewModel"><v:ReportsView /></DataTemplate>
    <DataTemplate DataType="s:ClosingViewModel"><v:ClosingView /></DataTemplate>
    <DataTemplate DataType="s:ArchiveViewModel"><v:ArchiveView /></DataTemplate>
    <DataTemplate DataType="s:BackupsViewModel"><v:BackupsView /></DataTemplate>
    <DataTemplate DataType="s:IntegrationsViewModel"><v:IntegrationsView /></DataTemplate>
    <DataTemplate DataType="s:SettingsViewModel"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="s:HelpViewModel"><v:HelpView /></DataTemplate>
    <DataTemplate DataType="s:RegulationsViewModel"><v:RegulationsView /></DataTemplate>
    <DataTemplate DataType="s:PayrollViewModel"><v:PayrollView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PkWindowBg" Color="#E9EDF2" />
          <SolidColorBrush x:Key="PkCardBg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PkHeaderBg" Color="#0E2A4D" />
          <SolidColorBrush x:Key="PkHeaderSub" Color="#A9BCD6" />
          <SolidColorBrush x:Key="PkSidebarBg" Color="#152235" />
          <SolidColorBrush x:Key="PkSidebarFg" Color="#D5DEEA" />
          <SolidColorBrush x:Key="PkSidebarHeader" Color="#6F86A3" />
          <SolidColorBrush x:Key="PkSidebarHover" Color="#22344D" />
          <SolidColorBrush x:Key="PkSidebarSelected" Color="#1A4F8F" />
          <SolidColorBrush x:Key="PkText" Color="#17202B" />
          <SolidColorBrush x:Key="PkMuted" Color="#55657A" />
          <SolidColorBrush x:Key="PkBorder" Color="#D3DAE3" />
          <SolidColorBrush x:Key="PkIssueBg" Color="#F6F8FB" />
          <SolidColorBrush x:Key="PkGuideBg" Color="#DCE6F2" />
          <SolidColorBrush x:Key="PkGuideFg" Color="#14304F" />
          <SolidColorBrush x:Key="PkFooterBg" Color="#F7F9FB" />
          <SolidColorBrush x:Key="PkStatus" Color="#1A4F8F" />
          <SolidColorBrush x:Key="PkWarnBg" Color="#FFF1C9" />
          <SolidColorBrush x:Key="PkWarnFg" Color="#5E4300" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PkWindowBg" Color="#0F141B" />
          <SolidColorBrush x:Key="PkCardBg" Color="#1A212B" />
          <SolidColorBrush x:Key="PkHeaderBg" Color="#0A1A2E" />
          <SolidColorBrush x:Key="PkHeaderSub" Color="#8EA3C0" />
          <SolidColorBrush x:Key="PkSidebarBg" Color="#111821" />
          <SolidColorBrush x:Key="PkSidebarFg" Color="#C9D3E0" />
          <SolidColorBrush x:Key="PkSidebarHeader" Color="#5E7391" />
          <SolidColorBrush x:Key="PkSidebarHover" Color="#1C2633" />
          <SolidColorBrush x:Key="PkSidebarSelected" Color="#24548F" />
          <SolidColorBrush x:Key="PkText" Color="#E6EBF2" />
          <SolidColorBrush x:Key="PkMuted" Color="#93A2B5" />
          <SolidColorBrush x:Key="PkBorder" Color="#2C3644" />
          <SolidColorBrush x:Key="PkIssueBg" Color="#212A36" />
          <SolidColorBrush x:Key="PkGuideBg" Color="#1B2A3D" />
          <SolidColorBrush x:Key="PkGuideFg" Color="#C7D6EA" />
          <SolidColorBrush x:Key="PkFooterBg" Color="#141A22" />
          <SolidColorBrush x:Key="PkStatus" Color="#8CB8F2" />
          <SolidColorBrush x:Key="PkWarnBg" Color="#3A3014" />
          <SolidColorBrush x:Key="PkWarnFg" Color="#F2D78A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#1A4F8F" RegionColor="#FFFFFF" ErrorText="#B71C1C" />
        <ColorPaletteResources x:Key="Dark" Accent="#3D7BC8" RegionColor="#1A212B" ErrorText="#EF5350" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style Selector="TextBlock.info">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource PkMuted}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="WrapPanel.toolbar > Button">
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="WrapPanel.toolbar > CheckBox">
      <Setter Property="Margin" Value="6,0,6,6" />
    </Style>
    <Style Selector="WrapPanel.toolbar > TextBox">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="MinWidth" Value="140" />
    </Style>
    <Style Selector="WrapPanel.toolbar > ComboBox">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="WrapPanel.toolbar > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,6,6" />
    </Style>
    <Style Selector="Grid.form > TextBox">
      <Setter Property="Margin" Value="0,2,12,2" />
    </Style>
    <Style Selector="Grid.form > ComboBox">
      <Setter Property="Margin" Value="0,2,12,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Grid.form > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2,8,2" />
    </Style>
    <Style Selector="Grid.form > CheckBox">
      <Setter Property="Margin" Value="0,2,12,2" />
    </Style>
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource PkWindowBg}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PkCardBg}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #22000000" />
    </Style>
    <Style Selector="TextBlock.cardcaption">
      <Setter Property="Foreground" Value="{DynamicResource PkMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.cardvalue">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource PkText}" />
    </Style>
    <Style Selector="TextBlock.cardnote">
      <Setter Property="Foreground" Value="{DynamicResource PkMuted}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Border.issue">
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="Background" Value="{DynamicResource PkIssueBg}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.deadline">
      <Setter Property="BorderBrush" Value="{DynamicResource PkBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="WrapPanel.quick > Button">
      <Setter Property="MinWidth" Value="190" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.accent TextBlock.cardnote">
      <Setter Property="Foreground" Value="#DCE8F7" />
    </Style>
    <Style Selector="TextBlock.menuheader">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource PkSidebarHeader}" />
      <Setter Property="Margin" Value="10,12,0,2" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="BorderBrush" Value="{DynamicResource PkBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Background" Value="{DynamicResource PkCardBg}" />
    </Style>
    <Style Selector="Border.sidebar ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource PkSidebarFg}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PkSidebarHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PkSidebarSelected}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.sidebar ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PkSidebarSelected}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="Foreground" Value="{DynamicResource PkText}" />
    </Style>
  </Application.Styles>
</Application>
