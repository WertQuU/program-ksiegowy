<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czbr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/08/31/eD/CITBR/" xmlns:czd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/CITD/" xmlns:czmt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SPRMT/" xmlns:czst="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/01/10/eD/CITSTZ/" xmlns:cztp="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/08/31/eD/CITTP/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" xmlns:tns="http://crd.gov.pl/wzor/2017/09/12/4400/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/" targetNamespace="http://crd.gov.pl/wzor/2017/09/12/4400/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/01/10/eD/CITSTZ/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/01/10/eD/CITSTZ/CIT-ST(7)_Z_v4-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/CITD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/CITD/CIT-D(5)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SPRMT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SPRMT/SPR_MT(1)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/08/31/eD/CITBR/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/08/31/eD/CITBR/CIT_BR(3)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/08/31/eD/CITTP/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/08/31/eD/CITTP/CIT_TP(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/ORD-ZU(3)_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/StrukturyDanych_v4-0E.xsd"/>
	<!--Zeznanie to przeznaczone jest, stosownie do art. 3 ustawy z dnia 21 listopada 1996 r. o zmianie ustawy o podatku dochodowym od osób prawnych (Dz. U. poz. 639), wyłącznie dla podatkowych grup kapitałowych powstałych na podstawie art. 1a ustawy, w brzmieniu nadanym przez art. 1 pkt 1 ustawy z dnia 13 października 1995 r. o zmianie ustawy o podatku dochodowym od osób prawnych (Dz. U. poz. 704).-->
	<!-- -->
	<!--Ilekroć w zeznaniu jest mowa o urzędzie skarbowym, w tym urzędzie skarbowym do którego adresowane jest zeznanie - oznacza to urząd skarbowy, przy pomocy którego właściwy dla podatnika naczelnik urzędu skarbowego wykonuje swoje zadania.-->
	<!-- -->
	<!--Jeżeli podatnik składa zeznanie:
a) w terminie do 20 dnia pierwszego miesiąca następnego roku podatkowego - w poz. 88 powinien uwzględnić wyłącznie zaliczki wpłacone do końca tego roku podatkowego, za który jest składane zeznanie,
b) w terminie do końca trzeciego miesiąca roku następnego - w poz. 88powinien uwzględnić zaliczki wpłacone do końca roku podatkowego oraz za ostatni miesiąc (kwartał) zaliczkę wpłaconą do 20 dnia pierwszego miesiąca roku następnego.-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT-8A (12)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="12"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_7"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
				<!--Zgodnie z art. 81 ustawy z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2017 r. poz. 201, z późn. zm.).-->
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-8A"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2017-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>ZEZNANIE O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) PRZEZ PODATKOWĄ GRUPĘ KAPITAŁOWĄ - PODATNIKA PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TOsobaNiefizyczna">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Grupa Kapitałowa"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="tns:PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Ustalenie podstawy opodatkowania i należnego podatku, kwoty należnych zaliczek miesięcznych lub zaliczek kwartalnych, różnica pomiędzy podatkiem należnym a należnymi zaliczkami, kwota do zapłaty / nadpłata, inne zobowiązania podatkowe, dane spółki reprezentującej podatkową grupę kapitałową</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Pouczenia">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższych pouczeń:
								Niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz. U. z 2016 r. poz. 599, z późn. zm.) na odsetki od wykazanych i nieuiszczonych w obowiązujących terminach lub uiszczonych w niepełnej wysokości kwot z poz. 62 - 84.
W przypadku niewpłacenia w obowiązujących terminach kwot z poz. 89 i 91 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji.

Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie podatku na uszczuplenie grozi odpowiedzialność przewidziana w Kodeksie karnym skarbowym.
								</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence minOccurs="0">
							<xsd:element ref="czst:Zalacznik_CIT-ST" minOccurs="0"/>
							<xsd:element ref="czd:Zalacznik_CIT-D" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="czmt:Zalacznik_SPR_MT" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="czbr:Zalacznik_CIT_BR" minOccurs="0"/>
							<xsd:element ref="cztp:Zalacznik_CIT_TP" minOccurs="0"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PozycjeSzczegolowe">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="P_19" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT-ST</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_20" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT-D</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_21" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Sprawozdanie o realizacji uznanej metody ustalania ceny transakcyjnej</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:sequence>
					<xsd:element name="P_22" type="etd:TWybor1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Informacja o załącznikach CIT/BR</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_25" type="etd:TWybor1_2">
						<xsd:annotation>
							<xsd:documentation>Podatnik występuje o zwrot niewykorzystanego odliczenia na podstawie art. 18da ustawy. Wybór: 1 - tak, 2 - nie</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_23" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/TP</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_24" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>Oświadczenie o sporządzeniu dokumentacji podatkowej, o której mowa w art. 9a ust. 7 ustawy. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_26" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>Podatnik był obowiązany do sporządzenia dokumentacji podatkowej, o której mowa w art. 9a ust. 1 ustawy. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_27" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>Podatnik był obowiązany do sporządzenia elementu dokumentacji podatkowej, o którym mowa w art. 9a ust. 2d ustawy. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
					<!--Obowiązek sporządzania informacji o grupie podmiotów powiązanych - tzw. masterfile, jako elementu dokumentacji podatkowej.-->
				</xsd:element>
				<xsd:element name="P_28" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>Podatnik był obowiązany do sporządzenia elementu dokumentacji podatkowej, o którym mowa w art. 9a ust. 2b pkt 2 ustawy. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_29" type="etd:TKwotaCNieujemna">
					<xsd:annotation>
						<xsd:documentation>Łączny kapitał zakładowy spółek wchodzących w skład podatkowej grupy kapitałowej na ostatni dzień roku podatkowego</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_30" type="etd:TKwotaCNieujemna">
					<xsd:annotation>
						<xsd:documentation>Suma przychodów wszystkich spółek tworzących podatkową grupę kapitałową - art. 1a ust. 2 pkt 4 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_31" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Suma dochodów spółek wchodzących w skład podatkowej grupy kapitałowej - art. 7a ust. 1 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_32" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Suma strat spółek wchodzących w skład podatkowej grupy kapitałowej - art. 7a ust. 1 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:choice>
					<xsd:element name="P_33" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Dochód - art. 7a ust. 1 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_34" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Strata - art. 7a ust.1 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:choice>
				<xsd:element name="P_35" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia darowizn zgodnie z art. 18 ust. 1 pkt 1 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_36" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia darowizn na cele kultu religijnego, zgodnie z art. 18 ust. 1 pkt 7 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_37" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia darowizn na podstawie odrębnych ustaw</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_38" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Ogółem odliczenia darowizny</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_39" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Inne odliczenia od dochodu - Tytuł</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_40" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Inne odliczenia od dochodu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_41" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Razem odliczenia od dochodu</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_42" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Podstawa opodatkowania - art. 18 ust. 1 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_43" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Wydatki na nabycie nowej technologii</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_44" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia zmniejszające podstawę opodatkowania z tytułu kosztów uzyskania przychodów poniesionych na działalność badawczo-rozwojową</xsd:documentation>
					</xsd:annotation>
					<!--Należy wpisać kwotę z poz. 23 załącznika CIT/BR. -->
				</xsd:element>
				<xsd:element name="P_45" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Razem odliczenia zmniejszające podstawę opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_46" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota odliczonych wydatków - w związku z utratą prawa do odliczeń</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_47" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>z tego kwota zwiększająca podstawę opodatkowania</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_48" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>z tego kwota zmniejszająca stratę</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_49" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwota dochodu osiągniętego poza terytorium RP podlegająca opodatkowaniu łącznie z dochodami osiągniętymi na terytorium RP - art. 20 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_50" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Inne doliczenia do podstawy opodatkowania - Tytuł</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_51" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Inne doliczenia do podstawy opodatkowania</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_52" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Razem kwota zwiększająca podstawę opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_53" type="etd:TKwotaCNieujemna">
					<xsd:annotation>
						<xsd:documentation>Podstawa opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_54" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Strata</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_55">
					<xsd:annotation>
						<xsd:documentation>Stawka podatku - art. 19 ustawy</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TProcentowy">
							<xsd:enumeration value="0"/>
							<xsd:enumeration value="19"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_56" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
