<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:cz8s="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/03/26/eD/CIT8S/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/03/26/eD/CIT8S/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/StrukturyDanych_v5-0E.xsd"/>
	<!--Załącznik do zeznań: CIT-8 i CIT-8AB.-->
	<!-- -->
	<!--Formularz przeznaczony jest dla podatników podatku dochodowego od osób prawnych będących beneficjentami pomocy w rozumieniu przepisów o pomocy publicznej.-->
	<!-- -->
	<!--Zgodnie z art. 1 ustawy podatnikami podatku dochodowego od osób prawnych są:
   - osoby prawne i spółki kapitałowe w organizacji;
   - jednostki organizacyjne niemające osobowości prawnej, z wyjątkiem spółek niemających osobowości prawnej;
   - spółki komandytowo-akcyjne;
   - spółki niemające osobowości prawnej, mające siedzibę lub zarząd w innym państwie, jeżeli zgodnie przepisami prawa podatkowego tego państwa są traktowane jako osoby prawne i podlegają w tym państwie opodatkowaniu od całości swoich dochodów bez względu na miejsce ich osiągania.-->
	<xsd:complexType name="TNaglowek_CIT_8S">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8s:TKodFormularza_CIT_8S">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT/8S (2)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="2"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8s:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8s:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2018-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_8S">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/8S"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_8S">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI DOCHODU OSIĄGNIĘTEGO Z DZIAŁALNOŚCI GOSPODARCZEJ PROWADZONEJ NA TERENIE SPECJALNEJ STREFY EKONOMICZNEJ NA PODSTAWIE ZEZWOLENIA LUB NA TERENIE OKREŚLONYM W DECYZJI O WSPARCIU</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="cz8s:TNaglowek_CIT_8S"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacje dotyczące zezwoleń lub decyzji o wsparciu posiadanych przez podatnika, ustalenie wielkości dochodu podlegającego zwolnieniu z opodatkowania z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie posiadanych zezwoleń lub na terenie określonym w decyzji o wsparciu, informacje dotyczące cofniętego zezwolenia lub uchylonej decyzji o wsparciu, wielkość kosztów kwalifikowanych, rozliczanych w ramach ulgi B+R</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_B" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Informacja dotycząca zezwoleń lub decyzji o wsparciu posiadanych przez podatnika</xsd:documentation>
								</xsd:annotation>
								<!--Należy wskazać wszystkie zezwolenia, na podstawie których przedsiębiorca prowadził działalność gospodarczą na terenie specjalnej strefy ekonomicznej lub na terenie specjalnych stref ekonomicznych, na podstawie zezwolenia niezależnie od okresu obowiązywania tych zezwoleń lub wszystkie decyzje o wsparciu, na podstawie których przedsiębiorca realizuje nową inwestycję na terenach określonych w tych decyzjach o wsparciu.-->
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="P_B8" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Numer zezwolenia lub decyzji o wsparciu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_B9" type="etd:TData">
											<xsd:annotation>
												<xsd:documentation>Data wydania zezwolenia lub decyzji o wsparciu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_B10" type="etd:TData">
											<xsd:annotation>
												<xsd:documentation>Data rozpoczęcia działalności</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:sequence>
											<xsd:element name="P_B11" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Maksymalna wartość pomocy publicznej - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B12" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Maksymalna wartość pomocy publicznej - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<xsd:element name="P_B13" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty kwalifikujące się do objęcia pomocą publiczną - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B14" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty kwalifikujące się do objęcia pomocą publiczną - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<xsd:element name="P_B15" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Pomoc udzielona na podstawie ustawy w ramach zezwolenia lub decyzji o wsparciu z poz. 8 - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B16" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Pomoc udzielona na podstawie ustawy w ramach zezwolenia lub decyzji o wsparciu z poz. 8 - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<!--Należy wskazać wsparcie uzyskane na inwestycję, na którą wydane jest zezwolenie lub decyzja o wsparciu.-->
											<xsd:element name="P_B17" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Inne wsparcie objęte pomocą - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B18" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Inne wsparcie objęte pomocą - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
							<xsd:sequence>
								<xsd:element name="P_C" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Ustalenie wielkości dochodu podlegającego zwolnieniu z opodatkowania z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie posiadanych zezwoleń lub na terenie określonym w decyzji o wsparciu. Informacje dotyczące zezwolenia lub decyzji o wsparciu</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 19 i poz. 20 należy wskazać zezwolenia lub decyzje o wsparciu, w ramach których podatnik korzysta z pomocy publicznej w formie zwolnienia podatkowego w roku podatkowym, za który składane jest zeznanie. W poz. 21 i poz. 22 podatnik wskazuje sumę przychodów i kosztów uzyskania przychodów określoną w zezwoleniach lub decyzjach o wsparciu-->
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_C19" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C20" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wydania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C21" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Przychody z działalności gospodarczej określonej w zezwoleniach lub decyzjach o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C22" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty uzyskania przychodów z działalności gospodarczej określonej w zezwoleniach lub decyzjach o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C23" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Dochód z działalności gospodarczej określonej w zezwoleniach lub decyzjach o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C24" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Strata z działalności gospodarczej określonej w zezwoleniach lub decyzjach o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_25" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Razem kwota dochodu podlegająca zwolnieniu z opodatkowania</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:element name="P_D" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Informacje dotyczące cofniętego zezwolenia lub uchylonej decyzji o wsparciu</xsd:documentation>
									</xsd:annotation>
									<!--Należy wykazać dane, które zgodnie z art. 70 ustawy z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2018 r. poz. 800 z późn. zm.) nie uległy przedawnieniu.-->
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D26" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer cofniętego zezwolenia lub uchylonej decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D27" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data cofniętego zezwolenia lub uchylonej decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D28" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Kwota zapłaconego podatku w związku z cofnięciem zezwolenia lub uchyleniem decyzji o wsparciu, uiszczonego w rozliczeniu zaliczki za wybrany okres wpłaty zaliczek</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D29" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Dochód zwolniony z działalności gospodarczej określonej w cofniętym zezwoleniu lub uchylonej decyzji o wsparciu, podlegający doliczeniu do podstawy opodatkowania w zeznaniu rocznym</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Razem kwota dochodu podlegającego doliczeniu do podstawy opodatkowania</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<!--wypełniają podatnicy, którzy posiadają zezwolenia na prowadzenie działalności na terenie specjalnych strefach ekonomicznych lub decyzje o wsparciu, na podstawie których prowadzą działalność na terenach określonych w tych decyzjach)-->
								<xsd:element name="P_31" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota kosztów kwalifikowanych odliczonych od podstawy opodatkowania w ramach ulgi B+R</xsd:documentation>
									</xsd:annotation>
									<!--Podatnik uzyskujący przychody inne, niż przychody z zysków kapitałowych może odliczyć od podstawy opodatkowania koszty uzyskania przychodów poniesione na działalność badawczo-rozwojową (koszty kwalifikowane) na podstawie art. 18d ustawy.-->
								</xsd:element>
								<xsd:element name="P_32" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Numer zezwolenia lub decyzji o wsparciu, w ramach którego poniesione zostały koszty kwalifikowane</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
