	<xsd:simpleType name="TNrMDR">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="MDR[0-9]{7}/[0-9]{2}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TId">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="32"/>
			<xsd:maxLength value="32"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TWartoscKorzysci">
		<xsd:annotation>
			<xsd:documentation>Szacunkowa wartość korzyści podatkowej lub przybliżona wartość aktywa w podatku odroczonym, jeśli występuje i jest znana lub możliwa do oszacowania przez składającego informację, w złotych.</xsd:documentation>
		</xsd:annotation>
		<xsd:choice>
			<xsd:element name="WartoscKwotowa" type="etd:TKwotaC">
				<xsd:annotation>
					<xsd:documentation>Szacunkowa wartość korzyści podatkowej lub przybliżona wartość aktywa w podatku odroczonym, w złotych.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BrakSzacowania" type="etd:TWybor1" fixed="1">
				<xsd:annotation>
					<xsd:documentation>Brak możliwości oszacowania wartości korzyści podatkowej lub przybliżonej wartości aktywa w podatku odroczonym.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BrakKorzysci" type="etd:TWybor1" fixed="1">
				<xsd:annotation>
					<xsd:documentation>Brak korzyści podatkowej lub przybliżonej wartości aktywa w podatku odroczonym w złotych.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:choice>
	</xsd:complexType>
	<xsd:simpleType name="TKwotaCWiekszaOdZera">
		<xsd:annotation>
			<xsd:documentation>Wartość kwotowa nieujemna wykazana w zł większa od zera</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TKwotaC">
			<xsd:minInclusive value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TWartoscPrzedmiotu">
		<xsd:annotation>
			<xsd:documentation>Wartość przedmiotu czynności uzgodnienia stanowiącego schemat podatkowy.</xsd:documentation>
		</xsd:annotation>
		<xsd:choice>
			<xsd:element name="WartKwotPrzed" type="mdr:TKwotaCWiekszaOdZera">
				<xsd:annotation>
					<xsd:documentation>Wartość przedmiotu czynności uzgodnienia stanowiącego schemat podatkowy wyrażona w złotych.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BrakSzacPrzed" type="etd:TWybor1" fixed="1">
				<xsd:annotation>
					<xsd:documentation>Brak możliwości oszacowania wartości przedmiotu czynności uzgodnienia stanowiącego schemat podatkowy.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="BrakWartPrzed" type="etd:TWybor1" fixed="1">
				<xsd:annotation>
					<xsd:documentation>Brak wartości przedmiotu czynności uzgodnienia stanowiącego schemat podatkowy.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:choice>
	</xsd:complexType>
</xsd:schema>
