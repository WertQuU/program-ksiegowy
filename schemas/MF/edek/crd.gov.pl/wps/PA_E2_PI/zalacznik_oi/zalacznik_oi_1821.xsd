<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:cz8s="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CIT8S/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CIT8S/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/StrukturyDanych_v5-0E.xsd"/>
	<!--Załącznik do zeznań: CIT-8 i CIT-8AB.-->
	<!-- -->
	<!--Formularz przeznaczony jest dla podatników podatku dochodowego od osób prawnych będących beneficjentami pomocy w rozumieniu przepisów o pomocy publicznej.-->
	<!-- -->
	<!--Zgodnie z art. 1 ustawy podatnikami podatku dochodowego od osób prawnych są:
   - osoby prawne i spółki kapitałowe w organizacji;
   - jednostki organizacyjne niemające osobowości prawnej, z wyjątkiem spółek niemających osobowości prawnej;
   - spółki komandytowo-akcyjne;
   - spółki niemające osobowości prawnej, mające siedzibę lub zarząd w innym państwie, jeżeli zgodnie z przepisami prawa podatkowego tego państwa są traktowane jako osoby prawne i podlegają w tym państwie opodatkowaniu od całości swoich dochodów bez względu na miejsce ich osiągania.-->
	<xsd:complexType name="TNaglowek_CIT_8S">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8s:TKodFormularza_CIT_8S">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT/8S (3)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8s:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8s:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2019-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_8S">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/8S"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_8S">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI DOCHODU OSIĄGNIĘTEGO Z DZIAŁALNOŚCI GOSPODARCZEJ PROWADZONEJ NA TERENIE SPECJALNEJ STREFY EKONOMICZNEJ NA PODSTAWIE ZEZWOLENIA LUB NA TERENIE OKREŚLONYM W DECYZJI O WSPARCIU</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="cz8s:TNaglowek_CIT_8S"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacje dotyczące zezwoleń lub decyzji o wsparciu posiadanych przez podatnika, ustalenie wielkości dochodu podlegającego zwolnieniu z opodatkowania z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie posiadanych zezwoleń lub na terenie określonym w decyzji o wsparciu, informacje dotyczące cofniętego zezwolenia lub uchylonej decyzji o wsparciu, wielkość kosztów kwalifikowanych, rozliczanych w ramach ulgi B+R</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_B" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Informacja dotycząca zezwoleń lub decyzji o wsparciu posiadanych przez podatnika</xsd:documentation>
								</xsd:annotation>
								<!--Należy wskazać wszystkie zezwolenia lub decyzje o wsparciu, na podstawie których przedsiębiorca poniósł koszty kwalifikujące się do objęcia pomocą publiczną na podstawie zezwolenia lub na podstawie decyzji o wsparciu.-->
								<!-- -->
								<!--Zdyskontowaną pomoc publiczną ustala się zgodnie z §10 ust. 3 rozporządzenia Rady Ministrów z dnia 28 sierpnia 2018 r. w przypadku przedsiębiorców prowadzących inwestycję na podstawie decyzji o wsparciu lub na podstawie § 7 ust. 6 rozporządzenia Rady Ministrów z dnia 10 grudnia 2008 r. w przypadku przedsiębiorców prowadzących inwestycję na podstawie zezwolenia.-->
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="P_B8" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Numer zezwolenia lub decyzji o wsparciu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_B9" type="etd:TData">
											<xsd:annotation>
												<xsd:documentation>Data wydania zezwolenia lub decyzji o wsparciu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_B10" type="etd:TData">
											<xsd:annotation>
												<xsd:documentation>Data rozpoczęcia działalności</xsd:documentation>
											</xsd:annotation>
											<!--Przez datę rozpoczęcia działalności należy rozumieć datę poniesienia przez przedsiębiorcę pierwszego wydatku będącego kosztem kwalifikowanym, o którym mowa w rozporządzeniu Rady Ministrów z dnia 28 sierpnia 2018 r. w sprawie pomocy publicznej udzielanej niektórym przedsiębiorcom na realizację nowych inwestycji (Dz. U. poz. 1713), zwanym dalej „rozporządzeniem Rady Ministrów z dnia 28 sierpnia 2018 r.” w zakresie działalności prowadzonej na podstawie decyzji o wsparciu albo kosztem kwalifikowanym, o którym mowa w rozporządzeniu Rady Ministrów z dnia 10 grudnia 2008 r. w sprawie pomocy publicznej udzielanej przedsiębiorcom działającym na podstawie zezwolenia na prowadzenie działalności gospodarczej na terenach specjalnych stref ekonomicznych (Dz. U. z 2019 r. poz. 121), zwanym dalej „rozporządzeniem Rady Ministrów z dnia 10 grudnia 2008 r.” w zakresie działalności prowadzonej na podstawie zezwolenia.-->
										</xsd:element>
										<xsd:sequence>
											<xsd:element name="P_B11" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Maksymalna wartość pomocy publicznej - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B12" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Maksymalna wartość pomocy publicznej - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<!--Należy wykazać faktycznie poniesione koszty kwalifikujące się do objęcia pomocą publiczną przez przedsiębiorcę wskazanego w poz. 7.-->
											<xsd:element name="P_B13" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty kwalifikujące się do objęcia pomocą publiczną narastająco - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B14" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty kwalifikujące się do objęcia pomocą publiczną narastająco - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<!--Należy wykazać faktycznie uzyskaną pomoc publiczną przez przedsiębiorcę wskazanego w poz. 7.-->
											<xsd:element name="P_B15" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Pomoc udzielona na podstawie ustawy w ramach zezwolenia lub decyzji o wsparciu z poz. 8 - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B16" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Pomoc udzielona na podstawie ustawy w ramach zezwolenia lub decyzji o wsparciu z poz. 8 - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<!--Należy wskazać wsparcie uzyskane na inwestycję, na którą wydane jest zezwolenie lub decyzja o wsparciu.-->
											<xsd:element name="P_B17" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Inne wsparcie objęte pomocą - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B18" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Inne wsparcie objęte pomocą - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
							<xsd:sequence>
								<xsd:element name="P_C" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Ustalenie wielkości dochodu podlegającego zwolnieniu z opodatkowania z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie posiadanych zezwoleń lub na terenie określonym w decyzji o wsparciu. Informacje dotyczące zezwolenia lub decyzji o wsparciu</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 19 i poz. 20 należy wskazać zezwolenia lub decyzje o wsparciu, w ramach których podatnik korzysta z pomocy publicznej w formie zwolnienia podatkowego w roku podatkowym, za który składane jest zeznanie. W poz. 22 i poz. 23 podatnik wskazuje sumę przychodów i kosztów uzyskania przychodów określoną w zezwoleniach lub decyzjach o wsparciu-->
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_C19" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C20" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wydania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C21">
												<xsd:annotation>
													<xsd:documentation>Jednostka terytorialna realizacji inwestycji (należy podać informacje zgodnie z NUTS 2016 EUROSTAT)</xsd:documentation>
												</xsd:annotation>
												<xsd:simpleType>
													<xsd:restriction base="xsd:string">
														<xsd:pattern value="PL[24-9]{1}[1-4]{1}[1-9]{1}"/>
														<xsd:pattern value="PL[2]{2}[ABC]{1}"/>
														<xsd:pattern value="PL21A|PLZZZ"/>
													</xsd:restriction>
												</xsd:simpleType>
											</xsd:element>
											<xsd:element name="P_C22" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Przychody z działalności gospodarczej określonej w zezwoleniach lub decyzjach o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C23" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty uzyskania przychodów z działalności gospodarczej określonej w zezwoleniach lub decyzjach o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C24" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Dochód z działalności gospodarczej określonej w zezwoleniach lub decyzjach o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C25" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Kwalifikowany dochód z kwalifikowanego prawa własności intelektualnej</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C26" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Strata z działalności gospodarczej określonej w zezwoleniach lub decyzjach o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_27" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Razem kwota dochodu podlegająca zwolnieniu z opodatkowania</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:element name="P_D" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Informacje dotyczące cofniętego zezwolenia lub uchylonej decyzji o wsparciu</xsd:documentation>
									</xsd:annotation>
									<!--Należy wykazać dane, które zgodnie z art. 70 ustawy z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2019 r. poz. 900, z późn. zm.) nie uległy przedawnieniu.-->
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D28" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer cofniętego zezwolenia lub uchylonej decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D29" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data cofniętego zezwolenia lub uchylonej decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D30" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Kwota zapłaconego podatku w związku z cofnięciem zezwolenia lub uchyleniem decyzji o wsparciu, uiszczonego w rozliczeniu zaliczki za wybrany okres wpłaty zaliczek</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D31" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Dochód zwolniony z działalności gospodarczej określonej w cofniętym zezwoleniu lub uchylonej decyzji o wsparciu, podlegający doliczeniu do podstawy opodatkowania w zeznaniu rocznym</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_32" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Razem kwota dochodu podlegającego doliczeniu do podstawy opodatkowania</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<!--wypełniają podatnicy, którzy posiadają zezwolenia na prowadzenie działalności na terenie specjalnych strefach ekonomicznych lub decyzje o wsparciu, na podstawie których prowadzą działalność na terenach określonych w tych decyzjach-->
								<xsd:element name="P_33" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota kosztów kwalifikowanych odliczonych od podstawy opodatkowania w ramach ulgi B+R</xsd:documentation>
									</xsd:annotation>
									<!--Podatnik uzyskujący dochody inne, niż przychody z zysków kapitałowych może odliczyć od podstawy opodatkowania koszty uzyskania przychodów poniesione na działalność badawczo - rozwojową (koszty kwalifikowane), na podstawie art. 18d ustawy. Wypełnia podatnik, który prowadzi działalność w ramach przedsiębiorstwa wskazanego w poz. 7 i ponosi koszty na działalność B+R w ramach posiadanej decyzji o wsparciu lub w ramach zezwolenia na prowadzenie działalności gospodarczej na terenie specjalnej strefy ekonomicznej.-->
								</xsd:element>
								<xsd:element name="P_34" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Numer zezwolenia lub decyzji o wsparciu, w ramach którego poniesione zostały koszty kwalifikowane</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
