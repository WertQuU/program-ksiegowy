<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czbr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITBR/" xmlns:czd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITD/" xmlns:czgk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITPGK/" xmlns:czip="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITIP/" xmlns:czmit="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITMIT/" xmlns:czmt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/11/30/eD/SPRMT/" xmlns:cznz="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITNZI/" xmlns:czpm="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITPM/" xmlns:czst="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/01/09/eD/CITSTZ/" xmlns:czww="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITWW/" xmlns:cz8s="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CIT8S/" xmlns:cz8sp="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CIT8SP/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" xmlns:tns="http://crd.gov.pl/wzor/2020/02/07/9121/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/ORDZU/" targetNamespace="http://crd.gov.pl/wzor/2020/02/07/9121/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/01/09/eD/CITSTZ/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/01/09/eD/CITSTZ/CIT-ST(7)_Z_v7-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITBR/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITBR/CIT_BR(6)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITD/CIT-D(7)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/11/30/eD/SPRMT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/11/30/eD/SPRMT/SPR_MT(1)_Z_v3-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITMIT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITMIT/CIT_MIT(3)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITNZI/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITNZI/CIT_NZI(2)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CIT8SP/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CIT8SP/CIT_8SP(3)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CIT8S/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CIT8S/CIT_8S(3)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITPM/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITPM/CIT_PM(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITIP/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITIP/CIT_IP(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITWW/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITWW/CIT_WW(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITPGK/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITPGK/CIT_PGK(3)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/ORDZU/ORD-ZU(3)_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/StrukturyDanych_v5-0E.xsd"/>
	<!--Ilekroć w zeznaniu jest mowa o urzędzie skarbowym, w tym urzędzie skarbowym do którego adresowane jest zeznanie - oznacza to urząd skarbowy, przy pomocy którego właściwy dla podatnika naczelnik urzędu skarbowego wykonuje swoje zadania.-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT8AB (3)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="2-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_7"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-8AB"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla dat dotyczących roku podatkowego</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2020-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TDataPGK">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla dat dotyczących danych rejestracyjnych PGK</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="1996-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>ZEZNANIE O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) PRZEZ PODATKOWĄ GRUPĘ KAPITAŁOWĄ - PODATNIKA PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne PGK i adres siedziby spółki dominującej w PGK</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TOsobaNiefizyczna2">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="PGK"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="tns:PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane rejestracyjne PGK, informacja o załącznikach, ustalenie podstawy opodatkowania i należnego podatku, kwoty należnych zaliczek miesięcznych lub zaliczek kwartalnych oraz kwoty podatku, różnica pomiędzy podatkiem należnym a należnymi zaliczkami, kwota do zapłaty / nadpłata, inne zobowiązania podatkowe, dane identyfikacyjne spółki dominującej w PGK, informacje dodatkowe</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Pouczenia">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższych pouczeń:
Niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego zgodnie z przepisami o postępowaniu egzekucyjnym w administracji na odsetki od wykazanych i nieuiszczonych w obowiązujących terminach lub uiszczonych w niepełnej wysokości kwot z poz. 170 - 265.
W przypadku niewpłacenia w obowiązujących terminach kwot z poz. 272 i 274 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego, zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz. U. z 2019 r. poz. 1438, z późn. zm.).
Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie podatku na uszczuplenie grozi odpowiedzialność przewidziana w Kodeksie karnym skarbowym.
								</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="czst:Zalacznik_CIT-ST" minOccurs="0"/>
							<xsd:element ref="czbr:Zalacznik_CIT_BR" minOccurs="0"/>
							<xsd:element ref="czd:Zalacznik_CIT-D" minOccurs="0" maxOccurs="99"/>
							<xsd:element ref="czmt:Zalacznik_SPR_MT" minOccurs="0" maxOccurs="99"/>
							<xsd:element ref="czmit:Zalacznik_CIT_MIT" minOccurs="0"/>
							<xsd:element ref="cznz:Zalacznik_CIT_NZI" minOccurs="0" maxOccurs="99"/>
							<xsd:element ref="cz8sp:Zalacznik_CIT_8SP" minOccurs="0"/>
							<xsd:element ref="cz8s:Zalacznik_CIT_8S" minOccurs="0"/>
							<xsd:element ref="czpm:Zalacznik_CIT_PM" minOccurs="0" maxOccurs="99"/>
							<xsd:element ref="czip:Zalacznik_CIT_IP" minOccurs="0"/>
							<xsd:element ref="czww:Zalacznik_CIT_WW" minOccurs="0"/>
							<xsd:element ref="czgk:Zalacznik_CIT_PGK" maxOccurs="99"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
		<xsd:unique name="klucz_NIP">
			<xsd:selector xpath="tns:Zalaczniki/czgk:Zalacznik_CIT_PGK"/>
			<xsd:field xpath="czgk:Podmiot2/czgk:OsobaNiefizyczna/etd:NIP"/>
		</xsd:unique>
	</xsd:element>
	<xsd:element name="PozycjeSzczegolowe">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="P_7A" type="etd:TWybor1_2" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Rodzaj korekty. Wartość: 1 - korekta zeznania, o której mowa w art. 81 Ordynacji podatkowej, 2 - korekta zeznania, o której mowa w art. 81b § 1a Ordynacji podatkowej</xsd:documentation>
					</xsd:annotation>
					<!--Ilekroć mowa o Ordynacji podatkowej, oznacza to ustawę z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2019 r. poz. 900, z późn. zm.).-->
					<!-- -->
					<!--Ad. wartość 2 - Korekta składana w toku postępowania podatkowego w sprawie unikania opodatkowania; korektę składa się wraz z uzasadnieniem przyczyn korekty.-->
				</xsd:element>
				<xsd:sequence>
					<xsd:element name="P_18" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Organ wydający decyzję o rejestracji PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_19" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Nr decyzji</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_20" type="tns:TDataPGK">
						<xsd:annotation>
							<xsd:documentation>Data wydania decyzji</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_21" type="tns:TDataPGK">
						<xsd:annotation>
							<xsd:documentation>Data rozpoczęcia pierwszego roku podatkowego PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_22" type="tns:TDataPGK">
						<xsd:annotation>
							<xsd:documentation>Okres, od którego została zawarta umowa o utworzeniu PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_23" type="tns:TDataPGK" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Okres, do którego została zawarta umowa o utworzeniu PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_24">
						<xsd:annotation>
							<xsd:documentation>Liczba spółek tworzących PGK</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="2"/>
								<xsd:maxInclusive value="99"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_25" type="etd:TNrNIP">
						<xsd:annotation>
							<xsd:documentation>Identyfikator podatkowy NIP spółki dominującej w PGK</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_26" type="etd:TWybor1_2">
						<xsd:annotation>
							<xsd:documentation>Rejestracja umowy o utworzeniu PGK przez organ podatkowy: 1 - po dniu 1 stycznia 1997 r., 2 - przed dniem 1 stycznia 1997 r.</xsd:documentation>
						</xsd:annotation>
						<!--Dotyczy podatkowej grupy kapitałowej, jeżeli umowa o jej utworzeniu została zarejestrowana przez urząd skarbowy przed dniem 1 stycznia 1997 r. (art. 3 ustawy z dnia 21 listopada 1996 r. o zmianie ustawy o podatku dochodowym od osób prawnych (Dz. U. poz. 639)).-->
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence>
					<xsd:element name="P_27" type="etd:TWybor1_2">
						<xsd:annotation>
							<xsd:documentation>Podatnik jest zobowiązany do złożenia CIT-ST. Wybór: 1 - tak, 2 -nie</xsd:documentation>
						</xsd:annotation>
						<!--Podatnicy posiadający zakłady (oddziały), położone na obszarze jednostki samorządu terytorialnego innej, niż jednostka samorządu terytorialnego, na obszarze której podatnicy mają swoją siedzibę, w tym podatnicy prowadzący działalność poprzez położony na terytorium RP zakład zagraniczny, zatrudniający osoby na podstawie umowy o pracę - art. 28 ust. 1 i 2 ustawy oraz art.10 ust.1, 2 i 2a ustawy z dnia 13 listopada 2003 r. o dochodach jednostek samorządu terytorialnego (Dz. U. z 2018 r. poz. 1530, z późn. zm.). W przypadku zaznaczenia w poz. 27 kwadratu nr 1 należy podać liczbę załączników w poz. 28.-->
					</xsd:element>
					<xsd:element name="P_28" type="etd:TWybor1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Liczba CIT-ST</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_29" type="etd:TWybor1">
						<xsd:annotation>
							<xsd:documentation>Informacja o załącznikach CIT/BR</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_40" type="etd:TWybor1">
						<xsd:annotation>
							<xsd:documentation>Podatnik występuje o zwrot niewykorzystanego odliczenia na podstawie art. 18da ustawy. Wybór: 1 - tak</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_30">
						<xsd:annotation>
							<xsd:documentation>Informacja o załącznikach CIT-D</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="0"/>
								<xsd:maxInclusive value="99"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_137" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Odliczenia darowizn na cele kształcenia zawodowego - art. 18 ust. 1 pkt 8 ustawy. Dochody (przychody) z zysków kapitałowych</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_138" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Odliczenia darowizn na cele kształcenia zawodowego - art. 18 ust. 1 pkt 8 ustawy. Dochody (przychody) z innych źródeł przychodów</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_31" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Sprawozdanie o realizacji uznanej metody ustalania ceny transakcyjnej</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
							<xsd:maxInclusive value="99"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_32" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/MIT</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_33" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/NZI</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
							<xsd:maxInclusive value="99"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_34" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/8SP</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_35" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/8S</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_36" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT/PM</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
							<xsd:maxInclusive value="99"/>
						</xsd:restriction>
