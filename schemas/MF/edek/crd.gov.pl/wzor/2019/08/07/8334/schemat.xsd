				<xsd:annotation>
					<xsd:documentation>Zewnętrzne</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="PR03">
				<xsd:annotation>
					<xsd:documentation>Porównanie wewnętrzne przygotowane przez kontrahenta</xsd:documentation>
				</xsd:annotation>
