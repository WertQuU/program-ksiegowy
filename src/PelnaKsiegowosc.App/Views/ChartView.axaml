<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:PelnaKsiegowosc.Presentation.ViewModels.Sections"
             xmlns:vm="using:PelnaKsiegowosc.Presentation.ViewModels"
             xmlns:c="using:PelnaKsiegowosc.App.Controls"
             x:Class="PelnaKsiegowosc.App.Views.ChartView"
             x:DataType="s:ChartViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="h1" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding ChartInfo}" Classes="info" />
    <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
      <TextBox Text="{Binding Filter}" Watermark="Filtr: numer lub nazwa" />
      <Button Content="Filtruj" Command="{Binding ApplyFilterCommand}" />
      <Button Content="Dodaj szczegółowe konta kosztów" Command="{Binding AddDetailedCostAccountsCommand}" IsVisible="{Binding HasChart}" />
      <Button Content="Kontrola planu" Command="{Binding ValidateCommand}" />
      <Button Content="Zatwierdź plan kont" Command="{Binding ApproveCommand}" />
      <Button Content="Eksport CSV…" Command="{Binding ExportCsvCommand}" />
      <Button Content="Import kont z CSV…" Command="{Binding ImportCsvCommand}" />
    </WrapPanel>
    <Border DockPanel.Dock="Top" Classes="panel" IsVisible="{Binding !HasChart}">
      <StackPanel Spacing="4">
        <TextBlock Text="Kreator planu kont" Classes="h2" Margin="0" />
        <CheckBox Content="Szczegółowe konta kosztów (zalecane)" IsChecked="{Binding Options.DetailedCosts}" />
        <CheckBox Content="Handel towarami" IsChecked="{Binding Options.TradingGoods}" />
        <CheckBox Content="Pracownicy" IsChecked="{Binding Options.Employees}" />
        <CheckBox Content="Rachunek w EUR" IsChecked="{Binding Options.ForeignCurrencyEur}" />
        <CheckBox Content="Rachunek w USD" IsChecked="{Binding Options.ForeignCurrencyUsd}" />
        <CheckBox Content="Kredyt lub pożyczka bankowa" IsChecked="{Binding Options.BankLoans}" />
        <CheckBox Content="Leasing" IsChecked="{Binding Options.Leasing}" />
        <Button Content="Utwórz plan kont" Command="{Binding CreateFromTemplateCommand}" Classes="accent" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Classes="card" IsVisible="{Binding HasChart}" Margin="0,0,0,8">
      <StackPanel Spacing="6">
        <TextBlock Text="Kreator: dodaj konto prostymi słowami" FontWeight="SemiBold" />
        <WrapPanel Classes="toolbar">
          <ComboBox ItemsSource="{Binding WizardPurposes}" SelectedItem="{Binding WizardPurpose}" MinWidth="320" PlaceholderText="1. Do czego ma służyć konto?" />
          <TextBox Text="{Binding WizardName}" Watermark="2. Nazwa, np. Ochrona obiektu" MinWidth="240" />
          <ComboBox ItemsSource="{Binding TaxAnswers}" SelectedItem="{Binding WizardTax}" MinWidth="280" PlaceholderText="3. Czy to koszt/przychód podatkowy?" />
          <Button Content="Dodaj konto" Command="{Binding WizardAddCommand}" Classes="accent" />
        </WrapPanel>
        <TextBlock Text="{Binding WizardHint}" Classes="cardnote" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Expander DockPanel.Dock="Top" Header="Dla księgowego: konto z pełnymi parametrami (numer, pozycje sprawozdania, CIT)" IsExpanded="True" IsVisible="{Binding HasChart}" Margin="0,0,0,8">
    <Border Classes="panel">
      <StackPanel>
        <Grid Classes="form" ColumnDefinitions="110,140,90,*,90,220" RowDefinitions="Auto,Auto">
          <TextBlock Text="Numer" /><TextBox Grid.Column="1" Text="{Binding Number}" />
          <TextBlock Grid.Column="2" Text="Nazwa" /><TextBox Grid.Column="3" Text="{Binding Name}" />
          <TextBlock Grid.Column="4" Text="Typ" /><ComboBox Grid.Column="5" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" />
          <TextBlock Grid.Row="1" Text="Bilans Wn / Ma" />
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*"><TextBox Text="{Binding BalanceDebitLine}" Margin="0,2,4,2" /><TextBox Grid.Column="1" Text="{Binding BalanceCreditLine}" Margin="0,2,12,2" /></Grid>
          <TextBlock Grid.Row="1" Grid.Column="2" Text="RZiS" /><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ProfitLossLine}" Watermark="np. R.B.III" />
          <TextBlock Grid.Row="1" Grid.Column="4" Text="CIT" /><ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding CitClasses}" SelectedItem="{Binding Cit}" />
        </Grid>
        <WrapPanel Classes="toolbar">
          <CheckBox Content="Konto rozrachunkowe" IsChecked="{Binding Settlement}" />
          <CheckBox Content="Aktywne" IsChecked="{Binding IsActive}" />
          <ComboBox ItemsSource="{Binding DebtFinancingChoices}" SelectedItem="{Binding DebtFinancing}" MinWidth="260" ToolTip.Tip="Limit kosztów finansowania dłużnego (art. 15c CIT): odsetki, prowizje, opłaty, część odsetkowa leasingu itd." />
          <ComboBox ItemsSource="{Binding CashFlowChoices}" SelectedItem="{Binding CashFlow}" MinWidth="300" ToolTip.Tip="Kategoria rachunku przepływów pieniężnych dla zapłat z udziałem tego konta (np. leasing finansowy, obligacje, udzielone pożyczki, dywidendy)" />
          <Button Content="Dodaj konto" Command="{Binding AddAccountCommand}" />
          <Button Content="Zapisz zmiany zaznaczonego" Command="{Binding UpdateAccountCommand}" />
          <Button Content="Usuń zaznaczone" Command="{Binding DeleteAccountCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    </Expander>
    <c:TableView Table="{Binding Accounts}" SelectedRow="{Binding Selected}" />
  </DockPanel>
</UserControl>
