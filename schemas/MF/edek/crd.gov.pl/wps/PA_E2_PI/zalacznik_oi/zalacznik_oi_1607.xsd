<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:czgk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITPGK/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITPGK/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/StrukturyDanych_v4-0E.xsd"/>
	<!--Załącznik do zeznania CIT-8AB.-->
	<xsd:complexType name="TNaglowek_CIT_PGK">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czgk:TKodFormularza_CIT_PGK">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CITPGK (1)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czgk:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czgk:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_6"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2018-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_PGK">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/PGK"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TIdentyfikatorOsobyNiefizycznej">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych identyfikacyjnych o osobie niefizycznej</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NIP" type="etd:TNrNIP">
				<xsd:annotation>
					<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="PelnaNazwa">
				<xsd:annotation>
					<xsd:documentation>Pełna nazwa</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:token">
						<xsd:minLength value="1"/>
						<xsd:maxLength value="240"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TOsobaNiefizyczna">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych o osobie niefizycznej</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OsobaNiefizyczna" type="czgk:TIdentyfikatorOsobyNiefizycznej"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="Zalacznik_CIT_PGK">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) PRZEZ SPÓŁKĘ TWORZĄCĄ PODATKOWĄ GRUPĘ KAPITAŁOWĄ</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czgk:TNaglowek_CIT_PGK"/>
				<xsd:element name="Podmiot1">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne podatkowej grupy kapitałowej (PGK)</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="czgk:TOsobaNiefizyczna">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="PGK"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Podmiot2" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dane spółki tworzącej PGK</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="czgk:TOsobaNiefizyczna">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Spółka tworząca PGK"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dodatkowe, ustalenie dochodu / straty</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_7">
								<xsd:annotation>
									<xsd:documentation>Łączna liczba składanych załączników</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:minInclusive value="1"/>
										<xsd:maxInclusive value="99"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_10" type="etd:TWybor1_2">
								<xsd:annotation>
									<xsd:documentation>Spółka jest spółką reprezentującą PGK: 1 - tak, 2 - nie</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_11" type="etd:TWybor1_2">
								<xsd:annotation>
									<xsd:documentation>Spółka jest spółką dominującą PGK: 1 - tak, 2 - nie</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Dane dodatkowe</xsd:documentation>
								</xsd:annotation>
								<!--Dane dodatkowe objęte blokiem B1 dotyczą wyłącznie spółek tworzących PGK oraz spółki reprezentującej PGK w zakresie obowiązków PGK-->
								<xsd:element name="P_12" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Spółka jest przedsiębiorstwem finansowym, o którym mowa w art. 15c ust. 16 ustawy: 1 - tak, 2 - nie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:sequence>
									<xsd:element name="P_13" type="etd:TWybor1_2">
										<xsd:annotation>
											<xsd:documentation>Spółka korzysta ze zwolnień w specjalnej strefie ekonomicznej na podstawie zezwolenia i w oparciu o decyzję o wsparciu: 1 - tak, 2 - nie</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_14" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Kwota zwolnionych od podatków dochodów uzyskanych z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej</xsd:documentation>
										</xsd:annotation>
										<!--w przypadku wyboru w poz. 13 wartości 1-->
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:element name="P_15" type="etd:TWybor1_2">
										<xsd:annotation>
											<xsd:documentation>Spółka poniosła koszty uzyskania przychodów na działalność badawczo-rozwojową: 1 - tak, 2 - nie</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_16" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Suma kwot kosztów kwalifikowanych, o których mowa w art. 18d ust. 2 ustawy</xsd:documentation>
										</xsd:annotation>
										<!--w przypadku wyboru w poz. 15 wartości 1-->
									</xsd:element>
								</xsd:sequence>
								<xsd:element name="P_17" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Spółka dokonywała w roku podatkowym transakcji z podmiotami powiązanymi nie wchodzącymi w skład PGK (w związku z art. 1a ust. 2 pkt 3 lit. b ustawy: 1 - tak, 2 - nie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_18" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Spółka była obowiązana do sporządzenia dokumentacji podatkowej, o której mowa w art. 9a ust. 1 pkt 1 ustawy: 1 - tak, 2 - nie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_19" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Spółka była obowiązana do sporządzenia dokumentacji podatkowej, o której mowa w art. 9 ust. 1 pkt 2 lub 3 ustawy: 1 - tak, 2 - nie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_20" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Spółka była obowiązana do sporządzenia elementu dokumentacji podatkowej, o którym mowa w art. 9a ust. 2d ustawy: 1 - tak, 2 - nie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_21" type="etd:TWybor1_2">
									<xsd:annotation>
										<xsd:documentation>Sprawozdanie o realizacji uznanej metody ustalania ceny transakcyjnej: 1 - tak, 2 - nie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Przychody</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych na terytorium RP</xsd:documentation>
									</xsd:annotation>
									<!--Nie dotyczy przychodów, o których mowa w art. 2 ust. 1, art. 21 i 22 ustawy, z zastrzeżeniem art. 7 ust. 3 ustawy-->
									<xsd:element name="P_22" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_23" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP</xsd:documentation>
									</xsd:annotation>
									<!--Przychody równorzędne do kategorii przychodów wymienionych w art. 21 ust. 1 ustawy oraz przychody z dywidend i inne przychody z udziałów w zyskach osób prawnych niemających siedziby na terytorium RP.-->
									<xsd:element name="P_24" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_25" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP - inne niż wymienione odpowiednio w poz. 24 lub 25</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_26" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_27" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Przychody uzyskane w następstwie wniesienia do spółki wkładu niepieniężnego w postaci komercjalizowanej własności intelektualnej, które na podstawie art. 12 ust. 1b pkt 5 ustawy, w zw. z art. 12 ustawy z dnia 4 listopada 2016 r. o zmianie niektórych ustaw określających warunki prowadzenia działalności innowacyjnej (Dz. U. poz. 1933), podlegają wykazaniu w roku podatkowym wskazanym w poz. 5 i 6</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_28" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_29" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Razem przychody</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_31" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychody z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 22 lub 23</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_32" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_33" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 24 lub 25</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_34" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_35" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 26 lub 27</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_36" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_37" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 28 lub 29</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_38" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_39" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Koszty, o których mowa w art. 15e ustawy, wyłączone w poprzednich pięciu latach podatkowych z kosztów uzyskania przychodów, podlegające na podstawie art. 15e ust. 9 ustawy zaliczeniu do kosztów uzyskania przychodów w roku podatkowym wskazanym w poz. 5 i 6</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_40" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_41" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Razem koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_42" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_43" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Dochód / strata</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Dochód (art. 7 ust. 2 ustawy)</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_44" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_45" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Strata (art. 7 ust. 2 ustawy)</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_46" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_47" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence>
									<xsd:annotation>
										<xsd:documentation>Strata w związku z postanowieniami art. 7 ust. 3-4a ustawy oraz strata ze źródeł przychodów wykazanych odpowiednio w poz. 26 i 27 podlegająca za granicą odliczeniu od dochodu do opodatkowania</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_48" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_49" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
