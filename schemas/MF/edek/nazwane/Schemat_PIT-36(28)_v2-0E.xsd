<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" xmlns:kusex="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/KodyUrzedowSkarbowychExWUS/" xmlns:ssr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/SSER/" xmlns:tns="http://crd.gov.pl/wzor/2021/02/24/10448/" xmlns:zb36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITB36/" xmlns:zbr36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITBR36/" xmlns:zd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/12/29/eD/PITD/" xmlns:zds36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITDS36/" xmlns:zg36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITZG36/" xmlns:zip36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITIP36/" xmlns:zm="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITM/" xmlns:zmt36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITMIT36/" xmlns:zo3x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/12/29/eD/PITO3X/" xmlns:zpm36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITPM36/" xmlns:zse36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITSE36/" xmlns:zwz36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITWZ36/" xmlns:zzi36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITNZI36/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/ORDZU/" xmlns:z2k="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/12/29/eD/PIT2K/" xmlns:z36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITZ36/" targetNamespace="http://crd.gov.pl/wzor/2021/02/24/10448/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITB36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITB36/PIT_B(18)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITBR36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITBR36/PIT_BR(4)_Z36_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITDS36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITDS36/PIT_DS(5)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITIP36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITIP36/PIT_IP(2)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/SSER/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/SSER/SSE-R(5)_Z_v6-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITSE36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITSE36/PIT_SE(1)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/12/29/eD/PITD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/12/29/eD/PITD/PIT_D(29)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/12/29/eD/PIT2K/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/12/29/eD/PIT2K/PIT-2K(8)_Z_v4-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITM/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITM/PIT_M(7)_Z_v4-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/12/29/eD/PITO3X/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/12/29/eD/PITO3X/PIT_O(25)_Z3X_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITZG36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITZG36/PIT_ZG(7)_Z36_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITZ36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITZ36/PIT_Z(9)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITMIT36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITMIT36/PIT_MIT(2)_Z36_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITWZ36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITWZ36/PIT_WZ(1)_Z36_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITPM36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITPM36/PIT_PM(1)_Z36_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITNZI36/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITNZI36/PIT_NZI(1)_Z36_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/ORDZU/ORD-ZU(3)_v4-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/KodyUrzedowSkarbowychExWUS/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/KodyUrzedowSkarbowychExWUS/KodyUrzedowSkarbowychExWUS_v7-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/StrukturyDanych_v7-0E.xsd"/>
	<!--Sposób obliczenia dochodu (straty) z pozarolniczej działalności gospodarczej nie ma zastosowania do podatników, którzy zaznaczyli kwadraty w poz. 40-43 (wypełniają informację PIT/Z) lub doliczają dochód z kwalifikowanych praw własności intelektualnej, niepodlegający opodatkowaniu na podstawie art. 30ca ust. 1 ustawy, tj według stawki 5%.-->
	<!-- -->
	<!--Podatnicy, którzy zaznaczyli kwadraty w poz. 40 i/lub 41 (wypełniają informację PIT/Z), sumują kwoty z wierszy od 1 do 10, nie uwzględniając kwot dochodu z poz. 82 i 139.-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT-36 (28)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="PIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="2-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="28"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_10"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Rok">
				<xsd:simpleType>
					<xsd:restriction base="etd:TRok">
						<xsd:minInclusive value="2020"/>
						<xsd:maxInclusive value="2030"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="kusex:TKodUS1"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT-36"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TWyborSposobu">
		<xsd:annotation>
			<xsd:documentation>Wybór sposobu opodatkowania</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:byte">
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation>indywidualnie</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2">
				<xsd:annotation>
					<xsd:documentation>wspólnie z małżonkiem, zgodnie z wnioskiem, o którym mowa w art. 6 ust. 2 ustawy</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="3">
				<xsd:annotation>
					<xsd:documentation>w sposób przewidziany dla wdów i wdowców</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="4">
				<xsd:annotation>
					<xsd:documentation>w sposób przewidziany dla osób samotnie wychowujących dzieci</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TOsobaFizyczna1">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych o osobie fizycznej z identyfikatorem NIP albo PESEL</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OsobaFizyczna" type="etd:TIdentyfikatorOsobyFizycznej1"/>
			<xsd:element name="AdresZamieszkania" minOccurs="0">
				<xsd:complexType>
					<xsd:complexContent>
						<xsd:extension base="etd:TAdres1">
							<xsd:attribute name="rodzajAdresu" type="xsd:string" use="required" fixed="RAD"/>
						</xsd:extension>
					</xsd:complexContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TNrIBAN">
		<xsd:annotation>
			<xsd:documentation>Numer IBAN</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Z]{2}[0-9]{2}[0-9A-Z]{10,30}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="SWIFT_Type">
		<xsd:annotation>
			<xsd:documentation>Kod SWIFT</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3}){0,1}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>ZEZNANIE O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) W ROKU PODATKOWYM</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne i aktualny adres zamieszkania</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TOsobaFizyczna3">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Podmiot2" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne i aktualny adres zamieszkania</xsd:documentation>
					</xsd:annotation>
					<!--Poz. 27-35 można nie wypełniać, jeżeli w poz. 6 wybrano wartość 2 i adres zamieszkania małżonka jest taki jak w części B.1 (Podmiot1); poz. 27-35 nie wypełnia się, jeżeli w poz. 6 wybrano wartość 3.-->
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="tns:TOsobaFizyczna1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Małżonek"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacje dodatkowe, przychody zwolnione od podatku na podstawie art. 21 ust. 1 pkt 148 ustawy, dochody / straty ze źródeł przychodów, odliczenie dochodu zwolnionego, strat i składek na ubezpieczenia społeczne, odliczenia od dochodu / zwolnienie, ustalenie podstawy opodatkowania / straty, obliczenie podatku, odliczenia od podatku, obliczenie zobowiązania podatkowego, zaliczki, o których mowa w art. 44 ust. 1 pkt 1 ustawy, oraz kwoty podatku, o którym mowa w art. 30g ustawy, dodatkowy zwrot z tytułu ulgi na dzieci, podatek do zapłaty / nadpłata / łączny zwrot, zryczałtowany podatek dochodowy, o którym mowa w art. 44 ust. 1b ustawy, odsetki naliczone zgodnie z art. 22e ust. 1 pkt 4 i ust. 2 ustawy, należne zaliczki o których mowa w art. 44 ust. 1, 1a,1c i 7 ustawy, dochody (przychody) wykazywanych na podstawie art. 45 ust. 3c ustawy, wniosek o przekazanie 1% podatku należnego na rzecz Organizacji Pożytku Publicznego (OPP), informacje uzupełniające, informacje o załącznikach, rachunek osobisty właściwy do zwrotu nadpłaty, KDR</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence>
								<xsd:element name="P_6" type="tns:TWyborSposobu">
									<xsd:annotation>
										<xsd:documentation>Wybór sposobu opodatkowania: 1 - indywidualnie, 2 - wspólnie z małżonkiem, zgodnie z wnioskiem, o którym mowa w art. 6 ust. 2 ustawy, 3 - w sposób przewidziany dla wdów i wdowców, 4 - w sposób przewidziany dla osób samotnie wychowujących dzieci</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_7" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>W sposób przewidziany w art. 29 ust. 4 ustawy - podatnik</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_8" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>W sposób przewidziany w art. 29 ust. 4 ustawy - małżonek</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_11" type="etd:TWybor1_2" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Rodzaj korekty. Wartość: 1 - korekta zeznania, o której mowa w art. 81 Ordynacji podatkowej, 2 - korekta zeznania składana w toku postępowania podatkowego w sprawie unikania opodatkowania, o której mowa w art. 81b § 1a Ordynacji podatkowej</xsd:documentation>
								</xsd:annotation>
								<!--Ilekroć jest mowa o Ordynacji podatkowej, oznacza to ustawę z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2020 r. poz. 1325, z późn. zm.).-->
								<!-- -->
								<!--W przypadku wyboru w poz. 11 wartości 2 korektę składa się wraz z uzasadnieniem przyczyn korekty.-->
							</xsd:element>
							<xsd:element name="P_36" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik uzyskiwał przychody wyłącznie z emerytury - renty zagranicznej</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_37" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek uzyskiwał przychody wyłącznie z emerytury - renty zagranicznej</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_38" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik dokonał korekty cen transferowych, o której mowa w art. 23q ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_39" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek dokonał korekty cen transferowych, o której mowa w art. 23q ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_40" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik korzystał, w roku podatkowym wykazanym w poz. 5, ze zwolnienia na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_41" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek korzystał, w roku podatkowym wykazanym w poz. 5, ze zwolnienia na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_42" type="etd:TWybor1">
									<xsd:annotation>
										<xsd:documentation>Podatnik korzystał, w jednym z pięciu lat poprzedzających rok wykazany w poz. 5, ze zwolnienia na podstawie art. 44 ust. 7a ustawy i w roku podatkowym wykazanym w poz. 5 dokonuje doliczenia na podstawie art. 44 ust. 7f ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_62_1">
									<xsd:annotation>
										<xsd:documentation>Rok (podać rok, w którym podatnik korzystał ze zwolnienia na podstawie art. 44 ust. 7a ustawy)</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TRok">
											<xsd:minInclusive value="2015"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_43" type="etd:TWybor1">
									<xsd:annotation>
										<xsd:documentation>Małżonek korzystał, w jednym z pięciu lat poprzedzających rok wykazany w poz. 5, ze zwolnienia na podstawie art. 44 ust. 7a ustawy i w roku podatkowym wykazanym w poz. 5 dokonuje doliczenia na podstawie art. 44 ust. 7f ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_62_2">
									<xsd:annotation>
										<xsd:documentation>Rok (podać rok, w którym małżonek korzystał ze zwolnienia na podstawie art. 44 ust. 7a ustawy)</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TRok">
											<xsd:minInclusive value="2015"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_44" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
