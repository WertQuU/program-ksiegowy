<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:kk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/KodyKrajow/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:zo28="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/11/02/eD/PITO28/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/11/02/eD/PITO28/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/KodyKrajow/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/KodyKrajow/KodyKrajow_v12-0E.xsd"/>
	<!--Załącznik do zeznań: PIT-28, PIT-28S.-->
	<!-- -->
	<!--Ilekroć jest mowa o ustawie, oznacza to ustawę z dnia 26 lipca 1991 r. o podatku dochodowym od osób fizycznych (Dz. U. z 2021 r. poz. 1128, z późn. zm.).-->
	<!-- -->
	<!--Ilekroć jest mowa o ustawie o ryczałcie, oznacza to ustawę z dnia 20 listopada 1998 r. o zryczałtowanym podatku dochodowym od niektórych przychodów osiąganych przez osoby fizyczne (Dz. U. z 2021 r. poz. 1993, z późn. zm.).-->
	<xsd:complexType name="TNaglowek_PIT_O">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zo28:TKodFormularza_PIT_O">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PPE/OD (27)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="27"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_PIT_O">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/O"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_O">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O ODLICZENIACH OD DOCHODU (PRZYCHODU) I OD PODATKU w roku podatkowym</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zo28:TNaglowek_PIT_O"/>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TIdentyfikatorOsobyFizycznej1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Podmiot2" minOccurs="0">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TIdentyfikatorOsobyFizycznej1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Małżonek"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Odliczenia od dochodu (przychodu) - inne niż wykazane w załącznikach PIT/D, PIT/BR, informacjach PIT-CSR/PIT-CSRS, PIT-RB/PIT-RBS lub bezpośrednio wymienione w zeznaniach podatkowych, odliczenia od podatku - inne niż wykazane w załączniku PIT/D lub bezpośrednio wymienione w zeznaniach podatkowych, informacja o przekazanych darowiznach oraz o obdarowanych, informacja o dzieciach uprawniających do ulgi na dzieci lub do ulgi dla rodzin 4+</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_4" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Nr załącznika</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<!--Suma kwot z wierszy od 1 do 11 w kolumnie „podatnik” oraz kolumnie „małżonek” nie może przekroczyć kwoty dochodu (przychodu), od którego jest odliczana.-->
								<xsd:element name="P_11" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane organizacjom na prowadzoną przez nie działalność pożytku publicznego w sferze zadań publicznych, o których mowa w art. 26 ust. 1 pkt 9 lit. a ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_13" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane na cele kultu religijnego, o których mowa w art. 26 ust. 1 pkt 9 lit. b ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_15" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane na cele krwiodawstwa, o których mowa w art. 26 ust. 1 pkt 9 lit. c ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_17" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane na cele kształcenia zawodowego, o których mowa w art. 26 ust. 1 pkt 9 lit. d ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_19" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane na cele odbudowy Pałacu Saskiego, Pałacu Brühla oraz kamienic przy ulicy Królewskiej w Warszawie, o których mowa w art. 26 ust. 1 pkt 9 lit. e ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_21" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane na przeciwdziałanie COVID-19, o których mowa m.in. w art. 52n ustawy i art. 57b ustawy o ryczałcie</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_23" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane w formie tabletów i laptopów, o których mowa m.in. w art. 52x ustawy i art. 57e ustawy o ryczałcie</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_25" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 2. Darowizny wynikające z odrębnych ustaw</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_D" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Informacja o przekazanych darowiznach oraz o obdarowanych</xsd:documentation>
									</xsd:annotation>
									<!--W przypadku darowizn, o których mowa w poz. 19-22, kwota darowizny wykazywanej w poz. 4 i 5 tej części, odpowiada kwocie określonej z uwzględnieniem odpowiednio 200%, 150% oraz 100% wartości darowizny-->
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D1" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa pełna</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D3" type="kk:TKodKraju">
												<xsd:annotation>
													<xsd:documentation>Kod kraju</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D4" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Podatnik - Kwota darowizny przekazanej obdarowanemu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_27" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 3. Wydatki na cele rehabilitacyjne oraz wydatki związane z ułatwieniem wykonywania czynności życiowych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_29" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 4. Zwrot nienależnie pobranych świadczeń, które uprzednio zwiększyły dochód podlegający opodatkowaniu (w kwotach uwzględniających podatek), jeżeli nie zostały one potrącone przez płatnika</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_31" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 5. Wydatki z tytułu użytkowania sieci Internet</xsd:documentation>
								</xsd:annotation>
								<!--Odliczenie przysługuje wyłącznie w kolejno po sobie następujących dwóch latach podatkowych.-->
								<xsd:simpleType>
									<xsd:restriction base="etd:TKwota2Nieujemna">
										<xsd:maxInclusive value="760"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_33" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 6. Wydatki na realizację przedsięwzięcia termomodernizacyjnego</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TKwota2Nieujemna">
										<xsd:maxInclusive value="53000"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_35" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 7. Wpłaty na indywidualne konto zabezpieczenia emerytalnego (IKZE)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_37" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 8. Składki członkowskie na rzecz związków zawodowych</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TKwota2Nieujemna">
										<xsd:maxInclusive value="500"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_39" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 9. Wydatki poniesione w ramach ulgi na zabytki</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TKwota2Nieujemna">
										<xsd:maxInclusive value="500000"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<!--Wiersz 11 w części B wypełnia się, jeżeli obowiązujące przepisy przewidują dokonanie odliczeń od dochodu (przychodu) z tytułów innych niż wymienione w wierszu od 1 do 10 części B, odpowiednio wiersz 5 w części C wypełnia się, jeżeli obowiązujące przepisy przewidują dokonanie odliczeń od podatku z tytułów innych niż wymienione w wierszu od 1 do 4 części C.-->
								<xsd:element name="P_43" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>11. Inne ulgi, niewymienione w wierszach od 1 do 10 - Rodzaj</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_44" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 11. Inne ulgi, niewymienione w wierszach od 1 do 10</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_46" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - Razem odliczenia od dochodu (przychodu)</xsd:documentation>
								</xsd:annotation>
								<!--Suma kwot z wierszy od 1 do 11. 
Kwotę z kolumny „podatnik" należy przenieść do poz. „podatnik” w wierszu „Odliczenia - wykazane w części B załącznika PIT/O” zeznania PIT-28, PIT-28S, PIT-36, PIT-36S, PIT-36L, PIT-36LS lub PIT-37.-->
							</xsd:element>
							<!--Suma kwot z wierszy od 1 do 5 w kolumnie „podatnik” oraz w kolumnie „małżonek”, nie może przekroczyć kwoty podatku, od którego jest odliczana.-->
							<xsd:element name="P_48" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 1. Ulga za wyszkolenie uczniów lub z tytułu zatrudnienia pracowników w celu przygotowania zawodowego, przyznana na podstawie decyzji</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_50" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 2. Składki na ubezpieczenia społeczne opłacone przez osobę prowadzącą gospodarstwo domowe z tytułu zawarcia umowy aktywizacyjnej z osobą bezrobotną</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_E" minOccurs="0" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Informacja o dzieciach uprawniających do ulgi na dzieci lub do ulgi dla rodzin 4+</xsd:documentation>
								</xsd:annotation>
								<!--W przypadku gdy część E załącznika PIT/O jest niewystarczająca do podania informacji o wszystkich dzieciach, należy wypełnić kolejny(e) załącznik(i) PIT/O, wykazując w nim(nich) identyfikator podatkowy (poz. 1 lub 2), numer załącznika (poz. 4) oraz brakujące informacje o dzieciach.-->
								<!-- -->
								<!--Ulga dla rodzin 4+ oznacza zwolnienie od podatku określone w art. 21 ust. 1 pkt 153 ustawy.-->
								<!-- -->
								<!--W odniesieniu do każdego dziecka należy podać jego numer PESEL. Jedynie w przypadku dzieci urodzonych za granicą i nieposiadających numeru PESEL, należy podać: imię, nazwisko oraz datę urodzenia dziecka. W przypadku podatników korzystających z ulgi dla rodzin 4+, należy wykazać co najmniej czworo dzieci. Jeżeli dziecko wykazywane jest wyłącznie dla potrzeb ulgi dla rodzin 4+, nie wypełnia się poz. 5-8. Jeżeli to samo dziecko uprawnia zarówno do ulgi dla rodzin 4+ oraz do ulgi na dzieci, kwadraty w poz. 9 lub 10 wypełnia się łącznie z poz. 5 i 7 (podatnik) oraz 6 i 8 (małżonek).-->
								<xsd:complexType>
									<xsd:sequence>
										<xsd:choice>
											<xsd:element name="P_E1" type="etd:TNrPESEL">
												<xsd:annotation>
													<xsd:documentation>PESEL</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:sequence>
												<xsd:element name="P_E2" type="etd:TImie">
													<xsd:annotation>
														<xsd:documentation>Pierwsze imię</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E3" type="etd:TNazwisko">
													<xsd:annotation>
														<xsd:documentation>Nazwisko</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E4" type="etd:TData">
													<xsd:annotation>
														<xsd:documentation>Data urodzenia</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
											</xsd:sequence>
										</xsd:choice>
										<xsd:element name="P_E9" type="etd:TWybor1">
											<xsd:annotation>
												<xsd:documentation>Podatnik. Ulga dla rodzin 4+. Wartość: 1 - tak</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="P_55" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 4. Ulga abolicyjna, o której mowa w art. 27g ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<!--Wiersz ósmy w części B wypełnia się, jeżeli obowiązujące przepisy przewidują dokonanie odliczeń od dochodu (przychodu) z tytułów innych niż wymienione w wierszu od 1 do 7 części B, odpowiednio wiersz piąty w części C wypełnia się, jeżeli obowiązujące przepisy przewidują dokonanie odliczeń od podatku z tytułów innych niż wymienione w wierszu od 1 do 4 części C. W wierszu 8 w części B wykazuje się m.in. wydatki dotyczące zewnętrznego systemu lokalizacyjnego lub urządzenia pokładowego (tzw. ulga e-Toll) odliczane w zeznaniu PIT-28S, PIT-36, PIT-36S, PIT-36L, PIT-36LS (ulgę e-Toll odliczaną w zeznaniu PIT-28, wykazuje się bezpośrednio w tym zeznaniu). Odliczenie z tytułu ulgi e-Toll nie może przekroczyć kwoty przychodu, o którym mowa w art. 57aa ustawy o ryczałcie lub kwoty dochodu, o którym mowa w art. 52ja ustawy.-->
								<xsd:element name="P_57" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Inne ulgi, niewymienione w wierszach od 1 do 4 - Rodzaj</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_58" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 5. Inne ulgi, niewymienione w wierszach od 1 do 4</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_60" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Podatnik - Razem odliczenia od podatku</xsd:documentation>
								</xsd:annotation>
								<!--Suma kwot z wierszy od 1 do 5. Kwotę z kolumny „podatnik" należy przenieść do poz. „podatnik” w wierszu „Odliczenia - wykazane w części C załącznika PIT/O” zeznania PIT-28, PIT-28S, PIT-36, PIT-36S, PIT-36L, PIT-36LS lub PIT-37.-->
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
		<xsd:unique name="klucz_NIP_PESEL">
			<xsd:selector xpath="zo28:Podmiot1|zo28:Podmiot2"/>
			<xsd:field xpath="etd:NIP|etd:PESEL"/>
		</xsd:unique>
	</xsd:element>
</xsd:schema>
