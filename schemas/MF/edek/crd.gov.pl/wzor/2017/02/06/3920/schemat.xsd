<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czbr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/05/12/eD/CITBR/" xmlns:czd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/CITD/" xmlns:czmt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SPRMT/" xmlns:czst="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/01/10/eD/CITSTZ/" xmlns:cz8o="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/CIT8O/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" xmlns:ssr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SSER/" xmlns:tns="http://crd.gov.pl/wzor/2017/02/06/3920/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/" targetNamespace="http://crd.gov.pl/wzor/2017/02/06/3920/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/01/10/eD/CITSTZ/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2017/01/10/eD/CITSTZ/CIT-ST(7)_Z_v4-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SSER/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SSER/SSE-R(5)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/CIT8O/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/CIT8O/CIT-8_O(11)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/05/12/eD/CITBR/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/05/12/eD/CITBR/CIT-BR(1)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/CITD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/CITD/CIT-D(5)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SPRMT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/04/21/eD/SPRMT/SPR_MT(1)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/ORD-ZU(3)_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/StrukturyDanych_v4-0E.xsd"/>
	<!--Rokiem podatkowym jest rok kalendarzowy lub w przypadku, o którym mowa w art. 8 ust.1 ustawy, okres kolejnych dwunastu miesięcy, z uwzględnieniem art. 8 ust. 2, 2a, 3 i 6 ustawy.-->
	<!-- -->
	<!--Ilekroć w zeznaniu jest mowa o urzędzie skarbowym, w tym urzędzie skarbowym do którego adresowane jest zeznanie - oznacza to urząd skarbowy, przy pomocy którego właściwy dla podatnika naczelnik urzędu skarbowego wykonuje swoje zadania.-->
	<!-- -->
	<!--Zgodnie z art. 81 ustawy z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2015 r. poz. 613, z późn. zm.).-->
	<!-- -->
	<!--Należy podać rok kalendarzowy, w którym podatnik rozpoczął rok podatkowy objęty zwolnieniem, o którym mowa w art. 25 ust. 11 - 16 ustawy.-->
	<!-- -->
	<!--Podatnicy rozliczający zaliczki miesięczne wypełniają odpowiednio pozycje w zakresie poszczególnych miesięcy (od 1 do 23), a podatnicy rozliczający zaliczki kwartalne pozycje w zakresie zaliczek kwartalnych (3, 6, 9, 12, 15, 18 i 21).-->
	<!-- -->
	<!--Jeżeli podatnik składa zeznanie:
a) w terminie do 20 dnia pierwszego miesiąca następnego roku podatkowego - w poz. 94 powinien uwzględnić wyłącznie zaliczki wpłacone do końca tego roku podatkowego, za który jest składane zeznanie,
b) w terminie do końca trzeciego miesiąca roku następnego - w poz. 94 powinien uwzględnić zaliczki wpłacone do końca roku podatkowego oraz za ostatni miesiąc (kwartał) zaliczkę wpłaconą do 20 dnia pierwszego miesiąca roku następnego.-->
	<!-- -->
	<!--Podatek według stawki z poz. 62, obliczony od dokonanego w danym miesiącu wydatku - wpłacany jest do 20 dnia miesiąca nastepującego po miesiącu, w którym dokonano wydatku lub w którym upłynął termin do wydatkowania dochodu.-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT-8 (24)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="3-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="24"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_7"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-8"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2016-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>ZEZNANIE O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) PRZEZ PODATNIKA PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TOsobaNiefizyczna">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="tns:PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dodatkowe, informacja o załącznikach, ustalenie dochodu/straty, ustalenie podstawy opodatkowania/straty, kwoty należnych zaliczek miesięcznych lub zaliczek kwartalnych, różnica pomiędzy podatkiem należnym a należnymi zaliczkami, kwota do zapłaty/nadpłata, odrębnne oraz inne zobowiązania podatkowe</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Pouczenia">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższych pouczeń:
								Niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz. U. z 2014 r. poz. 1619, z późn. zm.), na odsetki od wykazanych i nieuiszczonych w obowiązujących terminach lub uiszczonych w niepełnej wysokości kwot z poz. 68 - 90.
W przypadku niewpłacenia w obowiązujących terminach kwot z poz. 95, 103 - 108, 115 - 120, 127 - 132, 138 - 142, 144 i 145 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego, zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz. U. z 2014 r. poz. 1619, z późn. zm.).

Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie podatku na uszczuplenie grozi odpowiedzialnośc przewidziana w Kodeksie karnym skarbowym.
								</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence minOccurs="0">
							<xsd:element ref="czst:Zalacznik_CIT-ST" minOccurs="0"/>
							<xsd:element ref="ssr:Zalacznik_SSE-R" minOccurs="0"/>
							<xsd:element ref="cz8o:Zalacznik_CIT-8_O" minOccurs="0"/>
							<xsd:element ref="czbr:Zalacznik_CIT-BR" minOccurs="0"/>
							<xsd:element ref="czd:Zalacznik_CIT-D" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="czmt:Zalacznik_SPR_MT" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PozycjeSzczegolowe">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="P_20" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>Podatnik wniósł do spółki wkład niepieniężny w postaci komercjalizowanej własności intelektualnej, o którym mowa w art. 12 ust. 1b pkt 5 ustawy, w roku podatkowym wskazanym w poz. OkresOd i OkresDo. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_21" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>Podatnik uwzględnia odsetki w kosztach uzyskania przychodów zgodnie z art. 15c ustawy, w roku podatkowym wskazanym w poz. OkresOd i OkresDo. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_22" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwota odsetek wyłączonych z kosztów uzyskania przychodów</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_23" type="etd:TWybor1_3">
					<xsd:annotation>
						<xsd:documentation>Podatnik korzysta ze zwolnienia lub utracił prawo do zwolnienia, o którym mowa w art. 25 ust. 11-16 ustawy, w roku podatkowym wskazanym w poz. OkresOd i OkresDo. Wybór: 1 - tak, 2 - utracił prawo do zwolnienia w związku z art. 25 ust. 14 ustawy, 3 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_24" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>Podatnik był obowiązany do sporządzenia dokumentacji, o której mowa w art. 9a ust. 1 ustawy. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_25" type="etd:TWybor1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Informacja o załącznikach CIT-ST</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_26" type="etd:TWybor1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Informacja o załącznikach SSE-R</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_27" type="etd:TWybor1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Informacja o załącznikach CIT-8/O</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_28" type="etd:TWybor1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Informacja o załącznikach CIT-BR</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_29" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Informacja o załącznikach CIT-D</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="0"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_30" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Sprawozdanie o realizacji uznanej metody ustalania ceny transakcyjnej</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="0"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence>
					<xsd:element name="P_31" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Przychody ze źródeł przychodów położonych na terytorium RP</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_32" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_33" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP - inne niż wymienione w poz. 32</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_34" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Przychody uzyskane w następstwie wniesienia do spółki wkładu niepieniężnego w postaci komercjalizowanej własności intelektualnej, które w związku z art. 12 ust. 1b pkt 5 ustawy podlegają wykazaniu w roku podatkowym wskazanym w poz. OkresOd i OkresDo</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_35" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Razem przychody</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_36" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Koszty uzyskania przychodów wymienionych w poz. 31</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_37" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Koszty uzyskania przychodów wymienionych w poz. 32</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_38" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Koszty uzyskania przychodów wymienionych w poz. 33</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_39" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Koszty uzyskania przychodów wymienionych w poz. 34</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_40" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Odsetki wyłączone w poprzednich pięciu latach podatkowych z kosztów uzyskania przychodów, podlegające na podstawie art. 15c ustawy zaliczeniu do kosztów uzyskania przychodów w roku podatkowym wskazanym w poz. OkresOd i OkresDo</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_41" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Razem koszty uzyskania przychodów</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:choice>
					<xsd:element name="P_42" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Dochód (art. 7 ust. 2 ustawy)</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_43" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Strata (art. 7 ust. 2 ustawy)</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:choice>
				<xsd:element name="P_44" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Strata w związku z postanowieniami art. 7 ust. 3-4a ustawy oraz strata ze źródeł przychodów wykazanych w poz. 33, podlegająca za granicą odliczeniu od dochodu do opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_45" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Dochód</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_46" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Strata</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dochody (przychody) wolne i odliczenia</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_47" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Razem dochody (przychody) wolne</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_48" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Razem odliczenia od dochodu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_49" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Odliczenia z tytułu wydatków inwestycyjnych</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_50" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Razem dochody (przychody) wolne i odliczenia</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_51" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Podstawa opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_52" type="etd:TKwota2Nieujemna" minOccurs="0">
