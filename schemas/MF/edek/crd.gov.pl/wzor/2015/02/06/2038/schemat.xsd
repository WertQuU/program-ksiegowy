<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://crd.gov.pl/wzor/2015/02/06/2038/" xmlns:czd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/01/09/eD/CITD/" xmlns:czmt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/SPRMT/" xmlns:czst="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/01/14/eD/CITSTZ/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/10/07/eD/ORDZU/" targetNamespace="http://crd.gov.pl/wzor/2015/02/06/2038/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/01/09/eD/CITD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/01/09/eD/CITD/CIT-D(4)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/01/14/eD/CITSTZ/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/01/14/eD/CITSTZ/CIT-ST(7)_Z_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/StrukturyDanych_v3-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/SPRMT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/SPRMT/SPR_MT(1)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/10/07/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/10/07/eD/ORDZU/ORD-ZU(2)_v2-0E.xsd"/>
	<!--Ilekroć jest mowa o urzędzie skarbowym - oznacza to urząd skarbowy, o którym mowa w ustawie.-->
	<!-- -->
	<!--Zgodnie z art. 81 ustawy z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2012 r. poz. 749, z późn. zm.) podatnik może skorygować złożoną deklarację poprzez złożenie deklaracji korygującej wraz z dołączonym pisemnym uzasadnieniem przyczyn korekty.-->
	<!-- -->
	<!--Jeżeli podatnik składa zeznanie:
a) w terminie do 20 dnia pierwszego miesiąca następnego roku podatkowego - w poz. 78 powinien uwzględnić wyłącznie zaliczki wpłacone do końca tego roku podatkowego, za który jest składane zeznanie,
b) w terminie do końca trzeciego miesiąca roku następnego - w poz. 78 powinien uwzględnić zaliczki wpłacone do końca roku podatkowego oraz za ostatni miesiąc (kwartał) zaliczkę wpłaconą do 20 dnia pierwszego miesiąca roku następnego.-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT-8A (9)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="9"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_7"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="TLDataP">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="TLDataK">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-8A"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLDataP">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty od</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:minInclusive value="2013-03-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLDataK">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty do</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:minInclusive value="2015-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>ZEZNANIE O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) PRZEZ PODATKOWĄ GRUPĘ KAPITAŁOWĄ - PODATNIKA PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TOsobaNiefizyczna">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Grupa Kapitałowa"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Ustalenie podstawy opodatkowania i należnego podatku, kwoty należnych zaliczek miesięcznych lub zaliczek kwartalnych, różnica pomiędzy podatkiem należnym a należnymi zaliczkami, kwota do zapłaty / nadpłata, inne zobowiązania podatkowe, dane spółki reprezentującej podatkową grupę kapitałową</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Pouczenie1">
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:enumeration value="Niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz. U. z 2014 r. poz. 1619) na odsetki od wykazanych i nieuiszczonych w obowiązujących terminach lub uiszczonych w niepełnej wysokości kwot z poz. 52 - 74."/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Pouczenie2">
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:enumeration value="W przypadku niewpłacenia w obowiązujących terminach kwot z poz. 79 i 81 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz. U. z 2014 r. poz. 1619)."/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Pouczenie3">
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:enumeration value="Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie na uszczuplenie podatku grozi odpowiedzialnośc przewidziana w Kodeksie karnym skarbowym."/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="czd:Zalacznik_CIT-D" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="czst:Zalacznik_CIT-ST" minOccurs="0"/>
							<xsd:element ref="czmt:Zalacznik_SPR_MT" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PozycjeSzczegolowe">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="P_19" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT-ST</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_20" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT-D</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_21" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Sprawozdanie o realizacji uznanej metody ustalania ceny transakcyjnej</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_22" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>Grupa kapitałowa była obowiązana do sporządzenia dokumentacji, o której mowa w art. 9a ust. 1 ustawy. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_23" type="etd:TKwotaCNieujemna">
					<xsd:annotation>
						<xsd:documentation>Łączny kapitał zakładowy spółek wchodzących w skład podatkowej grupy kapitałowej na ostatni dzień roku podatkowego</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_24" type="etd:TKwotaCNieujemna">
					<xsd:annotation>
						<xsd:documentation>Suma przychodów wszystkich spółek tworzących podatkową grupę kapitałową - art. 1a ust. 2 pkt 4 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_25" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Suma dochodów spółek wchodzących w skład podatkowej grupy kapitałowej - art. 7a ust. 1 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_26" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Suma strat spółek wchodzących w skład podatkowej grupy kapitałowej - art. 7a ust. 1 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:choice>
					<xsd:element name="P_27" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Dochód - art. 7a ust. 1 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_28" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Strata - art. 7a ust. 1 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:choice>
				<xsd:element name="P_29" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia darowizn zgodnie z art. 18 ust. 1 pkt 1 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_30" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia darowizn na cele kultu religijnego, zgodnie z art. 18 ust. 1 pkt 7 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_31" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia darowizn na podstawie odrębnych ustaw</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_32" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Ogółem odliczenia darowizny</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_33" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Inne odliczenia od dochodu - Tytuł</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_34" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Inne odliczenia od dochodu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_35" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Razem odliczenia od dochodu</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_36" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Podstawa opodatkowania - art. 18 ust. 1 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_37" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Wydatki na nabycie nowej technologii</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_38" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota odliczonych wydatków - w związku z utratą prawa do odliczeń</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_39" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>z tego kwota zwiększająca podstawę opodatkowania</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_40" type="etd:TKwota2Nieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>z tego kwota zmniejszająca stratę</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_41" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwota dochodu osiągniętego poza terytorium RP podlegająca opodatkowaniu łącznie z dochodami osiągniętymi na terytorium RP - art. 20 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_42" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Razem kwota zwiększająca podstawę opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_43" type="etd:TKwotaCNieujemna">
					<xsd:annotation>
						<xsd:documentation>Podstawa opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_44" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Strata</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_45">
					<xsd:annotation>
						<xsd:documentation>Stawka podatku - art. 19 ustawy</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TProcentowy">
							<xsd:maxInclusive value="19"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_46" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Podatek według stawki z poz. 45, obliczony od kwoty z poz. 43</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_47" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia od podatku zgodnie z art. 20 ustawy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_48" type="etd:TZnakowy">
						<xsd:annotation>
							<xsd:documentation>Obniżki z innych tytułów - Tytuł</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_49" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Obniżki z innych tytułów</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:element name="P_50" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Ogółem obniżki i odliczenia od podatku</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_51" type="etd:TKwotaCNieujemna">
					<xsd:annotation>
						<xsd:documentation>Podatek należny za rok podatkowy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwoty należnych zaliczek miesięcznych (art. 25 ust. 1, 1a oraz 6 ustawy) lub zaliczek kwartalnych (art. 25 ust. 1b i 1c ustawy)</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_52" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 1</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_53" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 2</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_54" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 3/1 kwartał</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_55" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 4</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_56" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 5</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_57" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 6/2 kwartał</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_58" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 7</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_59" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 8</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_60" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 9/3 kwartał</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_61" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 10</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_62" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
