<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:cz8sp="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CIT8SP/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CIT8SP/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/StrukturyDanych_v4-0E.xsd"/>
	<!--Załącznik do zeznań: CIT-8 i CIT-8AB.-->
	<!-- -->
	<!--Formularz przeznaczony jest dla podatników podatku dochodowego od osób prawnych będących wspólnikami spółek niebędących osobą prawną, w rozumieniu ustawy, które są beneficjentami pomocy. Formularz stosuje się również do wspólników spółek cywilnych.-->
	<!-- -->
	<!--Zgodnie z art. 1 ustawy podatnikami podatku dochodowego od osób prawnych są:
   - osoby prawne i spółki kapitałowe w organizacji;
   - jednostki organizacyjne niemające osobowości prawnej, z wyjątkiem spółek niemających osobowości prawnej;
   - spółki komandytowo-akcyjne;
   - spółki niemające osobowości prawnej, mające siedzibę lub zarząd w innym państwie, jeżeli zgodnie przepisami prawa podatkowego tego państwa są traktowane jako osoby prawne i podlegają w tym państwie opodatkowaniu od całości swoich dochodów bez względu na miejsce ich osiągania.-->
	<xsd:complexType name="TNaglowek_CIT_8SP">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8sp:TKodFormularza_CIT_8SP">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT8SP (1)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8sp:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8sp:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2018-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_8SP">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/8SP"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TProcentowy">
		<xsd:annotation>
			<xsd:documentation>Wartość procentowa z dokładnością do 2 miejsc po przecinku</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="4"/>
			<xsd:fractionDigits value="2"/>
			<xsd:minInclusive value="0"/>
			<xsd:maxExclusive value="100"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_8SP">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI DOCHODU OSIĄGNIĘTEGO Z DZIAŁALNOŚCI GOSPODARCZEJ PROWADZONEJ NA TERENIE SPECJALNEJ STREFY EKONOMICZNEJ NA PODSTAWIE ZEZWOLENIA</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="cz8sp:TNaglowek_CIT_8SP"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacje dotyczące posiadanych zezwoleń, ustalenie wielkości dochodu podlegającego zwolnieniu z opodatkowania z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie posiadanych zezwoleń, informacje dotyczące cofniętego zezwolenia, wielkość kosztów kwalifikowanych, rozliczanych w ramach ulgi B+R</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_B" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Informacje dotyczące posiadanych zezwoleń</xsd:documentation>
								</xsd:annotation>
								<!--Należy wskazać wszystkie zezwolenia, na podstawie których przedsiębiorca prowadził działalność gospodarczą na terenie specjalnej strefy ekonomicznej lub na terenie specjalnych stref ekonomicznych, na podstawie zezwolenia niezależnie od okresu obowiązywania tych zezwoleń. W przypadku spółki cywilnej należy podać informacje o zezwoleniach uzyskanych przez spółkę cywilną lub jej wspólników.-->
								<xsd:complexType>
									<xsd:sequence>
										<xsd:sequence>
											<xsd:annotation>
												<xsd:documentation>Dane identyfikacyjne przedsiębiorcy posiadającego zezwolenie</xsd:documentation>
											</xsd:annotation>
											<xsd:element name="P_B8" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer zezwolenia</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B9"  type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wydania zezwolenia</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B10"  type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data rozpoczęcia działalności</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B11">
												<xsd:annotation>
													<xsd:documentation>Nazwa pełna</xsd:documentation>
												</xsd:annotation>
												<xsd:simpleType>
													<xsd:restriction base="xsd:token">
														<xsd:minLength value="1"/>
														<xsd:maxLength value="240"/>
													</xsd:restriction>
												</xsd:simpleType>
											</xsd:element>
											<xsd:element name="P_B12" type="etd:TNrNIP">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B13" type="cz8sp:TProcentowy">
												<xsd:annotation>
													<xsd:documentation>Udział przedsiębiorcy w spółce niebędącej osobą prawną</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<xsd:element name="P_B14" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Maksymalna wartość pomocy publicznej - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B15" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Maksymalna wartość pomocy publicznej - zdyskontowana wartość pomocy publicznej na dzień uzyskania zezwolenia</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<xsd:element name="P_B16" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty kwalifikujące się do objęcia pomocą publiczną - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B17" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty kwalifikujące się do objęcia pomocą publiczną - zdyskontowana wartość pomocy publicznej na dzień uzyskania zezwolenia</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<xsd:element name="P_B18" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Pomoc udzielona na podstawie ustawy w ramach zezwolenia z poz. 8 - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B19" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Pomoc udzielona na podstawie ustawy w ramach zezwolenia z poz. 8 - zdyskontowana wartość pomocy publicznej na dzień uzyskania zezwoleniać</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<!--Należy wskazać wsparcie uzyskane na inwestycję, na którą wydane jest zezwolenie.-->
											<xsd:element name="P_B20" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Inne wsparcie objęte pomocą - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B21" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Inne wsparcie objęte pomocą - zdyskontowana wartość pomocy publicznej na dzień uzyskania zezwolenia</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
							<xsd:sequence>
								<xsd:element name="P_C" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Ustalenie wielkości dochodu podlegającego zwolnieniu z opodatkowania z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie posiadanych zezwoleń. Informacje dotyczące zezwolenia</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_C22" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer zezwolenia</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C23"  type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wydania zezwolenia</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C24" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Przychody z działalności gospodarczej określonej w zezwoleniach</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C25" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty uzyskania przychodów z działalności gospodarczej określonej w zezwoleniach</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C26" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Dochód z działalności gospodarczej określonej w zezwoleniach</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C27" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Strata z działalności gospodarczej określonej w zezwoleniach</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_28" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Razem kwota dochodu podlegająca zwolnieniu z opodatkowania</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:element name="P_D" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Informacje dotyczące cofniętego zezwolenia</xsd:documentation>
									</xsd:annotation>
									<!--Należy wykazać dane, które zgodnie z art. 70 ustawy z dnia 29 sierpnia 1997 r. Ordynacja podatkowa (Dz. U. z 2018 r. poz. 800, z późn. zm.) nie uległy przedawnieniu.-->
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D29" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer cofniętego zezwolenia</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D30" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data cofniętego zezwolenia</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D31" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Kwota zapłaconego podatku w związku z cofnięciem zezwolenia, uiszczonego w rozliczeniu zaliczki za wybrany okres wpłaty zaliczek</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D32" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Dochód zwolniony z działalności gospodarczej określonej w cofniętym zezwoleniu, podlegający doliczeniu do podstawy opodatkowania w zeznaniu rocznym</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_33" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Razem kwota dochodu podlegającego doliczeniu do podstawy opodatkowania</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_34" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota kosztów kwalifikowanych odliczonych od podstawy opodatkowania w ramach ulgi B+R</xsd:documentation>
									</xsd:annotation>
									<!--Podatnicy uzyskujący przychody inne, niż przychody z zysków kapitałowych mogą odliczyć od podstawy opodatkowania koszty uzyskania przychodów poniesione na działalność badawczo-rozwojową (koszty kwalifikowane) na podstawie art.18d ustawy.-->
								</xsd:element>
								<xsd:element name="P_35" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Numer zezwolenia</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
