<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://crd.gov.pl/wzor/2014/01/02/1446/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" xmlns:cz8o="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/CIT8O/" xmlns:czd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/CITD/" xmlns:czmt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/SPRMT/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/10/07/eD/ORDZU/" xmlns:ssr="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/12/eD/SSER/" xmlns:czst="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2013/12/18/eD/CITSTZ/" targetNamespace="http://crd.gov.pl/wzor/2014/01/02/1446/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/CIT8O/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/CIT8O/CIT-8_O(8)_Z_v3-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/CITD/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/CITD/CIT-D(3)_Z_v3-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/12/eD/SSER/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/12/eD/SSER/SSE-R(4)_Z_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2013/12/18/eD/CITSTZ/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2013/12/18/eD/CITSTZ/CIT-ST(7)_Z_v1-2E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/StrukturyDanych_v3-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/10/07/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/10/07/eD/ORDZU/ORD-ZU(2)_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/SPRMT/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2012/01/19/eD/SPRMT/SPR_MT(1)_Z_v1-0E.xsd"/>
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT-8 (21)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="3-2E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="21"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_7"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="TLDataOd">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="TLDataDo">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-8"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLDataOd">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty od</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:minInclusive value="2009-11-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLDataDo">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty do</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date">
			<xsd:minInclusive value="2011-09-30"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>ZEZNANIE O WYSOKOŚCI OSIĄGNIĘTEGO DOCHODU (PONIESIONEJ STRATY) PRZEZ PODATNIKA PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TOsobaNiefizyczna">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach, ustalenie dochodu/straty, ustalenie podstawy opodatkowania/straty, kwoty należnych zaliczek miesięcznych, różnica pomiędzy podatkiem należnym a należnymi zaliczkami, kwota do zapłaty/nadpłata, inne zobowiązania podatkowe</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Pouczenie1">
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:enumeration value="Niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz.U. z 2005 r. Nr 229, poz.1954, ze zm.), na odsetki od wykazanych i nieuiszczonych w obowiązujących terminach lub uiszczonych w niepełnej wysokości kwot z poz.59-81 i poz.83-90."/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Pouczenie2">
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:enumeration value="W przypadku niewpłacenia w obowiązujących terminach kwot z poz.95, 98, 99 i 100 lub wpłacenia ich w niepełnej wysokości niniejsze zeznanie stanowi podstawę do wystawienia tytułu wykonawczego, zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz.U. z 2005 r. Nr 229, poz.1954, ze zm.)."/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Oswiadczenie">
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:enumeration value="Oświadczam, że są mi znane przepisy Kodeksu karnego skarbowego o odpowiedzialności za podanie danych niezgodnych z rzeczywistością i przez to narażenie na uszczuplenie podatku."/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="cz8o:Zalacznik_CIT-8_O" minOccurs="0"/>
							<xsd:element ref="czd:Zalacznik_CIT-D" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="ssr:Zalacznik_SSE-R" minOccurs="0"/>
							<xsd:element ref="czst:Zalacznik_CIT-ST" minOccurs="0"/>
							<xsd:element ref="czmt:Zalacznik_SPR_MT" minOccurs="0" maxOccurs="unbounded"/>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PozycjeSzczegolowe">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="P_20" type="etd:TWybor1_3">
					<xsd:annotation>
						<xsd:documentation>Podatnik korzysta ze zwolnienia lub utracił prawo do zwolnienia, o którym mowa w art.25 ust.11-16 ustawy, w roku podatkowym wykazanym w poz.4 i 5. Wybór: - 1. tak, 2. utracił prawo do zwolnienia w związku z art.25 ust.14 ustawy, 3. nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_21" type="etd:TWybor1_2">
					<xsd:annotation>
						<xsd:documentation>Podatnik był obowiązany do sporządzenia dokumentacji, o której mowa w art.9a ust.1 ustawy. Wybór: 1 - tak, 2 - nie</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_22" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT-ST</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_23" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach SSE-R</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_24" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT-8/O</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_25" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Informacja o załącznikach CIT-D</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_26" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Sprawozdanie o realizacji uznanej metody ustalania ceny transakcyjnej</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TNaturalny">
							<xsd:minInclusive value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_27" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Przychody ze źródeł przychodów położonych na terytorium RP</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_28" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_29" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP - inne niż wymienione w poz.28</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Razem przychody</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_31" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Koszty uzyskania przychodów wymienionych w poz.27</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_32" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Koszty uzyskania przychodów wymienionych w poz.28</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_33" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Koszty uzyskania przychodów wymienionych w poz.29</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_34" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Razem koszty uzyskania przychodów</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:choice>
					<xsd:element name="P_35" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Dochód (art.7 ust.2 ustawy)</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_36" type="etd:TKwota2Nieujemna">
						<xsd:annotation>
							<xsd:documentation>Strata (art.7 ust.2 ustawy)</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:choice>
				<xsd:element name="P_37" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Strata w związku z postanowieniami art.7 ust.3-4a ustawy oraz strata ze źródeł przychodów wykazanych w poz.29, podlegająca za granicą odliczeniu od dochodu do opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_38" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Dochód</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_39" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Strata</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_40" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Razem dochody (przychody) wolne</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_41" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Razem odliczenia od dochodu</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_42" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia z tytułu wydatków inwestycyjnych</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_43" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Razem dochody (przychody) wolne i odliczenia</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_44" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Podstawa opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_45" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Strata</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_46" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia zmniejszające podstawę opodatkowania z tytułu wydatków na nabycie nowej technologii</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_47" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwota odliczonych w poprzednich latach wydatków inwestycyjnych - w związku z utratą prawa do odliczeń</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_48" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwota zwolnionych od podatków dochodów uzyskanych z działalności gospodarczej prowadzonej na terenie specjalnej strefy ekonomicznej - w związku z utratą prawa do zwolnienia</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_49" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwota odliczonych wydatków z tytułu nabycia nowych technologii - w związku z utratą prawa do odliczeń</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_50" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Razem kwota zwiększająca podstawę opodatkowania / zmniejszająca stratę</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_51" type="etd:TKwotaCNieujemna">
					<xsd:annotation>
						<xsd:documentation>Podstawa opodatkowania</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_52" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Strata</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_53">
					<xsd:annotation>
						<xsd:documentation>Stawka podatku - art.19 ustawy</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TProcentowy">
							<xsd:maxInclusive value="19"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="P_54" type="etd:TKwota2Nieujemna">
					<xsd:annotation>
						<xsd:documentation>Podatek należny według stawki z poz.53, obliczony od kwoty z poz.51</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_55" type="etd:TKwota2Nieujemna" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Odliczenia od podatku</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="P_56" type="etd:TKwotaCNieujemna">
					<xsd:annotation>
						<xsd:documentation>Podatek należny po odliczeniach za rok podatkowy wykazany w poz.4 i 5</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_57">
						<xsd:annotation>
							<xsd:documentation>Rok</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TRok">
								<xsd:minInclusive value="2003"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_58" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>20% należnego podatku wykazanego w zeznaniu składanym za rok podatkowy objęty zwolnieniem, o którym mowa w art.25 ust.11-16 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Kwoty należnych zaliczek miesięcznych - zgodnie z art.25 ust.1 i 1a ustawy</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_59" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 1</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_60" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 2</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_61" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 3</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_62" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota należnej zaliczki za miesiąc 4</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
