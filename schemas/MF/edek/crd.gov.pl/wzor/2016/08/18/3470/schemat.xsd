						<xsd:annotation>
							<xsd:documentation>Informacje o załącznikach - Liczba załączników Sprawozdanie o realizacji uznanej metody ustalania ceny transakcyjnej</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:choice minOccurs="0">
					<xsd:sequence>
						<xsd:element name="P_335" type="etd:TWybor1">
							<xsd:annotation>
								<xsd:documentation>Informacje o załącznikach - Liczba załączników PIT/D</xsd:documentation>
							</xsd:annotation>
						</xsd:element>
						<xsd:element name="P_336" type="etd:TWybor1" minOccurs="0">
