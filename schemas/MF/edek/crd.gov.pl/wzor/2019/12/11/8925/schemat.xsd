<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" xmlns:tns="http://crd.gov.pl/wzor/2019/12/11/8925/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/ORDZU/" targetNamespace="http://crd.gov.pl/wzor/2019/12/11/8925/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/ORDZU/ORD-ZU(3)_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/StrukturyDanych_v5-0E.xsd"/>
	<!--Ilekroć w deklaracji jest mowa o urzędzie skarbowym, w tym urzędzie skarbowym do którego adresowana jest deklaracja - oznacza to urząd skarbowy, przy pomocy którego właściwy dla podatnika naczelnik urzędu skarbowego wykonuje swoje zadania.-->
	<!-- -->
	<!--„Miesiąc” - liczby od 1 do 23 oznaczają kolejne miesiące roku podatkowego, w tym również u płatnika, którego rok podatkowy jest inny niż kalendarzowy.-->
	<!-- -->
	<!--Wynagrodzenie z tytułu terminowego wpłacania podatku dochodowego za poszczególne miesiące, zgodnie z art. 28 Ordynacji podatkowej.-->
	<!-- -->
	<!--Od kwoty pobranego podatku za poszczególne miesiące należy odpowiednio odjąć kwoty wynagrodzenia z tytułu terminowego wpłacania podatku. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT10Z (5)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="P"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="5"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_7"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-10Z"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2019-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>DEKLARACJA O WYSOKOŚCI POBRANEGO PRZEZ PŁATNIKA ZRYCZAŁTOWANEGO PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH, OD DOCHODÓW (PRZYCHODÓW) OSIĄGNIĘTYCH PRZEZ PODATNIKÓW NIEMAJĄCYCH SIEDZIBY LUB ZARZĄDU NA TERYTORIUM RZECZYPOSPOLITEJ POLSKIEJ</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek"/>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TPodmiotDowolnyBezAdresu3">
								<xsd:sequence>
									<xsd:element name="AdresZamieszkaniaSiedziby">
										<xsd:complexType>
											<xsd:complexContent>
												<xsd:extension base="etd:TAdres1">
													<xsd:attribute name="rodzajAdresu" type="xsd:string" use="required" fixed="RAD"/>
												</xsd:extension>
											</xsd:complexContent>
										</xsd:complexType>
									</xsd:element>
									<xsd:element name="InneNiezbedneOznaczenia" minOccurs="0">
										<xsd:complexType>
											<xsd:simpleContent>
												<xsd:extension base="etd:TZnakowy">
													<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_22"/>
												</xsd:extension>
											</xsd:simpleContent>
										</xsd:complexType>
									</xsd:element>
								</xsd:sequence>
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Płatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="tns:PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Zobowiązanie podatkowe z tytułu wypłat, o których mowa w art. 21 ust. 1 oraz w art. 7b ust. 1 pkt 3-6 ustawy, zobowiązanie podatkowe z tytułu udziału w zyskach osób prawnych, o których mowa w art. 22 ust. 1 ustawy, informacje uzupełniające</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Pouczenia">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższych pouczeń:
					W przypadku niewpłacenia w obowiązującym terminie kwot z poz. 57-62, 81-86, 105-110, 129-133, 155-160, 179-184, 203-208 i 227-231 lub wpłacenia ich w niepełnej wysokości niniejsza deklaracja stanowi podstawę do wystawienia tytułu wykonawczego zgodnie z przepisami ustawy z dnia 17 czerwca 1966 r. o postępowaniu egzekucyjnym w administracji (Dz. U. z 2019 r. poz. 1438, z późn. zm.). 

Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie na uszczuplenie podatku grozi odpowiedzialność przewidziana w Kodeksie karnym skarbowym.
						</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence minOccurs="0">
							<xsd:element ref="zzu:Zalacznik_ORD-ZU"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="PozycjeSzczegolowe">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="P_7A" type="etd:TWybor1_2" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Rodzaj korekty. Wartość: 1 - korekta deklaracji, o której mowa w art. 81 Ordynacji podatkowej, 2 - korekta deklaracji, o której mowa w art. 81b § 1a Ordynacji podatkowej</xsd:documentation>
					</xsd:annotation>
					<!--Ilekroć mowa o Ordynacji podatkowej, oznacza to ustawę z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2019 r. poz. 900, z późn. zm.).-->
					<!-- -->
					<!--Ad. wartość 2 - Korekta składana w toku postępowania podatkowego w sprawie unikania opodatkowania; korektę składa się wraz z uzasadnieniem przyczyn korekty.-->
				</xsd:element>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Tytuły wypłat należności</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_8" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tytuł wypłaty - przychody (wypłaty) z tytułów, o których mowa w art. 7b ust. 1 pkt 3-6 ustawy, w związku z art. 26 ust. 1m ustawy: 0 - nie, 1 - tak</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:byte">
								<xsd:enumeration value="0">
									<xsd:annotation>
										<xsd:documentation>nie</xsd:documentation>
									</xsd:annotation>
								</xsd:enumeration>
								<xsd:enumeration value="1">
									<xsd:annotation>
										<xsd:documentation>tak</xsd:documentation>
									</xsd:annotation>
								</xsd:enumeration>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_9" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tytuł wypłaty - przychody (wypłaty) z tytułów, o których mowa w art. 21 ust. 1 ustawy: 0 - nie, 1 - tak</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:byte">
								<xsd:enumeration value="0">
									<xsd:annotation>
										<xsd:documentation>nie</xsd:documentation>
									</xsd:annotation>
								</xsd:enumeration>
								<xsd:enumeration value="1">
									<xsd:annotation>
										<xsd:documentation>tak</xsd:documentation>
									</xsd:annotation>
								</xsd:enumeration>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_10" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tytuł wypłaty - dywidendy oraz dochody (przychody) z udziału w zyskach osób prawnych, o których mowa w art. 22 ust. 1 ustawy: 0 - nie, 1 - tak</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:byte">
								<xsd:enumeration value="0">
									<xsd:annotation>
										<xsd:documentation>nie</xsd:documentation>
									</xsd:annotation>
								</xsd:enumeration>
								<xsd:enumeration value="1">
									<xsd:annotation>
										<xsd:documentation>tak</xsd:documentation>
									</xsd:annotation>
								</xsd:enumeration>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Symbol 99</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_23" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu z zysków kapitałowych, o których mowa w art. 7b ust. 1 pkt 3-6 ustawy, wypłacanych na rzecz podmiotu mającgo siedzibę lub zarząd na terytorium lub w kraju stosującym szkodliwą konkurencje podatkową</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_24" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku z tytułu zysków kapitałowych, o których mowa w art. 7b ust. 1 pkt 3-6 ustawy, wypłacanych na rzecz podmiotu mającgo siedzibę lub zarząd na terytorium lub w kraju stosującym szkodliwą konkurencje podatkową</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Symbol 11</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_25" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu z tytułu odsetek - art. 21 ust. 1 pkt 1 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_26" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku z tytułu odsetek - art. 21 ust. 1 pkt 1 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Symbol 12</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_27" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu z tytułu praw autorskich i pozostałych tytułów wymienionych w art. 21 ust. 1 pkt 1 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_28" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku z tytułu praw autorskich i pozostałych tytułów wymienionych w art. 21 ust. 1 pkt 1 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Symbol 17</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_29" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu z tytułu działalności widowiskowej, rozrywkowej lub sportowej - art. 21 ust. 1 pkt 2 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_30" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku z tytułu działalności widowiskowej, rozrywkowej lub sportowej - art. 21 ust. 1 pkt 2 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Symbol 98</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_31" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu z tytułu świadczeń: doradczych, księgowych, badania rynku, usług prawnych, usług reklamowych, zarządzania i kontroli, przetwarzania danych, usług rekrutacji pracowników i pozyskiwania personelu, gwarancji i poręczeń oraz świadczeń o podobnym charakterze - art. 21 ust. 1 pkt 2a ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_32" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku z tytułu świadczeń: doradczych, księgowych, badania rynku, usług prawnych, usług reklamowych, zarządzania i kontroli, przetwarzania danych, usług rekrutacji pracowników i pozyskiwania personelu, gwarancji i poręczeń oraz świadczeń o podobnym charakterze - art. 21 ust. 1 pkt 2a ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Symbol 8</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_33" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu z tytułu opłat za wywóz ładunków i pasażerów przyjętych do przewozu w portach polskich przez zagraniczne przedsiębiorstwa morskiej żeglugi handlowej - art. 21 ust. 1 pkt 3 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_34" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku z tytułu opłat za wywóz ładunków i pasażerów przyjętych do przewozu w portach polskich przez zagraniczne przedsiębiorstwa morskiej żeglugi handlowej - art. 21 ust. 1 pkt 3 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Symbol 8</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_35" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu z tytułu świadczeń w zakresie żeglugi powietrznej - art. 21 ust. 1 pkt 4 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_36" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku z tytułu świadczeń w zakresie żeglugi powietrznej - art. 21 ust. 1 pkt 4 ustawy</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:element name="P_37" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Razem kwota wypłacona</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_38" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Razem kwota pobranego podatku</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dochód i pobrany podatek w miesiącu 1</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_39" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_45" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_51" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota wynagrodzenia</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_57" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Należna kwota do wpłaty do urzędu skarbowego</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dochód i pobrany podatek w miesiącu 2</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_40" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_46" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_52" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kwota wynagrodzenia</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_58" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Należna kwota do wpłaty do urzędu skarbowego</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
				<xsd:sequence minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dochód i pobrany podatek w miesiącu 3</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="P_41" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota dochodu podlegającego opodatkowaniu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_47" type="etd:TKwotaCNieujemna">
						<xsd:annotation>
							<xsd:documentation>Kwota pobranego podatku</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_53" type="etd:TKwotaCNieujemna" minOccurs="0">
