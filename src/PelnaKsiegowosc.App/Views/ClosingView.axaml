<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:PelnaKsiegowosc.Presentation.ViewModels.Sections"
             xmlns:vm="using:PelnaKsiegowosc.Presentation.ViewModels"
             xmlns:c="using:PelnaKsiegowosc.App.Controls"
             x:Class="PelnaKsiegowosc.App.Views.ClosingView"
             x:DataType="s:ClosingViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="h1" />
    <TabControl>
      <TabItem Header="Rozlicz miesiąc (kreator)">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Miesiąc (mm.rrrr):" VerticalAlignment="Center" />
              <TextBox Text="{Binding MonthClose.Month}" Width="100" />
              <Button Content="Sprawdź" Command="{Binding MonthClose.RefreshCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding MonthClose.Summary}" Classes="h2" Margin="0" />
            <ItemsControl ItemsSource="{Binding MonthClose.Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:CloseStep">
                  <Border Classes="issue" BorderBrush="{Binding Color}">
                    <Grid ColumnDefinitions="40,*,Auto">
                      <TextBlock Text="{Binding Mark}" FontSize="22" Foreground="{Binding Color}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Number}" />. <Run Text="{Binding Title}" /></TextBlock>
                        <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Explanation}" Classes="cardnote" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsEnabled="{Binding Applicable}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Zamknij rok (kreator)">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,8,0,0">
            <WrapPanel Classes="toolbar"><Button Content="Sprawdź stan" Command="{Binding YearClose.RefreshCommand}" /></WrapPanel>
            <TextBlock Text="{Binding YearClose.Summary}" Classes="h2" Margin="0" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding YearClose.Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:CloseStep">
                  <Border Classes="issue" BorderBrush="{Binding Color}">
                    <Grid ColumnDefinitions="40,*,Auto">
                      <TextBlock Text="{Binding Mark}" FontSize="22" Foreground="{Binding Color}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Number}" />. <Run Text="{Binding Title}" /></TextBlock>
                        <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Explanation}" Classes="cardnote" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" IsEnabled="{Binding Applicable}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Odpisy i rezerwy">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Odpisy aktualizujące należności" Classes="h2" Margin="0" />
            <TextBlock Text="{Binding Valuation.PolicyText}" Classes="info" TextWrapping="Wrap" />
            <WrapPanel Classes="toolbar">
              <TextBlock Text="Na dzień:" VerticalAlignment="Center" />
              <TextBox Text="{Binding Valuation.AsOf}" Width="110" />
              <Button Content="Przelicz propozycje" Command="{Binding Valuation.RefreshCommand}" />
              <Button Content="Zaksięguj odpisy i rozwiązania" Command="{Binding Valuation.PostAllowancesCommand}" />
              <Button Content="Spisz zaznaczoną należność…" Command="{Binding Valuation.WriteOffCommand}" />
              <Button Content="Progi odpisów…" Command="{Binding Valuation.SetPolicyCommand}" />
            </WrapPanel>
            <c:TableView Table="{Binding Valuation.Proposals}" SelectedRow="{Binding Valuation.SelectedProposal}" MinHeight="180" />
            <TextBlock Text="Rezerwy na zobowiązania" Classes="h2" Margin="0,8,0,0" />
            <TextBlock Classes="info" TextWrapping="Wrap" Text="Utworzenie: Wn konto kosztów / Ma 840 (843 — świadczenia pracownicze); koszt oznaczony jako niepodatkowy. Wykorzystanie i rozwiązanie odwracają koszt, a CIT uwzględnia to automatycznie. Konto kosztów można zmienić (pole „Konto kosztów”)." />
            <WrapPanel Classes="toolbar">
              <ComboBox ItemsSource="{Binding Valuation.Kinds}" SelectedItem="{Binding Valuation.Kind}" MinWidth="300" />
              <TextBox Text="{Binding Valuation.Description}" Watermark="opis i sposób wyliczenia" MinWidth="260" />
              <TextBox Text="{Binding Valuation.Amount}" Watermark="kwota" Width="110" />
              <TextBox Text="{Binding Valuation.Date}" Watermark="data" Width="110" />
              <TextBox Text="{Binding Valuation.CostAccount}" Watermark="konto kosztów (opcj.)" Width="150" />
            </WrapPanel>
            <WrapPanel Classes="toolbar">
              <Button Content="Utwórz rezerwę" Command="{Binding Valuation.CreateProvisionCommand}" />
              <Button Content="Wylicz rezerwę urlopową…" Command="{Binding Valuation.HolidayCommand}" />
              <Button Content="Wykorzystaj zaznaczoną…" Command="{Binding Valuation.UseProvisionCommand}" />
              <Button Content="Rozwiąż zaznaczoną…" Command="{Binding Valuation.ReleaseProvisionCommand}" />
            </WrapPanel>
            <c:TableView Table="{Binding Valuation.Provisions}" SelectedRow="{Binding Valuation.SelectedProvision}" MinHeight="160" />
            <TextBlock Text="{Binding Valuation.StatusMessage}" Classes="info" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Okresy i rok obrotowy">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding YearInfo}" Classes="info" />
          <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
            <Button Content="Lista kontrolna okresu" Command="{Binding CheckCommand}" />
            <Button Content="Zamknij okres" Command="{Binding ClosePeriodCommand}" />
            <Button Content="Otwórz ponownie…" Command="{Binding ReopenPeriodCommand}" />
            <Button Content="Podgląd zamknięcia roku" Command="{Binding PreviewYearCloseCommand}" />
            <Button Content="Dokumentuj okoliczności szczególne (bez odblokowania)…" Command="{Binding FinalCloseExceptionCommand}" />
            <Button Content="Zamknij rok obrotowy…" Command="{Binding CloseYearCommand}" />
          </WrapPanel>
          <Grid ColumnDefinitions="*,12,1.4*">
            <c:TableView Table="{Binding Periods}" SelectedRow="{Binding SelectedPeriod}" />
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Text="Lista kontrolna" Classes="h2" Margin="0,0,0,4" />
              <c:TableView Table="{Binding Checklist}" />
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
