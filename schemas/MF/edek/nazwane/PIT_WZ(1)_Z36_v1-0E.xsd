<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:zwz36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITWZ36/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITWZ36/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/StrukturyDanych_v7-0E.xsd"/>
	<!--Załącznik do zeznania PIT-36.-->
	<!-- -->
	<!--Wypełniają podatnicy, którzy na podstawie art. 26i ustawy rozliczają wierzytelności lub zobowiązania wynikające z art. 4 pkt 1a ustawy z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych (Dz. U. z 2020 r. poz. 935, z późn. zm.).-->
	<xsd:complexType name="TNaglowek_PIT_WZ">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zwz36:TKodFormularza_PIT_WZ">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT/WZ (1)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_PIT_WZ">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/WZ"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_WZ">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WIERZYTELNOŚCIACH I ZOBOWIĄZANIACH ZMNIEJSZAJĄCYCH LUB ZWIĘKSZAJĄCYCH PODSTAWĘ OPODATKOWANIA (STRATĘ), WYNIKAJĄCYCH Z TRANSAKCJI HANDLOWYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zwz36:TNaglowek_PIT_WZ"/>
				<xsd:element name="Podmiot1" type="etd:TIdentyfikatorOsobyFizycznej2"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dotyczące dłużnika i wierzytelności, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane, dane dotyczące dłużnika i wierzytelności, jeżeli wierzytelność została uregulowana lub zbyta, dane dotyczące wierzyciela i zobowiązania, jeżeli zobowiązanie zostało uregulowane</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_B" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące dłużnika i wierzytelności, jeżeli do dnia złożenia zeznania podatkowego wierzytelność nie została uregulowana lub zbyta (dotyczy wierzytelności zmniejszających podstawę opodatkowania lub zwiększających stratę - wypełnia podatnik będący wierzycielem)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_B7" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B8" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B9" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B10" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B11" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
												<!--Termin zapłaty nie może przekroczyć terminów przewidzianych w ustawie z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych.-->
											</xsd:element>
											<xsd:element name="P_B12" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności</xsd:documentation>
												</xsd:annotation>
												<!--Podatnik będący wspólnikiem spółki osobowej wpisuje wartość wierzytelności/zobowiązania stosownie do swojego udziału.-->
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_13" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 12</xsd:documentation>
									</xsd:annotation>
									<!--Jeżeli podatnik składa więcej niż jeden załącznik PIT/WZ, w poz. 13 ostatniego załącznika sumuje kwoty z poz. 12 wszystkich załączników. Odpowiednio należy uczynić w przypadku sumowania kwot z poz. 19, 28 i 37 załączników PIT/WZ, z których sumy należy wykazać w ostatnim załączniku PIT/WZ odpowiednio w poz. 20, 29 lub 38.-->
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_C" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące wierzyciela i zobowiązania, jeżeli do dnia złożenia zeznania podatkowego zobowiązanie nie zostało uregulowane (dotyczy zobowiązań zwiększających podstawę opodatkowania lub zmniejszających stratę - wypełnia podatnik będący dłużnikiem)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_C14" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C15" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C16" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C17" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C18" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
												<!--Termin zapłaty nie może przekroczyć terminów przewidzianych w ustawie z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych.-->
											</xsd:element>
											<xsd:element name="P_C19" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania</xsd:documentation>
												</xsd:annotation>
												<!--Podatnik będący wspólnikiem spółki osobowej wpisuje wartość wierzytelności/zobowiązania stosownie do swojego udziału.-->
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_20" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 19</xsd:documentation>
									</xsd:annotation>
									<!--Jeżeli podatnik składa więcej niż jeden załącznik PIT/WZ, w poz. 13 ostatniego załącznika sumuje kwoty z poz. 12 wszystkich załączników. Odpowiednio należy uczynić w przypadku sumowania kwot z poz. 19, 28 i 37 załączników PIT/WZ, z których sumy należy wykazać w ostatnim załączniku PIT/WZ odpowiednio w poz. 20, 29 lub 38.-->
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_D" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące dłużnika i wierzytelności, jeżeli wierzytelność została uregulowana lub zbyta (dotyczy wierzytelności, które zmniejszyły podstawę opodatkowania lub zwiększyły stratę)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D21" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D22" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP dłużnika</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D23" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D24" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D25" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
												<!--Termin zapłaty nie może przekroczyć terminów przewidzianych w ustawie z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych.-->
											</xsd:element>
											<xsd:element name="P_D26" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data uregulowania lub zbycia wierzytelności</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D27" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności uregulowanej lub zbytej w trakcie roku podatkowego</xsd:documentation>
												</xsd:annotation>
												<!--Podatnik będący wspólnikiem spółki osobowej wpisuje wartość wierzytelności/zobowiązania stosownie do swojego udziału.-->
											</xsd:element>
											<xsd:element name="P_D28" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość wierzytelności uregulowanej lub zbytej po roku podatkowym</xsd:documentation>
												</xsd:annotation>
												<!--Podatnik będący wspólnikiem spółki osobowej wpisuje wartość wierzytelności/zobowiązania stosownie do swojego udziału.-->
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_29" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 28</xsd:documentation>
									</xsd:annotation>
									<!--Jeżeli podatnik składa więcej niż jeden załącznik PIT/WZ, w poz. 13 ostatniego załącznika sumuje kwoty z poz. 12 wszystkich załączników. Odpowiednio należy uczynić w przypadku sumowania kwot z poz. 19, 28 i 37 załączników PIT/WZ, z których sumy należy wykazać w ostatnim załączniku PIT/WZ odpowiednio w poz. 20, 29 lub 38.-->
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_E" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące wierzyciela i zobowiązania, jeżeli zobowiązanie zostało uregulowane (dotyczy zobowiązań, które zwiększyły podstawę opodatkowania lub zmniejszyły stratę)</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_E30" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E31" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP wierzyciela</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E32" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer faktury / rachunku / umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E33" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wystawienia faktury/rachunku lub zawarcia umowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E34" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data upływu terminu zapłaty</xsd:documentation>
												</xsd:annotation>
												<!--Termin zapłaty nie może przekroczyć terminów przewidzianych w ustawie z dnia 8 marca 2013 r. o przeciwdziałaniu nadmiernym opóźnieniom w transakcjach handlowych.-->
											</xsd:element>
											<xsd:element name="P_E35" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data uregulowania zobowiązania</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E36" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania uregulowanego w trakcie roku podatkowego</xsd:documentation>
												</xsd:annotation>
												<!--Podatnik będący wspólnikiem spółki osobowej wpisuje wartość wierzytelności/zobowiązania stosownie do swojego udziału.-->
											</xsd:element>
											<xsd:element name="P_E37" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Wartość zobowiązania uregulowanego po roku podatkowym</xsd:documentation>
												</xsd:annotation>
												<!--Podatnik będący wspólnikiem spółki osobowej wpisuje wartość wierzytelności/zobowiązania stosownie do swojego udziału.-->
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_38" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Suma kwot z poz. 37</xsd:documentation>
									</xsd:annotation>
									<!--Jeżeli podatnik składa więcej niż jeden załącznik PIT/WZ, w poz. 13 ostatniego załącznika sumuje kwoty z poz. 12 wszystkich załączników. Odpowiednio należy uczynić w przypadku sumowania kwot z poz. 19, 28 i 37 załączników PIT/WZ, z których sumy należy wykazać w ostatnim załączniku PIT/WZ odpowiednio w poz. 20, 29 lub 38.-->
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
