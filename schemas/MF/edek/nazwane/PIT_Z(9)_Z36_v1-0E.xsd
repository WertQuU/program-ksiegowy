<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:z36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITZ36/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2021/01/20/eD/PITZ36/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/07/06/eD/DefinicjeTypy/StrukturyDanych_v7-0E.xsd"/>
	<!--Załącznik do zeznania PIT-36.-->
	<xsd:complexType name="TNaglowek_PIT_Z">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="z36:TKodFormularza_PIT_Z">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT/Z (9)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="9"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_PIT_Z">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/Z"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_Z">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI DOCHODU (STRATY) Z POZAROLNICZEJ DZIAŁALNOŚCI GOSPODARCZEJ, PROWADZONEJ PRZEZ PODATNIKÓW KORZYSTAJĄCYCH ZE ZWOLNIENIA NA PODSTAWIE ART. 44 UST. 7A USTAWY, OSIĄGNIĘTEGO (PONIESIONEJ) W ROKU PODATKOWYM</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="z36:TNaglowek_PIT_Z"/>
				<xsd:element name="Podmiot1" type="etd:TIdentyfikatorOsobyFizycznej2"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dotyczące pozarolniczej działalności gospodarczej, zwanej dalej „działalnością gospodarczą”, dane dotyczące doliczenia na podstawie art. 44 ust. 7f i 7l ustawy</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.1. Łączny przychód, koszty, dochód lub strata podatnika z działalności gospodarczej, w tym objętej zwolnieniem na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
								</xsd:annotation>
								<!--Części B nie wypełniają podatnicy, którzy są opodatkowani na zasadach określonych w art. 30c ustawy.-->
								<xsd:element name="P_6" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychó</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_7" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_8" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_9" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.2. Przychód, koszty, dochód lub strata podatnika z działalności gospodarczej nieobjętej zwolnieniem na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_10" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_11" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_12" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_13" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.3. Przychód, koszty, dochód lub strata podatnika z działalności gospodarczej objętej zwolnieniem na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_14" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_15" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_16" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_17" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.4. Zwiększenia dochodu / zmniejszenia straty z pozarolniczej działalności gospodarczej objętej zwolnieniem na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_18" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód z kwalifikowanych praw własności intelektualnej niepodlegający opodatkowaniu na podstawie art. 30ca ust. 1 ustawy, tj. według stawki 5%, który doliczany jest do dochodu objętego zwolnieniem, o którym mowa w art. 44 ust. 7a ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:choice>
									<xsd:element name="P_19" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata po zmniejszeniu</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_20" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód podlegający doliczeniu</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:choice>
								<xsd:element name="P_21" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód po doliczeniu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.5. Łączny przychód, koszty, dochód lub strata podatnika z działalności gospodarczej, z wyodrębnieniem dochodu z działalności gospodarczej objętej zwolnieniem na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
								</xsd:annotation>
								<!--W poz. 22 i 23 należy wpisać odpowiednio kwoty z poz. 6 i 7, natomiast w poz. 24 i 25 należy wpisać odpowiednio kwoty z poz. 12 i 21, a w poz. 26 sumę kwot z poz. 13 i 19.-->
								<xsd:element name="P_22" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_23" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_24" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_25" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód objęty zwolnieniem</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_26" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>C. Dane dotyczące doliczenia na podstawie art. 44 ust. 7f i 7l ustawy Przychód, koszty, dochód lub strata podatnika z działalności gospodarczej</xsd:documentation>
								</xsd:annotation>
								<xsd:sequence>
									<xsd:element name="P_27" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychód</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_28" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodu</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_29" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence minOccurs="0">
									<xsd:element name="P_31">
										<xsd:annotation>
											<xsd:documentation>Rok, w którym podatnik korzystał ze zwolnienia na podstawie art. 44 ust. 7a ustawy</xsd:documentation>
										</xsd:annotation>
										<!--Należy podać rok, w którym podatnik lub zmarły przedsiębiorca korzystał ze zwolnienia na podstawie art. 44 ust. 7a ustawy.-->
										<xsd:simpleType>
											<xsd:restriction base="etd:TRok">
												<xsd:minInclusive value="2015"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:element>
									<xsd:element name="P_32" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>20% dochodu wykazanego w zeznaniu PIT-36 składanym za rok podatkowy objęty zwolnieniem, o którym mowa w art. 44 ust. 7a ustawy</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:element name="P_33" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Strata z działalności gospodarczej po doliczeniu na podstawie art. 44 ust. 7f i 7l ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_34" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Dochód podlegający doliczeniu do dochodu z działalności gospodarczej na podstawie art. 44 ust. 7f i 7l ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_35" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód z działalności gospodarczej po doliczeniu na podstawie art. 44 ust. 7f i 7l ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<!--W poz. 36 i 37 należy wpisać odpowiednio kwoty z poz. 27 i 28, natomiast w poz. 38 i 39 odpowiednio kwoty z poz. 35 i 33.-->
								<xsd:sequence>
									<xsd:element name="P_36" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Przychód</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_37" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Koszty uzyskania przychodu</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_38" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Dochód</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_39" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Strata</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
