<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:PelnaKsiegowosc.Presentation.ViewModels.Sections"
             xmlns:c="using:PelnaKsiegowosc.App.Controls"
             x:Class="PelnaKsiegowosc.App.Views.PayrollView"
             x:DataType="s:PayrollViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="h1" />
    <TabControl>
      <TabItem Header="1. Osoby i umowy">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Classes="form" ColumnDefinitions="140,*,140,*,140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="Imię" /><TextBox Grid.Column="1" Text="{Binding FirstName}" />
            <TextBlock Grid.Column="2" Text="Nazwisko" /><TextBox Grid.Column="3" Text="{Binding LastName}" />
            <TextBlock Grid.Column="4" Text="PESEL" /><TextBox Grid.Column="5" Text="{Binding Pesel}" />
            <TextBlock Grid.Row="1" Text="Rodzaj umowy" /><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding Contract}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Brutto miesięcznie" /><Grid Grid.Row="1" Grid.Column="3" ColumnDefinitions="*,*"><TextBox Text="{Binding Gross}" Margin="0,2,4,2" /><TextBox Grid.Column="1" Text="{Binding ContractTotal}" Watermark="kwota z umowy (zlec./dzieło)" ToolTip.Tip="Łączna kwota należności określona w umowie zlecenia / o dzieło — decyduje o ryczałcie do 200 zł (art. 30 ust. 1 pkt 5a ustawy o PIT)" Margin="0,2,12,2" /></Grid>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Wymiar etatu" /><TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Fraction}" Watermark="1 = pełny etat" />
            <TextBlock Grid.Row="2" Text="Koszty uzyskania" /><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CostTypes}" SelectedItem="{Binding Costs}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Umowa od / do" />
            <Grid Grid.Row="2" Grid.Column="3" ColumnDefinitions="*,*"><TextBox Text="{Binding StartDate}" Margin="0,2,4,2" /><TextBox Grid.Column="1" Text="{Binding EndDate}" Watermark="bezterminowa" Margin="0,2,12,2" /></Grid>
            <TextBlock Grid.Row="2" Grid.Column="4" Text="Kod urzędu skarb." /><TextBox Grid.Row="2" Grid.Column="5" Text="{Binding TaxOffice}" />
            <TextBlock Grid.Row="3" Text="Ulica, nr domu / lokalu" />
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,60,60"><TextBox Text="{Binding Street}" Margin="0,2,4,2" /><TextBox Grid.Column="1" Text="{Binding HouseNumber}" Watermark="nr" Margin="0,2,4,2" /><TextBox Grid.Column="2" Text="{Binding FlatNumber}" Watermark="lok." Margin="0,2,12,2" /></Grid>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="Kod, miejscowość" />
            <Grid Grid.Row="3" Grid.Column="3" ColumnDefinitions="80,*"><TextBox Text="{Binding PostalCode}" Watermark="00-000" Margin="0,2,4,2" /><TextBox Grid.Column="1" Text="{Binding City}" Margin="0,2,12,2" /></Grid>
            <TextBlock Grid.Row="3" Grid.Column="4" Text="Rachunek do wypłaty" /><TextBox Grid.Row="3" Grid.Column="5" Text="{Binding Iban}" />
            <TextBlock Grid.Row="4" Text="Województwo" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Voivodeship}" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="Powiat" /><TextBox Grid.Row="4" Grid.Column="3" Text="{Binding County}" />
            <TextBlock Grid.Row="4" Grid.Column="4" Text="Gmina" /><TextBox Grid.Row="4" Grid.Column="5" Text="{Binding Commune}" />
            <TextBlock Grid.Row="5" Text="Urlop roczny / zaległy" />
            <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,*"><TextBox Text="{Binding AnnualLeaveDays}" Watermark="20 lub 26" Margin="0,2,4,2" /><TextBox Grid.Column="1" Text="{Binding LeaveCarriedOver}" Watermark="zaległy (dni)" Margin="0,2,12,2" /></Grid>
            <TextBlock Grid.Row="5" Grid.Column="2" Text="Badania lekarskie do" /><TextBox Grid.Row="5" Grid.Column="3" Text="{Binding MedicalExamUntil}" />
            <TextBlock Grid.Row="5" Grid.Column="4" Text="Szkolenie BHP do" /><TextBox Grid.Row="5" Grid.Column="5" Text="{Binding BhpTrainingUntil}" />
            <WrapPanel Grid.Row="6" Grid.ColumnSpan="6" Classes="toolbar">
              <ComboBox ItemsSource="{Binding Pit2Options}" SelectedItem="{Binding Pit2Option}" MinWidth="170" ToolTip.Tip="Oświadczenie PIT-2: kwota zmniejszająca zaliczkę 1/12, 1/24 lub 1/36 z 3600 zł — stosowana raz w miesiącu dla osoby, łącznie dla wszystkich jej umów i list" />
              <ComboBox ItemsSource="{Binding ExternalTitleOptions}" SelectedItem="{Binding ExternalTitles}" MinWidth="230" ToolTip.Tip="Zlecenie: inne tytuły do ubezpieczeń poza naszą firmą (art. 9 ustawy o sus) — bez ustalenia listy nie można zaksięgować" />
              <TextBox Text="{Binding ExternalTitlesBasis}" Watermark="podstawa z innego tytułu (mies.)" MinWidth="190" ToolTip.Tip="Miesięczna podstawa składek z etatu u innego pracodawcy / wcześniejszego zlecenia — porównywana z minimalnym wynagrodzeniem" />
              <CheckBox Content="Dobrowolne emerytalne i rentowe (zlecenie)" IsChecked="{Binding VoluntaryPension}" />
              <CheckBox Content="Ulga dla młodych (do 26 lat)" IsChecked="{Binding YouthRelief}" />
              <CheckBox Content="Uczeń/student do 26 lat (zlecenie bez ZUS)" IsChecked="{Binding Student}" />
              <CheckBox Content="Dobrowolne chorobowe (zlecenie)" IsChecked="{Binding VoluntarySickness}" />
              <CheckBox Content="Zwolnienie z FP/FGŚP" IsChecked="{Binding ExemptFromFp}" />
              <CheckBox Content="Uczestnik PPK (2% + 1,5%)" IsChecked="{Binding Ppk}" />
              <CheckBox Content="Umowa wykonywana na rzecz naszego pracownika/pracodawcy (art. 8 ust. 2a sus)" IsChecked="{Binding WorkForOwnEmployer}" ToolTip.Tip="Zlecenie / dzieło zawarte z osobą trzecią, ale wykonywane na rzecz pracodawcy — składki jak od stosunku pracy. Umowy z własnym pracownikiem (ten sam PESEL) program rozpoznaje sam." />
              <TextBox Text="{Binding AuthorShare}" Watermark="koszty 50%: udział autorski %" MinWidth="170" ToolTip.Tip="Udział wynagrodzenia za korzystanie z praw autorskich / rozporządzanie nimi (wg umowy i ewidencji utworów)" />
              <TextBox Text="{Binding AuthorBasis}" Watermark="koszty 50%: podstawa (umowa, ewidencja utworów)" MinWidth="260" />
            </WrapPanel>
            <WrapPanel Grid.Row="7" Grid.ColumnSpan="6" Classes="toolbar">
              <Button Content="Dodaj osobę" Command="{Binding AddEmployeeCommand}" Classes="accent" />
              <Button Content="Zapisz zmiany zaznaczonej" Command="{Binding SaveEmployeeCommand}" />
              <Button Content="Żądanie usunięcia danych (RODO)…" Command="{Binding EraseEmployeeDataCommand}" />
              <TextBlock Text="Stopa wypadkowa %:" /><TextBox Text="{Binding AccidentRate}" MinWidth="70" />
              <Button Content="Zapisz stopę" Command="{Binding SaveAccidentRateCommand}" />
            </WrapPanel>
          </Grid>
          <c:TableView Table="{Binding Employees}" SelectedRow="{Binding SelectedEmployee}" />
        </DockPanel>
      </TabItem>
      <TabItem Header="2. Listy płac">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
            <TextBlock Text="Za miesiąc (mm.rrrr):" /><TextBox Text="{Binding ListMonth}" MinWidth="90" />
            <TextBlock Text="Data wypłaty:" /><TextBox Text="{Binding PaymentDate}" MinWidth="100" />
            <Button Content="Utwórz listę płac" Command="{Binding CreateListCommand}" Classes="accent" />
            <Button Content="Zaksięguj zaznaczoną" Command="{Binding PostListCommand}" />
            <Button Content="Przelicz listę" Command="{Binding RecalculateListCommand}" ToolTip.Tip="Ponowne wyliczenie wszystkich pozycji z aktualnych danych osób, limitów i innych list (wymagane, gdy dane zmieniły się po utworzeniu listy)" />
            <Button Content="Usuń roboczą" Command="{Binding DeleteListCommand}" />
            <TextBox Text="{Binding PpkTransferDate}" Watermark="data przekazania PPK" MinWidth="130" />
            <Button Content="Zarejestruj przekazanie PPK" Command="{Binding RecordPpkTransferCommand}" ToolTip.Tip="Dla zaksięgowanej listy: dzień przekazania wpłat do instytucji finansowej — od tego dnia wpłata pracodawcy jest przychodem pracownika" />
            <Button Content="Wydruk listy" Command="{Binding PrintListCommand}" />
          </WrapPanel>
          <c:TableView DockPanel.Dock="Top" Table="{Binding Lists}" SelectedRow="{Binding SelectedList}" MaxHeight="200" />
          <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
            <TextBlock Text="Zaznaczona osoba — brutto za pełny miesiąc:" /><TextBox Text="{Binding NewGross}" Watermark="(z umowy)" MinWidth="100" />
            <TextBlock Text="dni choroby:" /><TextBox Text="{Binding SickDays}" Watermark="(bez zmian)" MinWidth="50" />
            <TextBlock Text="dni urlopu bezpłatnego (robocze):" /><TextBox Text="{Binding UnpaidDays}" Watermark="(bez zmian)" MinWidth="50" />
            <Button Content="Przelicz" Command="{Binding ChangeGrossCommand}" />
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Top" Classes="toolbar" ToolTip.Tip="Art. 92 KP: potwierdzenie dotyczy wszystkich dni choroby w wybranym miesiącu; przy kilku różnych przyczynach konieczne jest osobne rozliczenie. Nie wpisuj danych medycznych — tylko odnośnik do dowodu.">
            <TextBlock Text="Chorobowe — dni u innych pracodawców w roku:" />
            <TextBox Text="{Binding PreviousEmployerSickDays}" Watermark="np. 0 (potwierdzone)" MinWidth="115" />
            <ComboBox ItemsSource="{Binding SickWageCauses}" SelectedItem="{Binding SickWageCause}" MinWidth="230" Watermark="Wybierz powód 80/100%" />
            <TextBox Text="{Binding SickEvidenceReference}" Watermark="Identyfikator dowodu/oświadczenia, bez danych medycznych" MinWidth="250" />
            <Button Content="Zatwierdź chorobowe i przelicz" Command="{Binding ConfirmSickWageCommand}" />
          </WrapPanel>
          <c:TableView Table="{Binding Items}" SelectedRow="{Binding SelectedItem}" />
        </DockPanel>
      </TabItem>
      <TabItem Header="3. ZUS i PIT (deklaracje)">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
            <TextBlock Text="Miesiąc wypłat:" /><TextBox Text="{Binding ZusMonth}" MinWidth="90" />
            <Button Content="ZUS DRA / RCA" Command="{Binding ZusReportCommand}" />
            <TextBlock Text="Rok:" /><TextBox Text="{Binding ReportYear}" MinWidth="70" />
            <Button Content="PIT-4R i PIT-8AR" Command="{Binding Pit4RCommand}" />
            <Button Content="PIT-11" Command="{Binding Pit11Command}" />
            <Button Content="Karta wynagrodzeń zaznaczonej osoby" Command="{Binding SalaryCardCommand}" />
            <Button Content="Ewidencja urlopów" Command="{Binding LeaveReportCommand}" />
            <Button Content="Zapisz PDF…" Command="{Binding ExportReportPdfCommand}" />
          </WrapPanel>
          <c:TableView Table="{Binding Report}" />
        </DockPanel>
      </TabItem>
      <TabItem Header="4. Kadry: nieobecności i urlopy">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="info" TextWrapping="Wrap" Text="Choroba i urlop bezpłatny trafiają automatycznie na listę płac danego miesiąca. Urlopy pomniejszają wymiar; pozostały urlop na koniec roku służy do wyliczenia rezerwy urlopowej (Zamknięcie → Odpisy i rezerwy)." />
          <WrapPanel DockPanel.Dock="Top" Classes="toolbar">
            <ComboBox ItemsSource="{Binding EmployeeChoices}" SelectedItem="{Binding AbsenceEmployee}" MinWidth="200" PlaceholderText="pracownik" />
            <ComboBox ItemsSource="{Binding AbsenceKinds}" SelectedItem="{Binding AbsenceKind}" MinWidth="200" />
            <TextBox Text="{Binding AbsenceFrom}" Watermark="od" Width="110" />
            <TextBox Text="{Binding AbsenceTo}" Watermark="do" Width="110" />
            <TextBox Text="{Binding AbsenceNotes}" Watermark="uwagi (np. nr L4)" MinWidth="160" />
            <Button Content="Dodaj nieobecność" Command="{Binding AddAbsenceCommand}" Classes="accent" />
            <Button Content="Usuń zaznaczoną" Command="{Binding DeleteAbsenceCommand}" />
            <TextBlock Text="Rok:" /><TextBox Text="{Binding ReportYear}" MinWidth="70" />
            <Button Content="Odśwież" Command="{Binding RefreshHrCommand}" />
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding HrReminders}" Classes="info" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="1.3*,12,*">
            <c:TableView Table="{Binding Absences}" SelectedRow="{Binding SelectedAbsence}" />
            <c:TableView Grid.Column="2" Table="{Binding LeaveBalances}" />
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
