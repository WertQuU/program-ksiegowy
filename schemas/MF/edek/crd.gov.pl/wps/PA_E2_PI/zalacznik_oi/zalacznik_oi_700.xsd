<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:zg36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/12/15/eD/PITZGZ36/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/12/15/eD/PITZGZ36/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/StrukturyDanych_v3-0E.xsd"/>
	<xsd:complexType name="TNaglowek_PIT_ZG">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zg36:TKodFormularza_ZG">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT/ZG (4)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="4"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_ZG">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/ZG"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_ZG">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI DOCHODÓW Z ZAGRANICY I ZAPŁACONYM PODATKU W ROKU PODATKOWYM</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zg36:TNaglowek_PIT_ZG"/>
				<xsd:element name="Podmiot1" type="etd:TIdentyfikatorOsobyFizycznej1"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dochody i podatek rozliczane w zeznaniu podatkowym PIT-36</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_7" type="etd:TKodKraju">
								<xsd:annotation>
									<xsd:documentation>Kod kraju uzyskania dochodu</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>1. Należności ze stosunku: pracy, służbowego, spółdzielczego i z pracy nakładczej, a także zasiłki pieniężne z ubezpieczenia społecznego, wypłacone przez zakład pracy</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_8" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 8 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_9" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 9 i 9a ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_10" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek zapłacony za granicą od dochodów, o których mowa w kol. c</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>2. Pozarolnicza działalność gospodarcza</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_11" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 8 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_12" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 9 i 9a ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_13" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek zapłacony za granicą od dochodów, o których mowa w kol. c</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>3. Działalność wykonywana osobiście, o której mowa w art.13 ustawy (w tym umowy o dzieło i zlecenia)</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_14" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 8 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_15" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 9 i 9a ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_16" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek zapłacony za granicą od dochodów, o których mowa w kol. c</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>4. Najem lub dzierżawa</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_17" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 8 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_18" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 9 i 9a ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_19" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek zapłacony za granicą od dochodów, o których mowa w kol. c</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>5. Prawa autorskie i inne prawa, o których mowa w art.18 ustawy</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_20" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 8 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_21" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 9 i 9a ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_22" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek zapłacony za granicą od dochodów, o których mowa w kol. c</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>6. Inne źródła, niewymienione w wierszach od 1 do 5 (w tym emerytury - renty, stypendia z zagranicy)</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_23" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 8 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_24" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 9 i 9a ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_25" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek zapłacony za granicą od dochodów, o których mowa w kol. c</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>7. Razem</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_26" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 8 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_27" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód, o którym mowa w art. 27 ust. 9 i 9a ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_28" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek zapłacony za granicą od dochodów, o których mowa w kol. c</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
