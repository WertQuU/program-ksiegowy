<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:PelnaKsiegowosc.Presentation.ViewModels.Sections"
             xmlns:vm="using:PelnaKsiegowosc.Presentation.ViewModels"
             xmlns:c="using:PelnaKsiegowosc.App.Controls"
             x:Class="PelnaKsiegowosc.App.Views.SettingsView"
             x:DataType="s:SettingsViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Classes="h1" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding ActiveInfo}" Classes="info" />
    <ScrollViewer>
      <StackPanel>
        <TextBlock Text="Wygląd" Classes="h2" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Motyw:" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="160" />
        </StackPanel>
        <TextBlock Text="Aktualizacje programu" Classes="h2" />
        <TextBlock Text="{Binding InstalledVersion}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Classes="info" />
        <WrapPanel Classes="toolbar">
          <Button Content="Sprawdź aktualizacje na GitHub" Command="{Binding CheckForUpdatesCommand}" />
          <Button Content="Pobierz i uruchom instalator" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding HasAvailableUpdate}" />
          <Button Content="Zobacz wydania" Command="{Binding OpenReleasesPageCommand}" />
        </WrapPanel>
        <TextBlock Classes="info" TextWrapping="Wrap" Text="Aktualizacje tylko z oficjalnych wydań GitHub Releases, po potwierdzeniu użytkownika i weryfikacji sumy SHA-256. Zamknij program przed instalacją; aktualizacja programu nie wykonuje automatycznie migracji bazy danych." />
        <TextBlock Text="Schematy XSD (walidacja JPK, e-Faktur, e-Sprawozdań)" Classes="h2" />
        <TextBlock Classes="info" TextWrapping="Wrap" Text="Pliki wysyłane do MF są sprawdzane oficjalnym schematem XSD. Brakujący schemat pobierz z serwera MF (crd.gov.pl) albo ze strony MF i wczytaj z pliku (.xsd lub .zip). Walidacja działa potem bez Internetu." />
        <ListBox ItemsSource="{Binding Schemas}" SelectedItem="{Binding SelectedSchema}" MaxHeight="220">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="s:SchemaItem">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding State}" Foreground="{DynamicResource PkMuted}" />
                </StackPanel>
                <TextBlock Text="{Binding Purpose}" Foreground="{DynamicResource PkMuted}" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Classes="toolbar">
          <Button Content="Pobierz z serwera MF" Command="{Binding DownloadSchemasCommand}" />
          <Button Content="Wczytaj z pliku…" Command="{Binding ImportSchemaCommand}" />
          <Button Content="Otwórz stronę MF zaznaczonego schematu" Command="{Binding OpenSchemaPageCommand}" />
        </WrapPanel>
        <TextBlock Text="Baza danych" Classes="h2" />
        <TextBlock Classes="info" Text="Centralny PostgreSQL — jedna wspólna baza ksiąg. Osobny login SQL na operatora, jeden uruchomiony program na login. Nie tworzymy lokalnych baz do pracy." TextWrapping="Wrap" />
        <Grid Classes="form" ColumnDefinitions="200,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding Database.UsePostgres}" Margin="24,0,0,0">
          <TextBlock Text="Adres serwera" /><TextBox Grid.Column="1" Text="{Binding Database.Host}" />
          <TextBlock Grid.Row="1" Text="Port" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Database.Port}" />
          <TextBlock Grid.Row="2" Text="Nazwa bazy" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Database.Database}" />
          <TextBlock Grid.Row="3" Text="Użytkownik" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Database.Username}" />
          <TextBlock Grid.Row="4" Text="Hasło" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Database.Password}" PasswordChar="•" Watermark="(bez zmian)" />
          <TextBlock Grid.Row="5" Text="Szyfrowanie TLS" /><ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Database.SslModes}" SelectedItem="{Binding Database.SslMode}" />
          <TextBlock Grid.Row="6" Text="Certyfikat CA" /><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Database.RootCertificate}" />
          <Button Grid.Row="6" Grid.Column="2" Content="Wybierz…" Command="{Binding PickCertificateCommand}" />
          <TextBlock Grid.Row="7" Text="Rola serwera" /><ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding Database.Roles}" SelectedItem="{Binding Database.Role}" />
        </Grid>
        <WrapPanel Classes="toolbar" Margin="0,8,0,0">
          <Button Content="Testuj połączenie" Command="{Binding TestDatabaseCommand}" />
          <Button Content="Pokaż klucz bazy…" Command="{Binding ShowDatabaseKeyCommand}" ToolTip.Tip="Plik bazy jest szyfrowany (RODO). Klucz jest potrzebny, by otworzyć ten plik na innym stanowisku." />
          <Button Content="Pokaż klucz załączników…" Command="{Binding ShowAttachmentsKeyCommand}" ToolTip.Tip="Załączniki są szyfrowane. Klucz jest potrzebny na innym stanowisku korzystającym ze wspólnego katalogu załączników." />
          <Button Content="Importuj klucz załączników…" Command="{Binding ImportAttachmentsKeyCommand}" />
          <Button Content="Używaj tej bazy (po ponownym uruchomieniu)" Command="{Binding UseDatabaseCommand}" />
          <Button Content="Migruj dane do tej bazy…" Command="{Binding MigrateCommand}" />
        </WrapPanel>
        <WrapPanel Classes="toolbar">
          <TextBlock Text="Poprzednie bazy:" /><ComboBox ItemsSource="{Binding OtherProfiles}" SelectedItem="{Binding OtherProfile}" MinWidth="360" />
          <Button Content="Wróć do wybranej" Command="{Binding RestoreOtherProfileCommand}" />
        </WrapPanel>
        <TextBlock Text="Załączniki" Classes="h2" />
        <WrapPanel Classes="toolbar">
          <TextBox Text="{Binding AttachmentsDirectory}" MinWidth="420" />
          <Button Content="Zapisz katalog załączników" Command="{Binding SaveAttachmentsDirectoryCommand}" />
        </WrapPanel>
        <TextBlock Text="Stanowisko" Classes="h2" />
        <SelectableTextBlock Text="{Binding PathsInfo}" TextWrapping="Wrap" />
        <WrapPanel Classes="toolbar" Margin="0,6,0,0"><Button Content="Otwórz katalog danych" Command="{Binding OpenDataFolderCommand}" /></WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
