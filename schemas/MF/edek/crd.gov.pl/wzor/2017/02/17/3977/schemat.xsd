<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" xmlns:tns="http://crd.gov.pl/wzor/2017/02/17/3977/" xmlns:zzu="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/" targetNamespace="http://crd.gov.pl/wzor/2017/02/17/3977/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/02/05/eD/ORDZU/ORD-ZU(3)_v1-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/StrukturyDanych_v4-0E.xsd"/>
	<!--Informację podatnicy składają odrębnie za rok 2016 albo 2017.-->
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="tns:TKodFormularza">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT-VC (1)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="CIT"/>
							<xsd:attribute name="rodzajZobowiazania" type="xsd:token" use="required" fixed="Z"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CelZlozenia">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="etd:TCelZlozenia">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_7"/>
						</xsd:extension>
					</xsd:simpleContent>
					<!--Zgodnie z art. 81 ustawy z dnia 29 sierpnia 1997 r. - Ordynacja podatkowa (Dz. U. z 2015 r. poz. 613, z późn. zm.).-->
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Rok">
				<xsd:simpleType>
					<xsd:restriction base="etd:TRok">
						<xsd:minInclusive value="2016"/>
						<xsd:maxInclusive value="2017"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="KodUrzedu" type="etd:TKodUS"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-VC"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Deklaracja">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O NABYTYCH UDZIAŁACH (AKCJACH) W SPÓŁKACH, O KTÓRYCH MOWA W ART. 14 UST. 3 PKT 1 USTAWY Z DNIA 25 WRZEŚNIA 2015 R. O ZMIANIE NIEKTÓRYCH USTAW W ZWIĄZKU ZE WSPIERANIEM INNOWACYJNOŚCI</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="OsobaNiefizyczna">
								<xsd:complexType>
									<xsd:complexContent>
										<xsd:extension base="etd:TIdentyfikatorOsobyNiefizycznej"/>
									</xsd:complexContent>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
						<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="tns:PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacja o nabytych udziałach (akcjach)</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Pouczenie">
					<xsd:annotation>
						<xsd:documentation>Wartość 1 oznacza potwierdzenie zapoznania się z treścią i akceptację poniższego pouczenia:
		Za podanie nieprawdy lub zatajenie prawdy i przez to narażenie podatku na uszczuplenie grozi odpowiedzialność przewidziana w Kodeksie karnym skarbowym.
								</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TKwota2Nieujemna">
							<xsd:minExclusive value="0"/>
							<xsd:maxExclusive value="2"/>
							<xsd:fractionDigits value="0"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Zalaczniki" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence minOccurs="0">
							<xsd:element ref="zzu:Zalacznik_ORD-ZU"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
		<xsd:unique name="klucz_NIP">
			<xsd:selector xpath="tns:Podmiot1/tns:OsobaNiefizyczna/etd:NIP|tns:PozycjeSzczegolowe/tns:P_C/tns:P_C10"/>
			<xsd:field xpath="."/>
		</xsd:unique>
		<xsd:unique name="klucz_REGON">
			<xsd:selector xpath="tns:Podmiot1/tns:OsobaNiefizyczna/etd:REGON|tns:PozycjeSzczegolowe/tns:P_C/tns:P_C12"/>
			<xsd:field xpath="."/>
		</xsd:unique>
	</xsd:element>
	<xsd:element name="PozycjeSzczegolowe">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="P_5" type="etd:TWybor1" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Nr formularza</xsd:documentation>
					</xsd:annotation>
					<!--Należy podać kolejny numer formularza w ogólnej liczbie wszystkich składanych przez podatnika formularzy CIT-VC-->
				</xsd:element>
				<xsd:element name="P_C" maxOccurs="unbounded">
					<xsd:annotation>
						<xsd:documentation>C. Informacja o nabytych udziałach (akcjach)</xsd:documentation>
					</xsd:annotation>
					<!--Dotyczy nabytych udziałów (akcji) w spółkach, o których mowa w art. 14 ust. 3 pkt 1 ustawy z dnia 25 września 2015 r. o zmianie niektórych ustaw w związku ze wspieraniem innowacyjności.-->
					<xsd:complexType>
						<xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>C.1.Dane spółki, której udziały (akcje) zostały nabyte</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_C10" type="etd:TNrNIP">
									<xsd:annotation>
										<xsd:documentation>Identyfikator podatkowy NIP spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C11">
									<xsd:annotation>
										<xsd:documentation>Nazwa pełna</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="xsd:token">
											<xsd:minLength value="1"/>
											<xsd:maxLength value="240"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_C12" type="etd:TNrREGON" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Numer REGON</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C13" type="etd:TNrIdentyfikacjiPodatkowej" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Numer identyfikacyjny spółki</xsd:documentation>
									</xsd:annotation>
									<!--Należy podać numer służący identyfikacji dla celów podatkowych uzyskany w państwie, w którym spółka ma siedzibę, a w przypadku braku takiego numeru, należy podać inny numer identyfikacyjny nadany w kraju, w którym spółka ma siedzibę.-->
								</xsd:element>
								<xsd:element name="P_C14" type="etd:TKodKrajuWydania" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Kod kraju wydania numeru identyfikacyjnego</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>C.1.1. Adres siedziby</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_C15A" type="etd:TKodKraju">
									<xsd:annotation>
										<xsd:documentation>Kod kraju</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C16" type="etd:TJednAdmin" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Województwo</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C17" type="etd:TJednAdmin" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Powiat</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C18" type="etd:TJednAdmin" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Gmina</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C19" type="etd:TUlica" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Ulica</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C20" type="etd:TNrBudynku" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Nr domu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C21" type="etd:TNrLokalu" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Nr lokalu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C22" type="etd:TMiejscowosc">
									<xsd:annotation>
										<xsd:documentation>Miejscowość</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C23" type="etd:TKodPocztowy" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Kod pocztowy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_C24" type="etd:TMiejscowosc" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Poczta</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_C25">
								<xsd:annotation>
									<xsd:documentation>C.1.2. Łączna wartość nabytych udziałów (akcji) w spółce - wartość</xsd:documentation>
								</xsd:annotation>
								<!--Należy podać - według stanu obowiązującego na ostatni dzień roku, za który jest składana informacja - łączną wartość nabytych w tym roku udziałów (akcji) według ceny nabycia lub wartości wkładu niepieniężnego, za który zostały objęte, określonej w umowie (statucie).-->
								<xsd:simpleType>
									<xsd:restriction base="etd:TKwota2Nieujemna">
										<xsd:minExclusive value="0"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
						</xsd:sequence>
						<xsd:attribute name="typ" use="required" fixed="G"/>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="P_27" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Data wypełnienia informacji</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="etd:TData">
							<xsd:minInclusive value="2017-01-01"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>