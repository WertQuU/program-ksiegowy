<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:csta="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/01/24/eD/CITSTA/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/01/24/eD/CITSTA/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/StrukturyDanych_v5-0E.xsd"/>
	<xsd:complexType name="TNaglowek_CIT-ST_A">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="csta:TKodFormularza_STA">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CTSTAR (5)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="4-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="5"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_STA">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-ST/A"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT-ST_A">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O ZAKŁADACH (ODDZIAŁACH)</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="csta:TNaglowek_CIT-ST_A"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Wykaz zakładów (oddziałów)</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_2A" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Zał. nr</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_B1" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Dane identyfikacyjne oraz adres zakładu (oddziału)</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:annotation>
											<xsd:documentation/>
										</xsd:annotation>
										<xsd:element name="P_1" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Nazwa pełna</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_2" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Nazwa skrócona</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="etd:TZnakowy">
													<xsd:maxLength value="70"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="P_3" type="etd:TNrREGON" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>REGON</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_4" type="etd:TNrNIP" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_5" type="etd:TData" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Data rozpoczęcia działalności</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_6A" type="etd:TKodKraju">
											<xsd:annotation>
												<xsd:documentation>Kod kraju</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_7" type="etd:TJednAdmin" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Województwo</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_8" type="etd:TJednAdmin" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Powiat</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_9" type="etd:TJednAdmin" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Gmina</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_10" type="etd:TUlica" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Ulica</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_11" type="etd:TNrBudynku" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Nr domu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_12" type="etd:TNrLokalu" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Nr lokalu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_13" type="etd:TMiejscowosc">
											<xsd:annotation>
												<xsd:documentation>Miejscowość</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_14" type="etd:TKodPocztowy" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Kod pocztowy</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_15" type="etd:TMiejscowosc" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Poczta</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
