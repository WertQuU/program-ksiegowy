<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2015 (http://www.altova.com) by MF (Ministerstwo Finansów) -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.mf.gov.pl/schematy/MDR/DefinicjeTypy/2018/12/14/DefinicjeTypyMdr/Mdr3" xmlns:mdr="http://www.mf.gov.pl/schematy/MDR/DefinicjeTypy/2018/12/14/DefinicjeTypyMdr/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" targetNamespace="http://www.mf.gov.pl/schematy/MDR/DefinicjeTypy/2018/12/14/DefinicjeTypyMdr/Mdr3" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/StrukturyDanych_v4-0E.xsd"/>
	<xsd:import namespace="http://www.mf.gov.pl/schematy/MDR/DefinicjeTypy/2018/12/14/DefinicjeTypyMdr/" schemaLocation="https://www.mf.gov.pl/documents/764034/6625111/mdr.xsd"/>
	<xsd:complexType name="TInfoOgolne">
		<xsd:annotation>
			<xsd:documentation>WSKAZANIE INNYCH PODMIOTÓW UCZESTNICZĄCYCH W SCHEMACIE PODATKOWYM LUB OBOWIĄZANYCH DO PRZEKAZANIA INFORMACJI O SCHEMACIE PODATKOWYM </xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:choice>
				<xsd:element name="IdOsobyFizycznejPLMDR" type="mdr:TIdOsobyFizycznejPL">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne osoby fizycznej mającej miejsce zamieszkania na terytorium Rzeczypospolitej Polskiej</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="IdOsobyFizycznejZagMDR" type="mdr:TOsobaZagranicznaFizyczna">
					<xsd:annotation>
						<xsd:documentation>Dane identyfikacyjne osoby fizycznej niemającej miejsca zamieszkania na terytorium Rzeczypospolitej Polskiej</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="IdOsobyNiefizycznejMDR" type="mdr:TIdOsobyNiefizycznejMDR">
					<xsd:annotation>
						<xsd:documentation>Dane podmiotu niebędącego osobą fizyczną</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:choice>
			<xsd:element name="AdresZamieszkaniaSiedziby" type="mdr:TAdres">
				<xsd:annotation>
					<xsd:documentation>Adres zamieszkania / siedziby</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute name="typ">
			<xsd:simpleType>
				<xsd:restriction base="xsd:string">
					<xsd:enumeration value="Promotor"/>
					<xsd:enumeration value="Wspomagający"/>
					<xsd:enumeration value="Korzystający"/>
					<xsd:enumeration value="Inny podmiot"/>
				</xsd:restriction>
			</xsd:simpleType>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="TNaglowek">
		<xsd:annotation>
			<xsd:documentation>Nagłówek informacji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:annotation>
					<xsd:documentation>Kod formularza</xsd:documentation>
				</xsd:annotation>
				<xsd:complexType>
					<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="MDR-3"/>
					<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0"/>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="CelZlozenia" type="xsd:string" fixed="1">
				<xsd:annotation>
					<xsd:documentation>Cel złożenia</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:choice>
				<xsd:annotation>
					<xsd:documentation>Rodzaj okresu rozliczeniowego</xsd:documentation>
				</xsd:annotation>
				<xsd:element name="DataRozliczenia" type="etd:TData">
					<xsd:annotation>
						<xsd:documentation>Data, jeśli okres rozliczeniowy jest jednodniowy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:sequence>
					<xsd:annotation>
						<xsd:documentation>Okres rozliczeniowy</xsd:documentation>
					</xsd:annotation>
					<xsd:element name="DataOd" type="etd:TData">
						<xsd:annotation>
							<xsd:documentation>Data początku okresu rozliczeniowego</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="DataDo" type="etd:TData">
						<xsd:annotation>
							<xsd:documentation>Data końca okresu rozliczeniowego</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="Informacja">
		<xsd:annotation>
			<xsd:documentation>MDR-3 informacja korzystającego o schemacie podatkowym</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="tns:TNaglowek">
					<xsd:annotation>
						<xsd:documentation>Nagłówek informacji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="ZakresZgloszenia" type="mdr:TZakresZgloszenia">
					<xsd:annotation>
						<xsd:documentation>Cel złożenia informacji</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="DaneKorzystajacego">
					<xsd:annotation>
						<xsd:documentation>Informacje o korzystającym</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:choice>
								<xsd:element name="IdOsobyFizycznej" type="mdr:TIdOsobyFizycznejPL">
									<xsd:annotation>
										<xsd:documentation>Dane identyfikacyjne osoby fizycznej mającej miejsce zamieszkania na terytorium Rzeczypospolitej Polskiej</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="IdOsobyFizycznejZag" type="mdr:TOsobaZagranicznaFizyczna">
									<xsd:annotation>
										<xsd:documentation>Dane identyfikacyjne osoby fizycznej niemającej miejsca zamieszkania na terytorium Rzeczypospolitej Polskiej</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="IdOsobyNiefizycznej">
									<xsd:annotation>
										<xsd:documentation>Dane podmiotu niebędącego osobą fizyczną</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:complexContent>
											<xsd:extension base="mdr:TIdOsobyNiefizycznejMDR"/>
										</xsd:complexContent>
									</xsd:complexType>
								</xsd:element>
							</xsd:choice>
							<xsd:element name="AdresZamieszkaniaSiedziby" type="mdr:TAdres">
								<xsd:annotation>
									<xsd:documentation>Adres zamieszkania / siedziby</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Korzysci" type="tns:TKorzysci">
					<xsd:annotation>
						<xsd:documentation>Informacja o odniesionych korzyściach podatkowych</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="InfoDodatkowe">
					<xsd:annotation>
						<xsd:documentation>Informacje dodatkowe o zgłaszanym schemacie podatkowym</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="CelSchematu">
								<xsd:annotation>
									<xsd:documentation>Wskazanie celów, których realizacji schemat podatkowy ma służyć</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="10000"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="PrzepisyPrawa">
								<xsd:annotation>
									<xsd:documentation>Przepisy prawa podatkowego znajdujące, według wiedzy składającego informację, zastosowanie w schemacie podatkowym</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="10000"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="WartoscKorzysci" type="etd:TKwota2">
								<xsd:annotation>
									<xsd:documentation>Szacunkowa wartość korzyści podatkowej lub przybliżona wartość aktywa w podatku odroczonym, jeśli występuje i jest znana lub możliwa do oszacowania przekazującemu informację, w złotych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="WartoscKorzysciTransgra" type="etd:TKwota2">
								<xsd:annotation>
									<xsd:documentation>Wartość korzyści podatkowej schematu podatkowego transgranicznego w złotych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Wskazanie dokonanych czynności, które skutkowały przekazaniem informacji o schemacie podatkowym, wraz ze wskazaniem dnia, w którym została lub zostanie dokonana pierwsza czynność, służąca wdrożeniu tego schemat</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="Data" type="etd:TData">
									<xsd:annotation>
										<xsd:documentation>Dzień, w którym została lub zostanie dokonana pierwsza czynność, służąca wdrożeniu tego schematu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="Czynnosc" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Wskazanie dokonanych czynności, które skutkowały przekazaniem informacji o schemacie podatkowym</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="xsd:string">
											<xsd:maxLength value="2000"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="EtapWdorozenia">
								<xsd:annotation>
									<xsd:documentation>Wskazanie etapu, na jakim zgodnie z wiedzą składającego informację znajduje się schemat podatkowy, w szczególności informacji o terminach jego udostępniania lub wdrażania lub o dacie czynności w ramach uzgodnienia</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="10000"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="OpisSchematu">
					<xsd:annotation>
						<xsd:documentation>Opis schematu podatkowego</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="RodzajPodatku" type="mdr:TRodzajPodatku">
								<xsd:annotation>
									<xsd:documentation>Przepisy prawa podatkowego znajdujące zastosowanie w schemacie podatkowym</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="InfoGrupaKapitalowa" type="etd:TWybor1_2">
								<xsd:annotation>
									<xsd:documentation>Korzystający wchodzi w skład Podatkowej Grupy Kapitałowej (1 - TAK, 2 - NIE)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="ZmianaOpisuSchematu" type="etd:TWybor1_2">
								<xsd:annotation>
									<xsd:documentation>Korzystający modyfikuje otrzymane dane dla zapewnienia ich zgodności ze stanem rzeczywistym (art. 86j § 3 ustawy, 1 - TAK, 2 - NIE)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="SchematDotyczy">
								<xsd:annotation>
									<xsd:documentation>Schemat podatkowy dotyczy działań (1 - TAK, 2 - NIE)</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:complexContent>
										<xsd:extension base="mdr:TSchematDot"/>
									</xsd:complexContent>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="SchematDotTranskacji">
								<xsd:annotation>
									<xsd:documentation>Schemat podatkowy obejmuje transakcje / zdarzenia (1 - TAK, 2 - NIE)</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:complexContent>
										<xsd:extension base="mdr:TSchematTransakcje"/>
									</xsd:complexContent>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="SchematPodmioty" type="mdr:TSchematPodmioty">
								<xsd:annotation>
									<xsd:documentation>W schemacie podatkowym występuje którykolwiek ze wskazanych typów podmiotów </xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="UmowaUnikania">
								<xsd:annotation>
									<xsd:documentation>Do schematu podatkowego zastosowanie ma umowa o unikaniu podwójnego opodatkowania (wskaż umowę o unikaniu podwójnego opodatkowania: 1 - TAK, 2 - NIE)</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:complexContent>
										<xsd:extension base="mdr:TUmowyUnikPodOpodatkowanie">
											<xsd:sequence>
												<xsd:element name="Inne" minOccurs="0">
													<xsd:simpleType>
														<xsd:restriction base="xsd:string">
															<xsd:maxLength value="1000"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:element>
											</xsd:sequence>
										</xsd:extension>
									</xsd:complexContent>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="PodstawaPrawna">
								<xsd:annotation>
									<xsd:documentation>Podstawa prawna przekazywania informacji o schemacie podatkowym ze wskazaniem przesłanek skutkujących uznaniem danego uzgodnienia za schemat podatkowy
</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="5000"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="CechaRozpoznawcza" type="mdr:TCechaRozInformacji">
								<xsd:annotation>
									<xsd:documentation>Cecha rozpoznawcza informacji o schemacie podatkowym (1 - TAK, 2 - NIE)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="RolaSkladajcego">
								<xsd:annotation>
									<xsd:documentation>Rola składającego informację o schemacie podatkowym </xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="5000"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="Streszczenie">
								<xsd:annotation>
									<xsd:documentation>Streszczenie opisu uzgodnienia stanowiącego schemat podatkowy, opis działalności gospodarczej, do której ma zastosowanie schemat podatkowy, 
bez ujawnienia danych objętych tajemnicą handlową, przemysłową, zawodową lub procesu produkcyjnego  
</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="5000"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="DataUzgodnienia">
								<xsd:annotation>
									<xsd:documentation>Dzień, w którym została lub zostanie dokonana pierwsza czynność służąca wdrożeniu uzgodnienia</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:simpleContent>
										<xsd:extension base="etd:TData"/>
									</xsd:simpleContent>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PelnyOpisSchematu" maxOccurs="20">
					<xsd:annotation>
						<xsd:documentation>Pełny opis zgłaszanego schematu podatkowego</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="OpisSchematuPod">
								<xsd:annotation>
									<xsd:documentation>Wyczerpujący opis uzgodnienia stanowiącego schemat podatkowy, założeń uzgodnienia, czynności dokonywanych w ramach uzgodnienia i ich chronologii oraz występujących powiązań pomiędzy podmiotami powiązanymi</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:string">
										<xsd:maxLength value="5000"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="WartoscKorzysci" type="etd:TKwotaC">
								<xsd:annotation>
									<xsd:documentation>Wartość przedmiotu czynności uzgodnienia stanowiącego schemat podatkowy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Uczestnicy" type="tns:TInfoOgolne" minOccurs="0" maxOccurs="unbounded">
					<xsd:annotation>
						<xsd:documentation>Wskazanie innych podmiotów uczestniczących w schemacie podatkowym, mających uczestniczyć w schemacie podakowym lub na które może mieć wpływ schemat podatkowy</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<!-- Przeprobić na tytpy proste-->
				<xsd:element name="ObowiazaniInni" type="tns:TInfoOgolne" minOccurs="0" maxOccurs="unbounded">
					<xsd:annotation>
						<xsd:documentation>Wskazanie innych podmiotów obowiązanych do przekazania informacji o schemacie podatkowym</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="DodatkoweWyjasnienia" minOccurs="0">
					<xsd:annotation>
						<xsd:documentation>Dodatkowe wyjaśnienia. Pole wymagane w przypadku złożenia uzupełnienia.</xsd:documentation>
					</xsd:annotation>
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:maxLength value="10000"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
				<xsd:element name="Oswiadczenie" fixed="Oświadczam, że wszystkie dane zawarte w niniejszym dokumencie są prawdziwe.">
					<xsd:annotation>
						<xsd:documentation>Oświadczam, że wszystkie dane zawarte w niniejszym dokumencie są prawdziwe.</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="Klauzula" fixed="Jestem świadomy odpowiedzialności karnej za złożenie fałszywego oświadczenia.">
					<xsd:annotation>
						<xsd:documentation>Jestem świadomy odpowiedzialności karnej za złożenie fałszywego oświadczenia.</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="DoreczenieElektroniczne">
					<xsd:annotation>
						<xsd:documentation>Adres ePUAP do doręczenia</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="tns:TDoreczenieElektroniczne"/>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="TKorzysci">
		<xsd:annotation>
			<xsd:documentation>Informacja o odniesionych korzyściach podatkowych</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="UzycieSchematu" type="etd:TWybor1_2">
				<xsd:annotation>
					<xsd:documentation>Korzystający dokonywał w danym okresie rozliczeniowym jakichkolwiek czynności będących elementem schematu podatkowego (1 - TAK, 2 - NIE)</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="KwotaKorzysci" type="etd:TKwota2" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Wysokość korzyści podatkowej wynikającej ze schematu podatkowego, w złotych, jeżeli korzystający uzyskiwał w danym okresie rozliczeniowym taką korzyść</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TDoreczenieElektroniczne">
		<xsd:annotation>
			<xsd:documentation>Podanie adresu do doręczeń elektronicznych</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="OswiadczenieAdresEPUAP" fixed="Wyrażam zgodę na doręczenie potwierdzenia nadania NSP wyłącznie za pomocą środków komunikacji elektronicznej (art. 86f § 1 pkt 13 ustawy).">
				<xsd:annotation>
					<xsd:documentation>Treść oświadczenia</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="AdresEPUAP" type="etd:TZnakowy">
				<xsd:annotation>
					<xsd:documentation>Adres skrzynki ePUAP</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
