<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czip="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITIP/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2019/11/29/eD/CITIP/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/08/24/eD/DefinicjeTypy/StrukturyDanych_v5-0E.xsd"/>
	<!--Załącznik do zeznań: CIT-8 i CIT-8AB.-->
	<!-- -->
	<!--Wypełniają podatnicy, do których ma zastosowanie art. 24d ustawy. Podatnicy wypełniają załącznik CIT/IP po uprzednim obliczeniu dochodu (straty) dla każdego kwalifikowanego prawa własności intelektualnej.-->
	<xsd:complexType name="TNaglowek_CIT_IP">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czip:TKodFormularza_CIT_IP">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT/IP (1)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza" type="xsd:byte" fixed="1"/>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czip:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czip:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2019-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_IP">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/IP"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_IP">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI DOCHODU (PONIESIONEJ STRATY) Z KWALIFIKOWANYCH PRAW WŁASNOŚCI INTELEKTUALNEJ</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czip:TNaglowek_CIT_IP"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dotyczące kwalifikowanych praw własności intelektualnej, w tym ekspektatyw ich uzyskania, zwanych kwalifikowanymi prawami, dane dotyczące łącznych przychodów, kosztów uzyskania przychodów, dochodów i strat uzyskanych z kwalifikowanych praw, obliczenie podatku, informacje dotyczące zezwolenia lub decyzji o wsparciu</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_6" type="etd:TWybor1">
								<xsd:annotation>
									<xsd:documentation>Łączna liczba składanych załączników</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące kwalifikowanych praw własności intelektualnej, w tym ekspektatyw ich uzyskania, zwanych kwalifikowanymi prawami</xsd:documentation>
								</xsd:annotation>
								<!--Rodzaj kwalifikowanego prawa własności intelektualnej podlegającego ochronie prawnej na podstawie przepisów odrębnych ustaw lub ratyfikowanych umów międzynarodowych, których stroną jest Rzeczpospolita Polska oraz innych umów międzynarodowych, których stroną jest Unia Europejska, których przedmiot ochrony został wytworzony, rozwinięty lub ulepszony przez podatnika w ramach prowadzonej przez niego działalności badawczo - rozwojowej (art. 24d ust. 2 ustawy).-->
								<xsd:element name="P_8" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Patent - Liczba</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_9" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Prawo ochronne na wzór użytkowy - Liczba</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_10" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Prawo z rejestracji wzoru przemysłowego - Liczba</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_11" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Prawo z rejestracji topografii układu scalonego - Liczba</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_12" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Dodatkowe prawo ochronne dla patentu na produkt leczniczy lub produkt ochronny roślin - Liczba</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_13" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Prawo z rejestracji produktu leczniczego i produktu leczniczego weterynaryjnego dopuszczonych do obrotu - Liczba</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_14" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Wyłączne prawo, o którym mowa w ustawie z dnia 26 czerwca 2003 r. o ochronie prawnej odmian roślin (Dz. U. z 2018 r. poz. 432) - Liczba</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_15" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Autorskie prawo do programu komputerowego - Liczba</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_16" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Ekspektatywa - Liczba</xsd:documentation>
									</xsd:annotation>
									<!--Należy wskazać ekspektatywy według stanu na ostatni dzień roku podatkowego, za który składane jest zeznanie.-->
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące łącznych przychodów, kosztów uzyskania przychodów, dochodów i strat uzyskanych z kwalifikowanych praw</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_17" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Kwalifikowany dochód z kwalifikowanego prawa obliczany jest dla tego samego rodzaju produktu lub usługi, lub dla tej samej grupy produktów lub usług: 1 - tak</xsd:documentation>
									</xsd:annotation>
									<!--Wypełnia podatnik, który oblicza dochody zgodnie z art. 24d ust. 9 ustawy.-->
								</xsd:element>
								<xsd:element name="P_18" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychody z kwalifikowanych praw</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_19" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów związane z kwalifikowanymi prawami</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_20" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwalifikowany dochód (dochody) z kwalifikowanych praw obliczony (obliczone) zgodnie z art. 24d ust. 4 ustawy</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 20 należy wykazać sumę kwalifikowanych dochodów z kwalifikowanych praw zgodnie z art. 24d ust. 3 ustawy.-->
								</xsd:element>
								<xsd:element name="P_21" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwalifikowany dochód z kwalifikowanych praw obliczony zgodnie z art. 24d ustawy, zwolniony od podatku - na podstawie art. 17 ust. 1 pkt 34 i 34a ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_22" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód z kwalifikowanych praw niepodlegający opodatkowaniu stawką 5%, o której mowa w art. 24d ust. 1 ustawy</xsd:documentation>
									</xsd:annotation>
									<!--W sytuacji, gdy wskaźnik, o którym mowa w art. 24d ust. 4 ustawy jest niższy niż wartość 1, część dochodu z kwalifikowanych praw nie podlega opodatkowaniu stawką 5%.-->
								</xsd:element>
								<xsd:element name="P_23" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Strata (straty) z kwalifikowanych praw poniesiona (-e) w bieżącym roku podatkowym</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Obliczenie podatku</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_24" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Podstawa opodatkowania</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_25" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Obliczony podatek zgodnie z art. 24d ust. 1 ustawy przy zastosowaniu stawki 5%</xsd:documentation>
									</xsd:annotation>
									<!--Należy obliczyć podatek od kwoty z poz. 24.-->
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_E" minOccurs="0" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Informacje dotyczące zezwolenia lub decyzji o wsparciu</xsd:documentation>
								</xsd:annotation>
								<!--Wypełnia podatnik, o którym mowa w art. 17 ust. 1 pkt 34 i 34a ustawy.-->
								<xsd:complexType>
									<xsd:sequence>
										<xsd:annotation>
											<xsd:documentation>Rodzaj kwalifikowanego prawa</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_E26" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Numer zezwolenia lub decyzji o wsparciu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_E27" type="etd:TData">
											<xsd:annotation>
												<xsd:documentation>Data wydania zezwolenia lub decyzji o wsparciu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_E28">
											<xsd:annotation>
												<xsd:documentation>Jednostka terytorialna realizacji inwestycji (należy podać informację zgodnie z NUTS 2016 EUROSTAT)</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="xsd:string">
													<xsd:pattern value="PL[24-9]{1}[1-4]{1}[1-9]{1}"/>
													<xsd:pattern value="PL[2]{2}[ABC]{1}"/>
													<xsd:pattern value="PL21A|PLZZZ"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="P_E29" type="etd:TKwota2Nieujemna">
											<xsd:annotation>
												<xsd:documentation>Dochód z kwalifikowanych praw podlegający zwolnieniu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
