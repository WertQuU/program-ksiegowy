<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:zd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/10/27/eD/PITD/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/10/27/eD/PITD/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<!--Załącznik do zeznań: PIT-28, PIT-36 i PIT-37.-->
	<!-- -->
	<!--Małżonkowie, bez względu na sposób rozliczenia rocznego (indywidualnie albo wspólnie z małżonkiem), składają jeden załącznik PIT/D, podając w nim dane identyfikacyjne obojga małżonków. Zasada ta nie dotyczy małżonków, w stosunku do których orzeczono separację.-->
	<xsd:complexType name="TNaglowek_PIT_D">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zd:TKodFormularza_PIT_D">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT/D (30)"/>
							<xsd:attribute name="kodPodatku" type="xsd:string" use="required" fixed="PIT"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="2-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="30"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_PIT_D">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/D"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_PIT_D">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O ODLICZENIU WYDATKÓW MIESZKANIOWYCH w roku podatkowym</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zd:TNaglowek_PIT_D"/>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TIdentyfikatorOsobyFizycznej1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Podmiot2" minOccurs="0">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="etd:TIdentyfikatorOsobyFizycznej1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Małżonek"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Odliczenia od dochodu (przychodu), odliczenia od podatku</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<!--Podatnicy, którzy po raz pierwszy dokonują odliczeń w ramach ulgi odsetkowej, wraz z załącznikiem PIT/D składają oświadczenie PIT-2K.-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Ulga odsetkowa z tytułu spłaty odsetek od kredytu (pożyczki) zaciągniętego na cele mieszkaniowe</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_10" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Wydatki poniesione na spłatę odsetek od kredytu (pożyczki), przypadające do odliczenia w roku podatkowym</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_11" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota wydatków przypadająca do odliczenia od przychodu w PIT-28</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę tę należy przenieść do wiersza "Ulga odsetkowa - wykazana w części B załącznika PIT/D" zeznania PIT-28, zgodnie z opisem zamieszczonym w zeznaniu.-->
								</xsd:element>
								<xsd:element name="P_12" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota przypadająca do odliczenia od dochodu w PIT-36 lub w PIT-37</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 10 należy odjąć kwotę z poz. 11. Kwotę tę należy przenieść do wiersza „Ulga odsetkowa - wykazana w części B.1. załącznika PIT/D” zeznania PIT-36 lub PIT-37, zgodnie z opisami zamieszczonymi w zeznaniach.-->
								</xsd:element>
								<!--WNIOSEK MAŁŻONKÓW (Dotyczy tylko małżonków składających odrębne zeznania PIT-37 lub składających zeznania PIT-36, PIT-28) Informujemy, że kwotę z poz. 11 lub 12 odliczamy od naszego dochodu (przychodu) w następujący sposób:-->
								<xsd:element name="P_13" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Kwota wydatków mieszkaniowych - do odliczenia od przychodu w PIT-28</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 13 lub 14 należy przenieść do wiersza "Ulga odsetkowa - wykazana w części B załącznika PIT/D" zeznania PIT-28, zgodnie z opisem zamieszczonym w zeznaniu.-->
								</xsd:element>
								<xsd:element name="P_14" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - Kwota wydatków mieszkaniowych - do odliczenia od przychodu w PIT-28</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 13 lub 14 należy przenieść do wiersza "Ulga odsetkowa - wykazana w części B załącznika PIT/D" zeznania PIT-28, zgodnie z opisem zamieszczonym w zeznaniu.-->
								</xsd:element>
								<xsd:element name="P_15" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Kwota wydatków mieszkaniowych - do odliczenia od dochodu w PIT-36 lub w PIT-37</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 15 lub 16 należy przenieść do wiersza „Ulga odsetkowa - wykazana w części B.1. załącznika PIT/D” zeznania PIT-36 lub PIT-37, zgodnie z opisami zamieszczonymi w zeznaniach.-->
								</xsd:element>
								<xsd:element name="P_16" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - Kwota wydatków mieszkaniowych - do odliczenia od dochodu w PIT-36 lub w PIT-37</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 15 lub 16 należy przenieść do wiersza „Ulga odsetkowa - wykazana w części B.1. załącznika PIT/D” zeznania PIT-36 lub PIT-37, zgodnie z opisami zamieszczonymi w zeznaniach.-->
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<!--ODLICZENIA WYDATKÓW - NA ZASADZIE PRAW NABYTYCH (Dotyczy wydatków innych niż wymienione w części B.1.)-->
								<xsd:element name="P_17" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Wydatki mieszkaniowe poniesione w roku podatkowym - rodzaj</xsd:documentation>
									</xsd:annotation>
									<!--Do wysokości przysługującego limitu.-->
								</xsd:element>
								<xsd:element name="P_18" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Wydatki mieszkaniowe poniesione w roku podatkowym</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_19" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Odliczenia, które nie znalazły pokrycia w dochodzie (przychodzie) za lata ubiegłe</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<!--KWOTA PRZYPADAJĄCA DO ODLICZENIA OD DOCHODU (PRZYCHODU) W ROKU PODATKOWYM-->
								<xsd:element name="P_20" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Ogółem do odliczenia w roku podatkowym</xsd:documentation>
									</xsd:annotation>
									<!--Suma kwot z poz. 18 i 19.-->
								</xsd:element>
								<xsd:element name="P_21" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota przypadająca do odliczenia od przychodu w PIT-28</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę tę należy wpisać w w wierszu "Odliczenia mieszkaniowe - wykazane w części B.3. załącznika PIT/D" zeznania PIT-28, zgodnie z opisem zamieszczonym w zeznaniu.-->
								</xsd:element>
								<xsd:element name="P_22" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota przypadająca do odliczenia od dochodu w PIT-36 lub w PIT-37</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 20 należy odjąć kwotę z poz. 21. Kwotę tę należy wpisać w w wierszu "Odliczenia mieszkaniowe - wykazane w części B.3. załącznika PIT/D" zeznania PIT-36 lub PIT-37, zgodnie z opisami zamieszczonymi w zeznaniach.-->
								</xsd:element>
								<!--WNIOSEK MAŁŻONKÓW (Dotyczy tylko małżonków składających odrębne zeznania PIT-37 lub składających zeznania PIT-36, PIT-28, z wyjątkiem małżonków w stosunku do których orzeczono separację)
Informujemy, że kwotę z poz. 21 lub 22 odliczamy od naszego dochodu (przychodu) w następujący sposób:-->
								<xsd:element name="P_23" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Kwota wydatków mieszkaniowych - do odliczenia od przychodu w PIT-28</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 23 lub 24 należy wpisać w poz. 79 zeznania PIT-28 w wierszu "Odliczenia mieszkaniowe - wykazane w części B.3. załącznika PIT/D" zeznania PIT-28, zgodnie z opisem zamieszczonym w zeznaniu.-->
								</xsd:element>
								<xsd:element name="P_24" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - Kwota wydatków mieszkaniowych - do odliczenia od przychodu w PIT-28</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 23 lub 24 należy wpisać w poz. 79 zeznania PIT-28 w wierszu "Odliczenia mieszkaniowe - wykazane w części B.3. załącznika PIT/D" zeznania PIT-28, zgodnie z opisem zamieszczonym w zeznaniu.-->
								</xsd:element>
								<xsd:element name="P_25" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Kwota wydatków mieszkaniowych - do odliczenia od dochodu w PIT-36 lub w PIT-37</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 25 lub 26 należy wpisać w w wierszu "Odliczenia mieszkaniowe - wykazane w części B.3. załącznika PIT/D" zeznania PIT-36 lub PIT-37, zgodnie z opisami zamieszczonymi w zeznaniach-->
								</xsd:element>
								<xsd:element name="P_26" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek- Kwota wydatków mieszkaniowych - do odliczenia od dochodu w PIT-36 lub w PIT-37</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 25 lub 26 należy wpisać w w wierszu "Odliczenia mieszkaniowe - wykazane w części B.3. załącznika PIT/D" zeznania PIT-36 lub PIT-37, zgodnie z opisami zamieszczonymi w zeznaniach-->
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_27" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Kwota przysługującego odliczenia z tytułu systematycznego gromadzenia w roku podatkowym oszczędności na jednym rachunku oszczędnościowo-kredytowym i w jednym banku prowadzącym kasę mieszkaniową</xsd:documentation>
								</xsd:annotation>
								<!--30% wydatków poniesionych w roku podatkowym, nie więcej niż 11 340 zł w ramach przysługującego limitu odliczeń na dany rok.-->
							</xsd:element>
							<xsd:element name="P_28" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Odliczenia, które nie znalazły pokrycia w podatku za lata ubiegłe - kwota odliczenia</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence>
								<!--KWOTA PRZYPADAJĄCA DO ODLICZENIA OD PODATKU W ROKU PODATKOWYM-->
								<xsd:element name="P_29" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Ogółem do odliczenia w roku podatkowym</xsd:documentation>
									</xsd:annotation>
									<!--Suma kwot z poz. 27 i 28.-->
								</xsd:element>
								<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota przypadająca do odliczenia od podatku w PIT-28</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę tę należy wpisać w wierszu "Odliczenia mieszkaniowe - wykazane w części C.2 załącznika PIT/D" zeznania PIT-28, zgodnie z opisem zamieszczonym w zeznaniu.-->
								</xsd:element>
								<xsd:element name="P_31" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota przypadająca do odliczenia od podatku w PIT-36 lub w PIT-37</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 29 należy odjąć kwotę z poz. 30. Kwotę tę należy wpisać w wierszu "Odliczenia mieszkaniowe - wykazane w części C.2 załącznika PIT/D" zeznania PIT-36 lub PIT-37, zgodnie z opisami zamieszczonymi w zeznaniach.-->
								</xsd:element>
								<!--WNIOSEK MAŁŻONKÓW (Dotyczy tylko małżonków składających odrębne zeznania PIT-36, PIT-37 lub składających zeznania PIT-28, z wyjątkiem małżonków, w stosunku do których orzeczono separację) Informujemy, że kwotę z poz. 30 lub 31 odliczamy od naszego podatku w następujący sposób:-->
								<xsd:element name="P_32" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Kwota wydatków mieszkaniowych - do odliczenia od podatku w PIT-28</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 32 lub 33 należy wpisać w wierszu "Odliczenia mieszkaniowe - wykazane w części C.2 załącznika PIT/D" zeznania PIT-28, zgodnie z opisem zamieszczonym w zeznaniu.-->
								</xsd:element>
								<xsd:element name="P_33" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - Kwota wydatków mieszkaniowych - do odliczenia od podatku w PIT-28</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 32 lub 33 należy wpisać w wierszu "Odliczenia mieszkaniowe - wykazane w części C.2 załącznika PIT/D" zeznania PIT-28, zgodnie z opisem zamieszczonym w zeznaniu.-->
								</xsd:element>
								<xsd:element name="P_34" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - Kwota wydatków mieszkaniowych - do odliczenia od podatku w PIT-36 lub w PIT-37</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 34 lub 35 należy wpisać w wierszu "Odliczenia mieszkaniowe - wykazane w części C.2 załącznika PIT/D" zeznania PIT-36 lub PIT-37, zgodnie z opisami zamieszczonymi w zeznaniach.-->
								</xsd:element>
								<xsd:element name="P_35" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - Kwota wydatków mieszkaniowych - do odliczenia od podatku w PIT-36 lub w PIT-37</xsd:documentation>
									</xsd:annotation>
									<!--Kwotę z poz. 34 lub 35 należy wpisać w wierszu "Odliczenia mieszkaniowe - wykazane w części C.2 załącznika PIT/D" zeznania PIT-36 lub PIT-37, zgodnie z opisami zamieszczonymi w zeznaniach.-->
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
		<xsd:unique name="klucz_NIP_PESEL">
			<xsd:selector xpath="zd:Podmiot1|zd:Podmiot2"/>
			<xsd:field xpath="etd:NIP|etd:PESEL"/>
		</xsd:unique>
	</xsd:element>
</xsd:schema>
