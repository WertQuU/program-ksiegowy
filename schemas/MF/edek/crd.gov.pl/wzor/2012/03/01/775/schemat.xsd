					<xsd:complexType>
						<xsd:sequence>
							<xsd:element ref="zzu:Zalacznik_ORD-ZU"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
