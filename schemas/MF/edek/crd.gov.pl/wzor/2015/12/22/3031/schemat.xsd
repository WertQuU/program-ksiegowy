						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="0"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_23" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Liczba podatników za m-c IX</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="0"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_24" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Liczba podatników za m-c X</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="0"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_25" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Liczba podatników za m-c XI</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
