					<xsd:element name="P_19" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Należne zaliczki za m-c V</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_20" type="etd:TKwotaCNieujemna" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Należne zaliczki za m-c VI</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="P_21" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Liczba podatników za m-c VII</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="etd:TNaturalny">
								<xsd:minInclusive value="0"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="P_22" minOccurs="0">
						<xsd:annotation>
