<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:cznz="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITNZI/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/" xmlns:kue="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2013/05/23/eD/KodyUE/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/05/13/eD/CITNZI/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2013/05/23/eD/KodyUE/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2013/05/23/eD/KodyUE/KodyKrajowUE_v2-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2020/03/11/eD/DefinicjeTypy/StrukturyDanych_v6-0E.xsd"/>
	<!--Załącznik do zeznań: CIT-8 i CIT-8AB.-->
	<!-- -->
	<!--Wypełniają podatnicy, którzy uwzględnili w kosztach uzyskania przychodów wartość rynkową składnika majątku, w tym przedsiębiorstwa lub jego zorganizowanej części, określoną w państwie członkowskim Unii Europejskiej do celów opodatkowania podatkiem równoważnym do podatku od dochodów z niezrealizowanych zysków.-->
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2020-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TNaglowek_CIT_NZI">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cznz:TKodFormularza_CIT_NZI">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CITNZI (2)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="2-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="2"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cznz:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cznz:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_CIT_NZI">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/NZI"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_NZI">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI WARTOŚCI RYNKOWEJ SKŁADNIKA MAJĄTKU OKREŚLONEJ W PAŃSTWIE CZŁONKOWSKIM UNII EUROPEJSKIEJ DO CELÓW OPODATKOWANIA PODATKIEM RÓWNOWAŻNYM DO PODATKU OD DOCHODÓW Z NIEZREALIZOWANYCH ZYSKÓW</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="cznz:TNaglowek_CIT_NZI"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacje dodatkowe, informacja o wysokości wartości rynkowej składnika majątku, w tym przedsiębiorstwa lub zorganizowanej części przedsiębiorstwa</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_8" type="kue:TKodKrajuUE">
								<xsd:annotation>
									<xsd:documentation>Kod kraju, w którym określona została wartość rynkowa składnika majątku</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_C" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące składnika majątku</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="P_C10" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Rodzaj składnika majątku, przeniesionego na terytorium Rzeczypospolitej Polskiej</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_C11">
											<xsd:annotation>
												<xsd:documentation>Wartość rynkowa składnika majątku, o którym mowa w art. 24j ustawy</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="etd:TKwota2Nieujemna">
													<xsd:minExclusive value="0"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:sequence>
											<xsd:element name="P_C12" type="etd:TWybor1_2">
												<xsd:annotation>
													<xsd:documentation>Wartość rynkowa została określona przez właściwy organ państwa: 1 - tak, 2 - nie</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_C13" type="etd:TZnakowy" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Jeśli wartość rynkową określił podatnik, należy wskazać metodę przyjętą dla określenia wartości rynkowej składnika majątku. Wypełniają podatnicy, którzy w P_C12 wybrali wartość 2</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:element name="P_C14" type="etd:TWybor1_2">
											<xsd:annotation>
												<xsd:documentation>Wartość rynkowa została potwierdzona przez właściwy organ państwa: 1 - tak, 2 - nie</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
