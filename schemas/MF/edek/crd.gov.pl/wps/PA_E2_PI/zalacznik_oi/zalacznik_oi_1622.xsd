<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:czmit="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITMIT/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2018/07/09/eD/CITMIT/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2016/01/25/eD/DefinicjeTypy/StrukturyDanych_v4-0E.xsd"/>
	<!--Załącznik do zeznań: CIT-8 i CIT-8AB.-->
	<xsd:complexType name="TNaglowek_CIT_MIT">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czmit:TKodFormularza_CIT_MIT">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CITMIT (1)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czmit:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czmit:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2018-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_MIT">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/MIT"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_MIT">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O ŚRODKACH TRWAŁYCH ORAZ PRZYCHODACH SKŁADANA PRZEZ PODATNIKA OBOWIĄZANEGO DO ZAPŁATY PODATKU, O KTÓRYM MOWA W ART. 24B USTAWY</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czmit:TNaglowek_CIT_MIT"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacja o środkach trwałych</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_B" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Informacja o środku trwałym</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="P_B8" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Nazwa środka trwałego</xsd:documentation>
											</xsd:annotation>
											<!--Należy podać nazwę środka trwałego wynikającą z obowiązującej Klasyfikacji Środków Trwałych-->
										</xsd:element>
										<xsd:element name="P_B9" type="etd:TKwotaCNieujemna">
											<xsd:annotation>
												<xsd:documentation>Wartość początkowa środka trwałego</xsd:documentation>
											</xsd:annotation>
											<!--Należy podać wartość początkową wynikającą z prowadzonej ewidencji.-->
										</xsd:element>
										<xsd:sequence minOccurs="0">
											<xsd:element name="P_B10" type="etd:TWybor1">
												<xsd:annotation>
													<xsd:documentation>Wartość początkowa zmieniła się w trakcie roku podatkowego: 1 - tak</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B11" type="etd:TKwotaCNieujemna">
												<xsd:annotation>
													<xsd:documentation>Zmieniona wartość początkowa</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<xsd:annotation>
												<xsd:documentation>Przychód w poszczególnych miesiącach</xsd:documentation>
											</xsd:annotation>
											<xsd:element name="P_B12" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 1</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B13" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 2</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B14" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 3</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B15" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 4</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B16" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 5</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B17" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 6</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B18" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 7</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B19" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 8</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B20" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 9</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B21" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 10</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B22" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 11</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B23" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 12</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B24" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 13</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B25" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 14</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B26" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 15</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B27" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 16</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B28" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 17</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B29" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 18</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B30" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 19</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B31" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 20</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B32" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 21</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B33" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 22</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B34" type="etd:TKwotaCNieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Przychód za miesiąc 23</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
