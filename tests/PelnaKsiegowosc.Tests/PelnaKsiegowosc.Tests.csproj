<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1030</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PelnaKsiegowosc.Infrastructure\PelnaKsiegowosc.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\PelnaKsiegowosc.Migrations.Sqlite\PelnaKsiegowosc.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\PelnaKsiegowosc.Migrations.PostgreSql\PelnaKsiegowosc.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\PelnaKsiegowosc.Presentation\PelnaKsiegowosc.Presentation.csproj" />
    <ProjectReference Include="..\..\src\PelnaKsiegowosc.Cli\PelnaKsiegowosc.Cli.csproj" />
    <!-- tylko kolejność budowania: test uruchamia program okienkowy w trybie kontroli uruchomienia -->
    <ProjectReference Include="..\..\src\PelnaKsiegowosc.App\PelnaKsiegowosc.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="..\..\schemas\**\*" LinkBase="schemas" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
