<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:zo3x="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/12/31/eD/PITO3X/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/12/31/eD/PITO3X/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/StrukturyDanych_v3-0E.xsd"/>
	<!--Ilekroć mowa o ustawie oznacza to ustawę z dnia 26 lipca 1991 r. o podatku dochodowym od osób fizycznych (Dz. U. z 2012 r. poz. 361, z późn. zm.).-->
	<!-- -->
	<!--Poz. 31 - 33 wypełnia się, jeżeli obowiązujące przepisy przewidują dokonanie odliczeń od dochodu (przychodu) z tytułów innych niż wymienione w poz. 11 - 30, odpowiednio poz. 45 - 47 wypełnia się, jeżeli obowiązujące przepisy przewidują dokonanie odliczeń od podatku z tytułów innych niż wymienione w poz. 36 - 44.-->
	<xsd:complexType name="TNaglowek_PIT_O">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zo3x:TKodFormularza_O">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT/OD (21)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="21"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_O">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/O"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TDataP">
		<xsd:annotation>
			<xsd:documentation>Typ daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:maxInclusive value="2030-12-31"/>
			<xsd:pattern value="((\d{4})-(\d{2})-(\d{2}))"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TIdentyfikatorOsobyFizycznej1">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych identyfikacyjnych o osobie fizycznej z identyfikatorem NIP albo PESEL</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:choice>
				<xsd:element name="NIP" type="etd:TNrNIP">
					<xsd:annotation>
						<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
				<xsd:element name="PESEL" type="etd:TNrPESEL">
					<xsd:annotation>
						<xsd:documentation>Identyfikator podatkowy numer PESEL</xsd:documentation>
					</xsd:annotation>
				</xsd:element>
			</xsd:choice>
			<xsd:element name="ImiePierwsze" type="etd:TImie">
				<xsd:annotation>
					<xsd:documentation>Pierwsze imię</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Nazwisko" type="etd:TNazwisko">
				<xsd:annotation>
					<xsd:documentation>Nazwisko</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DataUrodzenia" type="zo3x:TDataP">
				<xsd:annotation>
					<xsd:documentation>Data urodzenia</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="Zalacznik_PIT_O">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O ODLICZENIACH OD DOCHODU (PRZYCHODU) I OD PODATKU W ROKU PODATKOWYM</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zo3x:TNaglowek_PIT_O"/>
				<xsd:element name="Podmiot1">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="zo3x:TIdentyfikatorOsobyFizycznej1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Podatnik"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Podmiot2" minOccurs="0">
					<xsd:complexType>
						<xsd:complexContent>
							<xsd:extension base="zo3x:TIdentyfikatorOsobyFizycznej1">
								<xsd:attribute name="rola" type="xsd:string" use="required" fixed="Małżonek"/>
							</xsd:extension>
						</xsd:complexContent>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Odliczenia od dochodu (przychodu), odliczenia od podatku, informacja o przekazanych darowiznach oraz o obdarowanych</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_4" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Nr załącznika</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_11" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane organizacjom na prowadzoną przez nie działalność pożytku publicznego w sferze zadań publicznych, o których mowa w art. 26 ust. 1 pkt 9 lit. a ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_12" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - 1. Darowizny przekazane organizacjom na prowadzoną przez nie działalność pożytku publicznego w sferze zadań publicznych, o których mowa w art. 26 ust. 1 pkt 9 lit. a ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_13" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane na cele kultu religijnego, o których mowa w art. 26 ust. 1 pkt 9 lit. b ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_14" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - 1. Darowizny przekazane na cele kultu religijnego, o których mowa w art. 26 ust. 1 pkt 9 lit. b ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_15" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 1. Darowizny przekazane na cele krwiodawstwa, o których mowa w art. 26 ust. 1 pkt 9 lit. c ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_16" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - 1. Darowizny przekazane na cele krwiodawstwa, o których mowa w art. 26 ust. 1 pkt 9 lit. c ustawy</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_17" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 2. Darowizny wynikające z odrębnych ustaw</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_18" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - 2. Darowizny wynikające z odrębnych ustaw</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TKwota2Nieujemna">
											<xsd:minExclusive value="0"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:element name="P_D" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Informacja o przekazanych darowiznach oraz o obdarowanych</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D1" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa pełna</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D3" type="etd:TKodKraju">
												<xsd:annotation>
													<xsd:documentation>Kod kraju</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D4" type="etd:TMiejscowosc">
												<xsd:annotation>
													<xsd:documentation>Miejscowość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D5" type="etd:TUlica" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Ulica</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D6" type="etd:TNrBudynku" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Nr domu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D7" type="etd:TNrLokalu" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Nr lokalu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D8" type="etd:TKodPocztowy" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Kod pocztowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D9" type="etd:TMiejscowosc" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Poczta</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D10" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Podatnik - Kwota przekazanej darowizny</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D11" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Małżonek - Kwota przekazanej darowizny</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_19" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 3. Wydatki na cele rehabilitacyjne oraz wydatki związane z ułatwieniem wykonywania czynności życiowych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_20" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek - 3. Wydatki na cele rehabilitacyjne oraz wydatki związane z ułatwieniem wykonywania czynności życiowych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_21" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 4. Zwrot nienależnie pobranych świadczeń, które uprzednio zwiększyły dochód podlegający opodatkowaniu (w kwotach uwzględniających podatek), jeżeli nie zostały one potrącone przez płatnika</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_22" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek - 4. Zwrot nienależnie pobranych świadczeń, które uprzednio zwiększyły dochód podlegający opodatkowaniu (w kwotach uwzględniających podatek), jeżeli nie zostały one potrącone przez płatnika</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_23_1" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik korzystał z ulgi internetowej w rozliczeniach: 1 - za rok ubiegły</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_23_2" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik korzystał z ulgi internetowej w rozliczeniach: 1 - za rok (lata poprzedzający(e) rok ubiegły</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_24_1" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek korzystał z ulgi internetowej w rozliczeniach: 1 - za rok ubiegły</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_24_2" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek korzystał z ulgi internetowej w rozliczeniach: 1 - za rok (lata poprzedzający(e) rok ubiegły</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_25" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 5. Wydatki z tytułu użytkowania sieci Internet</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TKwota2Nieujemna">
										<xsd:maxInclusive value="760"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_26" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek - 5. Wydatki z tytułu użytkowania sieci Internet</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TKwota2Nieujemna">
										<xsd:maxInclusive value="760"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_27" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 6. Wydatki na nabycie nowych technologii</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_28" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek - 6. Wydatki na nabycie nowych technologii</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_29" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 7. Wpłaty na indywidualne konto zabezpieczenia emerytalnego (IKZE)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_30" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek - 7. Wpłaty na indywidualne konto zabezpieczenia emerytalnego (IKZE)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_31" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>8. Inne ulgi, niewymienione w wierszach od 1 do 7 - Rodzaj</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_32" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik - 8. Inne ulgi, niewymienione w wierszach od 1 do 7</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_33" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek - 9. Inne ulgi, niewymienione w wierszach od 1 do 7</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:element name="P_34" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Podatnik - Razem odliczenia od dochodu (przychodu)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_35" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek - Razem odliczenia od dochodu (przychodu)</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_36" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 1. Ulga za wyszkolenie uczniów lub z tytułu zatrudnienia pracowników w celu przygotowania zawodowego, przyznana na podstawie decyzji</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_37" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek - 1. Ulga za wyszkolenie uczniów lub z tytułu zatrudnienia pracowników w celu przygotowania zawodowego, przyznana na podstawie decyzji</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_38" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik - 2. Składki na ubezpieczenia społeczne opłacone przez osobę prowadzącą gospodarstwo domowe z tytułu zawarcia umowy aktywizacyjnej z osobą bezrobotną</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_39" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Małżonek - 2. Składki na ubezpieczenia społeczne opłacone przez osobę prowadzącą gospodarstwo domowe z tytułu zawarcia umowy aktywizacyjnej z osobą bezrobotną</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:element name="P_40">
									<xsd:annotation>
										<xsd:documentation>Liczba dzieci</xsd:documentation>
									</xsd:annotation>
									<xsd:simpleType>
										<xsd:restriction base="etd:TNaturalny">
											<xsd:minInclusive value="1"/>
											<xsd:maxInclusive value="99"/>
										</xsd:restriction>
									</xsd:simpleType>
								</xsd:element>
								<xsd:sequence minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_40A" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Suma przysługujących ulg na dzieci - suma kwot z P_E7</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_41" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>3. Ulga na dzieci</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
								</xsd:sequence>
								<xsd:sequence minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Małżonek</xsd:documentation>
									</xsd:annotation>
									<xsd:element name="P_40B" type="etd:TKwota2Nieujemna">
										<xsd:annotation>
											<xsd:documentation>Suma przysługujących ulg na dzieci - suma kwot z P_E8</xsd:documentation>
										</xsd:annotation>
									</xsd:element>
									<xsd:element name="P_42" type="etd:TKwota2Nieujemna">
