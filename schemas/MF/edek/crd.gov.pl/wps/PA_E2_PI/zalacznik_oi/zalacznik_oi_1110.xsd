<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:zb36="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/12/31/eD/PITB36/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2015/12/31/eD/PITB36/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/" schemaLocation="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2011/06/21/eD/DefinicjeTypy/StrukturyDanych_v3-0E.xsd"/>
	<!--Jeżeli podatnik wykonuje różne rodzaje działalności lub wykonuje działalność w wielu miejscach i zgodnie z przepisami w sprawie prowadzenia podatkowej księgi przychodów i rozchodów (ksiąg rachunkowych) wszystkie operacje gospodarcze ujmuje w jednej księdze - w informacji wykazuje przychody, koszty i dochody (straty) w części B.1.; w przypadku prowadzenia większej liczby ksiąg należy wypełnić część B.2. lub kolejne załączniki PIT/B.-->
	<!-- -->
	<!--Podatnik nie wykazuje przychodów, kosztów, dochodów/strat z działalności gospodarczej:
- prowadzonej na terenie specjalnej strefy ekonomicznej na podstawie zezwolenia, o którym mowa w art. 16 ust. 1 ustawy z dnia 20 października 1994 r. o specjalnych strefach ekonomicznych (Dz. U. z 2015 r. poz. 282), jeżeli poniósł z tej działalności stratę w roku podatkowym,
- prowadzonej za granicą, o których mowa w art. 27 ust. 8 ustawy.-->
	<!-- -->
	<!--Jeżeli podatnik składa więcej niż jeden załącznik PIT/B, część D wypełnia na jednym załączniku, z tym że w części D w poz. 52 i 53 sumuje odpowiednie kwoty ze wszystkich załączników.-->
	<xsd:complexType name="TNaglowek_PIT_B">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zb36:TKodFormularza_B">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="PIT/B (14)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="14"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_B">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="PIT/B"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TUdzial">
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="9"/>
			<xsd:fractionDigits value="6"/>
			<xsd:minInclusive value="0"/>
			<xsd:maxInclusive value="100"/>
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="TIdentyfikatorOsobyFizycznej2">
		<xsd:annotation>
			<xsd:documentation>Podstawowy zestaw danych identyfikacyjnych o osobie fizycznej z identyfikatorem NIP</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="NIP" type="etd:TNrNIP">
				<xsd:annotation>
					<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="ImiePierwsze" type="etd:TImie">
				<xsd:annotation>
					<xsd:documentation>Pierwsze imię</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="Nazwisko" type="etd:TNazwisko">
				<xsd:annotation>
					<xsd:documentation>Nazwisko</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="DataUrodzenia">
				<xsd:annotation>
					<xsd:documentation>Data urodzenia</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="etd:TData">
						<xsd:maxInclusive value="2030-12-31"/>
						<xsd:pattern value="((\d{4})-(\d{2})-(\d{2}))"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="Zalacznik_PIT_B">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI DOCHODU (STRATY) Z POZAROLNICZEJ DZIAŁALNOŚCI GOSPODARCZEJ W ROKU PODATKOWYM</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zb36:TNaglowek_PIT_B"/>
				<xsd:element name="Podmiot1" type="zb36:TIdentyfikatorOsobyFizycznej2"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dochody / straty z pozarolniczej działalności gospodarczej, zwanej dalej „działalnością gospodarczą”, przychody, koszty i dochody / straty w spółce niebędącej osobą prawną, w której podatnik jest wspólnikiem</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_3">
								<xsd:annotation>
									<xsd:documentation>Łączna liczba składanych załączników PIT/B</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="etd:TNaturalny">
										<xsd:totalDigits value="2"/>
										<xsd:minInclusive value="1"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.1. Dane dotyczące działalności gospodarczej</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_7" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Rodzaj działalności</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_8" type="etd:TNrREGON" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>REGON</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_9" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Miejsce prowadzenia działalności</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_10" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_11" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_12" type="etd:TKwota2">
									<xsd:annotation>
										<xsd:documentation>Dochód/strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.2. Dane dotyczące działalności gospodarczej</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_13" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Rodzaj działalności</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_14" type="etd:TNrREGON" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>REGON</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_15" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Miejsce prowadzenia działalności</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_16" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_17" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_18" type="etd:TKwota2">
									<xsd:annotation>
										<xsd:documentation>Dochód/strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>C.1. Dane dotyczące dochodów / strat podatnika z udziału w spółce (ze współwłasności małżonków)</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_19" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Nazwa spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_20" type="zb36:TUdzial">
									<xsd:annotation>
										<xsd:documentation>Udział</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_21" type="etd:TNrNIP" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_22" type="etd:TNrREGON" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>REGON</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_23" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Miejsce prowadzenia działalności</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_24" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_25" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód przypadający na podatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_26" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_27" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu przypadające na podatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_28" type="etd:TKwota2">
									<xsd:annotation>
										<xsd:documentation>Dochód/strata spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_29" type="etd:TKwota2">
									<xsd:annotation>
										<xsd:documentation>Dochód/strata przypadający na podatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>C.2. Dane dotyczące dochodów / strat podatnika z udziału w spółce (ze współwłasności małżonków)</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_30" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Nazwa spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_31" type="zb36:TUdzial">
									<xsd:annotation>
										<xsd:documentation>Udział</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_32" type="etd:TNrNIP" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_33" type="etd:TNrREGON" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>REGON</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_34" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Miejsce prowadzenia działalności</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_35" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_36" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód przypadający na podatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_37" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_38" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu przypadające na podatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_39" type="etd:TKwota2">
									<xsd:annotation>
										<xsd:documentation>Dochód/strata spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_40" type="etd:TKwota2">
									<xsd:annotation>
										<xsd:documentation>Dochód/strata przypadający na podatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>C.3. Dane dotyczące dochodów / strat podatnika z udziału w spółce (ze współwłasności małżonków)</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_41" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Nazwa spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_42" type="zb36:TUdzial">
									<xsd:annotation>
										<xsd:documentation>Udział</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_43" type="etd:TNrNIP" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_44" type="etd:TNrREGON" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>REGON</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_45" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Miejsce prowadzenia działalności</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_46" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_47" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychód przypadający na podatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_48" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_49" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodu przypadające na podatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_50" type="etd:TKwota2">
									<xsd:annotation>
										<xsd:documentation>Dochód/strata spółki</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_51" type="etd:TKwota2">
									<xsd:annotation>
										<xsd:documentation>Dochód/strata przypadający na podatnika</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>D. Łączny przychód, koszty, dochód lub strata podatnika z działalności gospodarczej.</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_52" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Przychody</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_53" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_54" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Dochód</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_55" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Strata</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
